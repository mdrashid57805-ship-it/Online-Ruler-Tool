          {t.seo.faqTitle}
        </h2>
      </div>

      <div class="space-y-2.5">
        {t.seo.faqs.map((faq, index) => (
          <details class="group p-3.5 sm:p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-card)] shadow-xs hover:border-[var(--color-hairline-strong)] transition-all duration-150">
