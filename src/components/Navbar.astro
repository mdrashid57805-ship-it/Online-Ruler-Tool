---
export interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
---

<!-- Fixed Top Navbar -->
<header
  id="app-navbar"
  class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-[var(--color-hairline)] select-none text-[13px]"
  style="height: 52px;"
>
  <div class="max-w-[1920px] mx-auto h-full px-2 sm:px-4 flex items-center justify-between gap-1.5 sm:gap-3">
    
    <!-- Left Section: Logo + Edge Placement (Desktop) -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-1.5 sm:gap-2 mr-0.5 sm:mr-1 text-[var(--color-ink)] font-bold tracking-tight hover:opacity-85 transition-opacity shrink-0" title="Online Penggaris">
        <div class="w-7 h-7 rounded-lg bg-red-600 text-white flex items-center justify-center shadow-sm shrink-0">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <line x1="6" y1="6" x2="6" y2="12" />
            <line x1="10" y1="6" x2="10" y2="9" />
            <line x1="14" y1="6" x2="14" y2="12" />
            <line x1="18" y1="6" x2="18" y2="9" />
          </svg>
        </div>
        <span id="nav-logo-text" class="hidden sm:inline font-bold tracking-tight text-[13px] sm:text-[14px]">Online Penggaris</span>
      </a>

      <!-- Edge Placement Segmented Buttons (Desktop & Tablets) -->
      <div class="hidden md:flex items-center bg-[var(--color-canvas-soft)] p-0.5 rounded-lg border border-[var(--color-hairline)] shrink-0" title="Pilih Posisi Penggaris">
        <button
          data-edge-btn="top"
          class="edge-btn px-2 py-1 rounded-[6px] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all flex items-center gap-1"
          title="Penggaris Atas (Top)"
          aria-pressed="true"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="12" height="4" rx="1" />
            <line x1="5" y1="2" x2="5" y2="4.5" />
            <line x1="8" y1="2" x2="8" y2="4" />
            <line x1="11" y1="2" x2="11" y2="4.5" />
          </svg>
          <span id="nav-edge-top-text" class="hidden lg:inline text-[11px]">Atas</span>
        </button>

        <button
          data-edge-btn="bottom"
          class="edge-btn px-2 py-1 rounded-[6px] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all flex items-center gap-1"
          title="Penggaris Bawah (Bottom)"
          aria-pressed="false"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="10" width="12" height="4" rx="1" />
            <line x1="5" y1="11.5" x2="5" y2="14" />
            <line x1="8" y1="12" x2="8" y2="14" />
            <line x1="11" y1="11.5" x2="11" y2="14" />
          </svg>
          <span id="nav-edge-bottom-text" class="hidden lg:inline text-[11px]">Bawah</span>
        </button>

        <button
          data-edge-btn="left"
          class="edge-btn px-2 py-1 rounded-[6px] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all flex items-center gap-1"
          title="Penggaris Kiri (Left)"
          aria-pressed="false"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="4" height="12" rx="1" />
            <line x1="2" y1="5" x2="4.5" y2="5" />
            <line x1="2" y1="8" x2="4.5" y2="8" />
            <line x1="2" y1="11" x2="4.5" y2="11" />
          </svg>
          <span id="nav-edge-left-text" class="hidden lg:inline text-[11px]">Kiri</span>
        </button>

        <button
          data-edge-btn="right"
          class="edge-btn px-2 py-1 rounded-[6px] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all flex items-center gap-1"
          title="Penggaris Kanan (Right)"
          aria-pressed="false"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="10" y="2" width="4" height="12" rx="1" />
            <line x1="11.5" y1="5" x2="14" y2="5" />
            <line x1="12" y1="8" x2="14" y2="8" />
            <line x1="11.5" y1="11" x2="14" y2="11" />
          </svg>
          <span id="nav-edge-right-text" class="hidden lg:inline text-[11px]">Kanan</span>
        </button>

        <button
          data-edge-btn="frame"
          class="edge-btn px-2 py-1 rounded-[6px] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all flex items-center gap-1"
          title="Bingkai 4 Sisi (Full Frame)"
          aria-pressed="false"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="12" height="12" rx="1.5" stroke-dasharray="2 2" />
          </svg>
          <span id="nav-edge-frame-text" class="hidden xl:inline text-[11px]">4 Sisi</span>
        </button>
      </div>
    </div>

    <!-- Center Section: Marker & Measuring Tools -->
    <div class="hidden lg:flex items-center gap-1.5 shrink-0">
      <!-- Interactive Red Marker / Pointer Toggle -->
      <button
        id="btn-tool-marker"
        class="tool-btn px-2.5 py-1.5 rounded-lg border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400 hover:bg-red-500/20 transition-all flex items-center gap-1.5 text-xs font-semibold"
        title="Titik & Garis Ukur (P)"
        aria-label="Titik Ukur"
        aria-pressed="true"
      >
        <span class="text-xs">📍</span>
        <span id="nav-marker-text">Titik Ukur</span>
      </button>

      <!-- Guides (G) -->
      <button
        id="btn-tool-guides"
        class="tool-btn w-8 h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center justify-center"
        title="Garis Panduan (G)"
        aria-label="Garis Panduan"
        aria-pressed="false"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
          <line x1="8" y1="1" x2="8" y2="15" stroke-dasharray="2 2" />
          <line x1="1" y1="8" x2="15" y2="8" stroke-dasharray="2 2" />
        </svg>
      </button>

      <!-- Dual Caliper / Jangka Sorong (K) -->
      <button
        id="btn-tool-caliper"
        class="tool-btn w-8 h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center justify-center"
        title="Jangka Sorong / Caliper 2 Titik (K)"
        aria-label="Caliper"
        aria-pressed="false"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 18h16M7 6v12M17 6v12" />
        </svg>
      </button>

      <!-- Matrix Grid (M) -->
      <button
        id="btn-tool-grid"
        class="tool-btn w-8 h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center justify-center"
        title="Matriks Grid (M)"
        aria-label="Grid"
        aria-pressed="false"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
          <rect x="2" y="2" width="12" height="12" rx="1" />
          <line x1="6" y1="2" x2="6" y2="14" />
          <line x1="10" y1="2" x2="10" y2="14" />
          <line x1="2" y1="6" x2="14" y2="6" />
          <line x1="2" y1="10" x2="14" y2="10" />
        </svg>
      </button>
    </div>

    <!-- Right Section: Units · Calibrate (Red Button) · Theme · Lang -->
    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <!-- Unit Segmented Switcher (Visible across phone & desktop) -->
      <div id="unit-selector" class="flex items-center bg-[var(--color-canvas-soft)] p-0.5 rounded-lg border border-[var(--color-hairline)] shrink-0">
        <button data-unit="cm" class="unit-btn active px-2 sm:px-2.5 py-1 rounded-[6px] text-xs font-bold font-mono transition-all">cm</button>
        <button data-unit="mm" class="unit-btn px-2 sm:px-2.5 py-1 rounded-[6px] text-xs font-semibold font-mono text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all">mm</button>
        <button data-unit="in" class="unit-btn px-2 sm:px-2.5 py-1 rounded-[6px] text-xs font-semibold font-mono text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all">in</button>
      </div>

      <!-- Calibrate Button (Red Button CTA) -->
      <button
        id="btn-open-calibrate"
        class="flex items-center gap-1 sm:gap-1.5 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold transition-all shadow-sm group shrink-0"
        title="Kalibrasi Skala Layar"
      >
        <span id="cal-nav-dot" class="w-2 h-2 rounded-full bg-white shrink-0 group-hover:scale-125 transition-transform"></span>
        <span id="nav-cal-text">Kalibrasi</span>
        <span id="cal-nav-ppi" class="hidden xl:inline text-[11px] font-mono text-red-100 font-normal">(127 PPI)</span>
      </button>

      <!-- Theme Switcher (D) -->
      <button
        id="btn-theme-toggle"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center justify-center shrink-0"
        title="Mode Gelap / Terang (D)"
        aria-label="Tema"
      >
        <svg id="theme-icon-sun" class="hidden dark:block" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg id="theme-icon-moon" class="block dark:hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Language Toggle (ID / EN translation toggle) -->
      <button
        id="btn-lang-toggle"
        class="px-2 sm:px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] text-xs font-bold font-mono hover:bg-[var(--color-canvas-soft)] transition-all flex items-center gap-1 shrink-0"
        title="Ganti Bahasa / Switch to English Translation"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="2" y1="12" x2="22" y2="12" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span id="lang-btn-label">EN</span>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="btn-mobile-tools-toggle"
        class="lg:hidden w-7 h-7 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center justify-center shrink-0"
        title="Menu Alat"
        aria-label="Menu Alat"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="1"></circle>
          <circle cx="12" cy="5" r="1"></circle>
          <circle cx="12" cy="19" r="1"></circle>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Edge Bar (Visible on Mobile Phones & Small Screens, Minimalist & Uncluttered) -->
<nav
  id="mobile-edge-bar"
  class="md:hidden fixed top-[52px] left-0 right-0 z-40 bg-white dark:bg-slate-900 border-b border-[var(--color-hairline)] px-2 py-1 select-none shadow-xs h-[44px] flex items-center"
  aria-label="Posisi Penggaris"
>
  <div class="flex items-center justify-between gap-1.5 w-full max-w-lg mx-auto">
    <button
      type="button"
      data-edge-btn-mobile="top"
      class="mobile-edge-btn active flex-1 h-8 rounded-lg border text-[11px] font-bold text-center transition-all cursor-pointer flex items-center justify-center select-none"
      title="Atas (Top)"
      aria-pressed="true"
    >
      Atas
    </button>
    <button
      type="button"
      data-edge-btn-mobile="bottom"
      class="mobile-edge-btn flex-1 h-8 rounded-lg border text-[11px] font-semibold text-center transition-all cursor-pointer flex items-center justify-center select-none"
      title="Bawah (Bottom)"
      aria-pressed="false"
    >
      Bawah
    </button>
    <button
      type="button"
      data-edge-btn-mobile="left"
      class="mobile-edge-btn flex-1 h-8 rounded-lg border text-[11px] font-semibold text-center transition-all cursor-pointer flex items-center justify-center select-none"
      title="Kiri (Left)"
      aria-pressed="false"
    >
      Kiri
    </button>
    <button
      type="button"
      data-edge-btn-mobile="right"
      class="mobile-edge-btn flex-1 h-8 rounded-lg border text-[11px] font-semibold text-center transition-all cursor-pointer flex items-center justify-center select-none"
      title="Kanan (Right)"
      aria-pressed="false"
    >
      Kanan
    </button>
    <button
      type="button"
      data-edge-btn-mobile="frame"
      class="mobile-edge-btn flex-1 h-8 rounded-lg border text-[11px] font-semibold text-center transition-all cursor-pointer flex items-center justify-center select-none"
      title="4 Sisi (Frame)"
      aria-pressed="false"
    >
      4 Sisi
    </button>
  </div>
</nav>

<!-- Mobile Bottom Drawer / Tools Sheet -->
<div
  id="mobile-tools-sheet"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm select-none transition-opacity duration-200 lg:hidden"
  style="display: none;"
>
  <div
    class="absolute bottom-0 left-0 right-0 max-h-[80vh] overflow-y-auto bg-[var(--color-canvas)] rounded-t-2xl border-t border-[var(--color-hairline)] p-4 space-y-4 text-[var(--color-ink)] shadow-2xl"
  >
    <div class="flex items-center justify-between border-b border-[var(--color-hairline)] pb-2">
      <span class="font-bold text-sm">Alat & Pengaturan</span>
      <button id="btn-close-mobile-sheet" class="p-1 rounded-lg hover:bg-[var(--color-canvas-soft)]">
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </div>

    <!-- Mobile Measurement Tools -->
    <div class="space-y-1.5">
      <span class="text-[11px] text-[var(--color-mute)] font-medium">Fitur Pengukuran:</span>
      <div class="grid grid-cols-3 gap-2">
        <button id="btn-mobile-tool-marker" class="p-2 rounded-xl border border-red-200 bg-red-50 text-red-700 text-xs font-semibold flex flex-col items-center gap-1">
          <span>📍</span>
          <span>Titik Ukur</span>
        </button>
        <button id="btn-mobile-tool-caliper" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-xs font-medium flex flex-col items-center gap-1">
          <span>📏</span>
          <span>Jangka Sorong</span>
        </button>
        <button id="btn-mobile-tool-guides" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-xs font-medium flex flex-col items-center gap-1">
          <span>📐</span>
          <span>Garis Panduan</span>
        </button>
      </div>
    </div>

    <!-- Mobile Calibration Action -->
    <div>
      <button
        id="btn-mobile-open-calibrate"
        class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-md"
      >
        <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
        <span>Kalibrasi Skala Layar (1:1)</span>
      </button>
    </div>

    <!-- Quick Navigation Links -->
    <div class="pt-2 border-t border-[var(--color-hairline)] space-y-1.5 text-xs">
      <a href="/cara-kalibrasi" class="block py-1.5 px-3 rounded-lg hover:bg-[var(--color-canvas-soft)] text-red-600 font-medium">
        📐 Panduan Kalibrasi Layar
      </a>
      <a href="/tentang" class="block py-1.5 px-3 rounded-lg hover:bg-[var(--color-canvas-soft)] text-[var(--color-body)]">
        ℹ️ Tentang Online Penggaris
      </a>
      <a href="/contact" class="block py-1.5 px-3 rounded-lg hover:bg-[var(--color-canvas-soft)] text-[var(--color-body)]">
        ✉️ Hubungi Kami
      </a>
    </div>
  </div>
</div>

<style>
  .unit-btn.active {
    background-color: #dc2626 !important;
    color: #ffffff !important;
  }
  .mobile-edge-btn {
    background-color: var(--color-canvas);
    color: var(--color-body);
    border-color: var(--color-hairline);
    cursor: pointer;
  }
  .mobile-edge-btn:hover {
    color: var(--color-ink);
  }
  .mobile-edge-btn.active,
  .mobile-edge-btn[aria-pressed="true"] {
    background-color: #dc2626 !important;
    color: #ffffff !important;
    border-color: #dc2626 !important;
    font-weight: 700 !important;
  }
  .tool-btn[aria-pressed="true"] {
    background-color: #dc2626 !important;
    color: #ffffff !important;
    border-color: #dc2626 !important;
  }
</style>
