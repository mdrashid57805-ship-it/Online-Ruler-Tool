---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import RulerCanvas from './RulerCanvas.astro';
import CalibrationModal from './CalibrationModal.astro';
import CaliperHud from './CaliperHud.astro';
import ReferenceOverlays from './ReferenceOverlays.astro';
import HowToModal from './HowToModal.astro';
import WelcomeBanner from './WelcomeBanner.astro';
import ContentSection from './ContentSection.astro';
import Footer from './Footer.astro';
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  keywords={t.keywords}
  lang={lang}
>
  <!-- Fixed Top Navbar & Mobile Bottom Dock -->
  <Navbar lang={lang} />

  <!-- Main Document Flow (Offset pt-[96px] on mobile for 44px edge bar, pt-[52px] on desktop) -->
  <main id="app-main" class="relative w-full overflow-x-hidden pt-[96px] md:pt-[52px]">
    
    <!-- Ruler Measuring Workspace: Full-screen height hero area with precision drafting grid -->
    <div id="ruler-workspace" class="relative w-full h-[calc(100vh-96px)] md:h-[calc(100vh-52px)] min-h-[400px] overflow-hidden bg-[var(--color-canvas-soft)] workspace-grid">
      <!-- Ruler Canvas & Guides Overlay -->
      <RulerCanvas lang={lang} />

      <!-- Welcome State / Quick Edge Launcher -->
      <WelcomeBanner lang={lang} />
    </div>

    <!-- Two-Point Caliper Readout HUD (Fixed bottom pill) -->
    <CaliperHud lang={lang} />

    <!-- Object Silhouettes Scale Comparison Modal -->
    <ReferenceOverlays lang={lang} />

    <!-- Calibration Modal (3 Methods) -->
    <CalibrationModal lang={lang} />

    <!-- Help & Shortcuts Modal -->
    <HowToModal lang={lang} />

    <!-- Rich SEO Article, PPI Matrix & FAQ Section (Flows smoothly below ruler workspace) -->
    <ContentSection lang={lang} />
  </main>

  <!-- Site Footer -->
  <Footer lang={lang} />
</BaseLayout>

<script>
  import {
    getSavedCalibration,
    saveCalibration,
    calculatePpiFromDiagonal,
    formatMeasurement,
    type MeasurementUnit,
    type CalibrationState,
    STORAGE_KEY_UNIT,
    STORAGE_KEY_THEME,
  } from '../lib/calibration';
  import { detectCurrentDevice, DEVICE_DATABASE } from '../lib/devices';
  import { renderRulerEdge, renderGridOverlay } from '../lib/rulerRenderer';
  import { TRANSLATIONS, updateFooterTranslations, type Language } from '../lib/i18n';
  import { getLangFromUrl } from '../i18n/utils';

  // --- APPLICATION STATE ---
  let activeUnit: MeasurementUnit = 'cm';
  let activeEdges: { top: boolean; bottom: boolean; left: boolean; right: boolean } = {
    top: true,
    bottom: false,
    left: false,
    right: false,
  };
  let calState: CalibrationState = getSavedCalibration();
  let activeDevCat = 'all';
  let currentLang: Language = 'id';
  let showGuides = false;
  let showCrosshair = false;
  let showGrid = false;
  let showCaliper = false;
  let showMarker = true;
  let markerPosX = 180;
  let markerPosY = 180;
  let isDraggingMarkerV = false;
  let isDraggingMarkerH = false;
  let caliperPoints = { p1: { x: 80, y: 140 }, p2: { x: 300, y: 140 } };
  let isDraggingCaliper: 'p1' | 'p2' | null = null;
  let guideLines: { id: string; type: 'h' | 'v'; pos: number }[] = [];

  // --- INITIALIZATION ---
  function initApp() {
    if (typeof window !== 'undefined') {
      markerPosX = Math.min(Math.round(window.innerWidth * 0.45), 200);
      if (markerPosX < 120) markerPosX = 120;
      markerPosY = Math.min(Math.round(window.innerHeight * 0.35), 200);
      if (markerPosY < 120) markerPosY = 120;
    }
    loadSavedSettings();
    bindEvents();
    applyLanguage(currentLang);
    renderAllRulers();
    updateCalibrationUI();
    renderDeviceCatalog();
    checkAutoDetection();
  }

  function loadSavedSettings() {
    try {
      const savedUnit = localStorage.getItem(STORAGE_KEY_UNIT) as MeasurementUnit;
      if (savedUnit && ['cm', 'mm', 'in', 'px', 'pt'].includes(savedUnit)) {
        activeUnit = savedUnit;
      }
      const docLang = document.documentElement.lang as Language;
      const urlLang = getLangFromUrl(window.location.pathname);
      if (docLang && docLang in TRANSLATIONS) {
        currentLang = docLang;
      } else if (urlLang && urlLang in TRANSLATIONS) {
        currentLang = urlLang;
      } else {
        currentLang = 'en';
      }
    } catch (e) {
      currentLang = 'id';
    }
  }

  const EDGE_LABELS: Record<string, { top: string; bottom: string; left: string; right: string; frame: string }> = {
    en: { top: 'Top', bottom: 'Bottom', left: 'Left', right: 'Right', frame: '4-Way' },
    es: { top: 'Arriba', bottom: 'Abajo', left: 'Izq', right: 'Der', frame: '4 Lados' },
    ja: { top: '上部', bottom: '下部', left: '左側', right: '右側', frame: '4辺' },
    fr: { top: 'Haut', bottom: 'Bas', left: 'Gauche', right: 'Droite', frame: '4 Bords' },
    de: { top: 'Oben', bottom: 'Unten', left: 'Links', right: 'Rechts', frame: '4-Seiten' },
    pt: { top: 'Topo', bottom: 'Fundo', left: 'Esq', right: 'Dir', frame: '4 Lados' },
    ko: { top: '상단', bottom: '하단', left: '왼쪽', right: '오른쪽', frame: '4면' },
    it: { top: 'Sopra', bottom: 'Sotto', left: 'Sinistra', right: 'Destra', frame: '4 Lati' },
    id: { top: 'Atas', bottom: 'Bawah', left: 'Kiri', right: 'Kanan', frame: '4 Sisi' },
  };

  // --- DYNAMIC I18N BILINGUAL SWITCHER ---
  function applyLanguage(lang: Language) {
    currentLang = lang;
    document.documentElement.lang = lang;
    const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
    const edgeText = EDGE_LABELS[lang] || EDGE_LABELS.en;

    try {
      // 1. Navbar
      const navLogo = document.getElementById('nav-logo-text');
      if (navLogo) navLogo.textContent = t.siteName;

      const topText = document.getElementById('nav-edge-top-text');
      if (topText) topText.textContent = edgeText.top;
      const btmText = document.getElementById('nav-edge-bottom-text');
      if (btmText) btmText.textContent = edgeText.bottom;
      const leftText = document.getElementById('nav-edge-left-text');
      if (leftText) leftText.textContent = edgeText.left;
      const rightText = document.getElementById('nav-edge-right-text');
      if (rightText) rightText.textContent = edgeText.right;
      const frameText = document.getElementById('nav-edge-frame-text');
      if (frameText) frameText.textContent = edgeText.frame;
      const navCal = document.getElementById('nav-cal-text');
      if (navCal) navCal.textContent = t.tools.calibrate;

      // Mobile Edge Bar dynamic labels
      document.querySelectorAll('[data-edge-btn-mobile]').forEach(btn => {
        const edge = btn.getAttribute('data-edge-btn-mobile');
        if (edge === 'top') btn.textContent = edgeText.top;
        if (edge === 'bottom') btn.textContent = edgeText.bottom;
        if (edge === 'left') btn.textContent = edgeText.left;
        if (edge === 'right') btn.textContent = edgeText.right;
        if (edge === 'frame') btn.textContent = edgeText.frame;
      });

      // Mobile Drawer Labels
      const mSheetTitle = document.getElementById('mobile-sheet-title');
      if (mSheetTitle) mSheetTitle.textContent = lang === 'id' ? 'Alat & Pengaturan' : 'Tools & Settings';
      const mToolsLabel = document.getElementById('mobile-sheet-tools-label');
      if (mToolsLabel) mToolsLabel.textContent = lang === 'id' ? 'Fitur Pengukuran:' : 'Measurement Tools:';

      const mMarkerTitle = document.getElementById('mobile-marker-row-title');
      if (mMarkerTitle) mMarkerTitle.textContent = t.tools.marker;
      const mMarkerStatus = document.getElementById('mobile-marker-row-status');
      if (mMarkerStatus) {
        mMarkerStatus.textContent = showMarker ? '✓ Active' : 'Off';
      }

      const mCaliperLabel = document.getElementById('mobile-caliper-label');
      if (mCaliperLabel) mCaliperLabel.textContent = t.tools.caliper;
      const mCalLabel = document.getElementById('mobile-calibrate-label');
      if (mCalLabel) mCalLabel.textContent = t.tools.calibrate;
      const mLinkCal = document.getElementById('mobile-link-cal');
      if (mLinkCal) {
        const s = mLinkCal.querySelector('span');
        if (s) s.textContent = t.footer.calGuide;
      }
      const mLinkAbout = document.getElementById('mobile-link-about');
      if (mLinkAbout) {
        const s = mLinkAbout.querySelector('span');
        if (s) s.textContent = t.footer.about;
      }
      const mLinkContact = document.getElementById('mobile-link-contact');
      if (mLinkContact) {
        const s = mLinkContact.querySelector('span');
        if (s) s.textContent = t.footer.contact;
      }

      const navMarkerText = document.getElementById('nav-marker-text');
      if (navMarkerText) navMarkerText.textContent = showMarker ? t.tools.marker : `${t.tools.marker} (Off)`;

      // 2. Welcome Banner
      const wTitle = document.getElementById('welcome-title');
      if (wTitle) wTitle.textContent = t.welcome.title;
      const wSub = document.getElementById('welcome-subtitle');
      if (wSub) wSub.textContent = t.welcome.subtitle;
      const wTop = document.getElementById('welcome-quick-top-label');
      if (wTop) wTop.textContent = edgeText.top;
      const wBtm = document.getElementById('welcome-quick-bottom-label');
      if (wBtm) wBtm.textContent = edgeText.bottom;
      const wLeft = document.getElementById('welcome-quick-left-label');
      if (wLeft) wLeft.textContent = edgeText.left;
      const wRight = document.getElementById('welcome-quick-right-label');
      if (wRight) wRight.textContent = edgeText.right;
      const wChange = document.getElementById('welcome-change-device');
      if (wChange) wChange.textContent = t.welcome.calWrongDevice;
      const wHide = document.getElementById('btn-hide-welcome');
      if (wHide) wHide.textContent = t.welcome.hideInfo;

      // 3. Calibration Modal
      const mBadge = document.getElementById('modal-badge-text');
      if (mBadge) mBadge.textContent = t.calModal.badge;
      const mTitle = document.getElementById('modal-title-text');
      if (mTitle) mTitle.textContent = t.calModal.title;
      const tabAuto = document.getElementById('tab-btn-auto-text');
      if (tabAuto) tabAuto.textContent = t.calModal.tabAuto;
      const tabDiag = document.getElementById('tab-btn-diagonal-text');
      if (tabDiag) tabDiag.textContent = t.calModal.tabDiagonal;
      const tabCard = document.getElementById('tab-btn-card-text');
      if (tabCard) tabCard.textContent = t.calModal.tabCard;
      const tabDev = document.getElementById('tab-btn-device-text');
      if (tabDev) tabDev.textContent = t.calModal.tabDevice;

      const autoPpiLabel = document.getElementById('auto-ppi-label');
      if (autoPpiLabel) autoPpiLabel.textContent = t.calModal.autoDetecting;
      const autoDesc = document.getElementById('auto-desc-text');
      if (autoDesc) autoDesc.textContent = t.calModal.autoDesc;
      const btnApplyAuto = document.getElementById('btn-apply-auto-text');
      if (btnApplyAuto) btnApplyAuto.textContent = t.calModal.applyAuto;

      const diagLabel = document.getElementById('diag-label-text');
      if (diagLabel) diagLabel.textContent = t.calModal.diagonalLabel;
      const diagDesc = document.getElementById('diag-desc-text');
      if (diagDesc) diagDesc.textContent = t.calModal.diagonalDesc;
      const btnApplyDiag = document.getElementById('btn-apply-diagonal');
      if (btnApplyDiag) btnApplyDiag.textContent = t.calModal.diagonalApply;
      const diagPresets = document.getElementById('diag-presets-label');
      if (diagPresets) diagPresets.textContent = t.calModal.diagonalPresets;
      const diagFormula = document.getElementById('diag-formula-label');
      if (diagFormula) diagFormula.textContent = 'PPI = √(W² + H²) / D';

      const cardInstr = document.getElementById('card-instruction-text');
      if (cardInstr) cardInstr.innerHTML = t.calModal.cardInstruction;
      const cardRefLabel = document.getElementById('card-ref-label');
      if (cardRefLabel) cardRefLabel.textContent = t.calModal.cardRefLabel;
      const cardAdj = document.getElementById('card-adjust-label');
      if (cardAdj) cardAdj.textContent = t.calModal.cardAdjustPpi;
      const cardTip = document.getElementById('card-tip-text');
      if (cardTip) cardTip.innerHTML = t.calModal.cardInstructionSub;
      const btnApplyCard = document.getElementById('btn-apply-card-cal');
      if (btnApplyCard) btnApplyCard.textContent = t.calModal.cardApply;
      const devSearch = document.getElementById('device-search-input') as HTMLInputElement;
      if (devSearch) devSearch.placeholder = t.calModal.deviceSearchPlaceholder;
      const btnReset = document.getElementById('btn-reset-cal');
      if (btnReset) btnReset.textContent = t.calModal.resetDefault;

      // 4. Caliper HUD
      const caliperTitle = document.getElementById('caliper-hud-title');
      if (caliperTitle) caliperTitle.textContent = t.caliper.title;
      const labelSpan = document.getElementById('hud-label-span');
      if (labelSpan) labelSpan.textContent = t.caliper.distance;
      const labelDx = document.getElementById('hud-label-dx');
      if (labelDx) labelDx.textContent = t.caliper.deltaX;
      const labelDy = document.getElementById('hud-label-dy');
      if (labelDy) labelDy.textContent = t.caliper.deltaY;
      const copyCaliperText = document.getElementById('copy-caliper-text');
      if (copyCaliperText) copyCaliperText.textContent = t.caliper.copyValue;

      // 5. Silhouettes Modal
      const silTitle = document.getElementById('silhouettes-modal-title');
      if (silTitle) silTitle.textContent = t.tools.silhouettes;
      const silCard = document.getElementById('sil-obj-card');
      if (silCard) silCard.textContent = lang === 'id' ? 'Kartu ATM / KTP' : 'Credit Card / ID';

      // 6. How-To Modal
      const howtoBadge = document.getElementById('howto-badge-text');
      if (howtoBadge) howtoBadge.textContent = t.howTo.badge;
      const howtoTitle = document.getElementById('howto-title-text');
      if (howtoTitle) howtoTitle.textContent = t.howTo.title;
      const hStep1T = document.getElementById('howto-step1-title');
      if (hStep1T) hStep1T.textContent = t.howTo.step1Title;
      const hStep1D = document.getElementById('howto-step1-desc');
      if (hStep1D) hStep1D.textContent = t.howTo.step1Desc;
      const hStep2T = document.getElementById('howto-step2-title');
      if (hStep2T) hStep2T.textContent = t.howTo.step2Title;
      const hStep2D = document.getElementById('howto-step2-desc');
      if (hStep2D) hStep2D.textContent = t.howTo.step2Desc;
      const hStep3T = document.getElementById('howto-step3-title');
      if (hStep3T) hStep3T.textContent = t.howTo.step3Title;
      const hStep3D = document.getElementById('howto-step3-desc');
      if (hStep3D) hStep3D.textContent = t.howTo.step3Desc;
      const hShortcuts = document.getElementById('howto-shortcuts-title');
      if (hShortcuts) hShortcuts.textContent = t.howTo.shortcutsTitle;

      const scGuides = document.getElementById('sc-label-guides');
      if (scGuides) scGuides.textContent = t.howTo.shortcutGuides;
      const scCross = document.getElementById('sc-label-crosshair');
      if (scCross) scCross.textContent = t.howTo.shortcutCrosshair;
      const scGrid = document.getElementById('sc-label-grid');
      if (scGrid) scGrid.textContent = t.howTo.shortcutGrid;
      const scCaliper = document.getElementById('sc-label-caliper');
      if (scCaliper) scCaliper.textContent = t.howTo.shortcutCaliper;
      const scFull = document.getElementById('sc-label-fullscreen');
      if (scFull) scFull.textContent = t.howTo.shortcutFullscreen;
      const scTheme = document.getElementById('sc-label-theme');
      if (scTheme) scTheme.textContent = t.howTo.shortcutTheme;
      const scClear = document.getElementById('sc-label-clear');
      if (scClear) scClear.textContent = t.howTo.shortcutClear;
      const scUnits = document.getElementById('sc-label-units');
      if (scUnits) scUnits.textContent = t.howTo.shortcutUnits;
      const btnCloseHowto = document.getElementById('btn-close-howto-bottom');
      if (btnCloseHowto) btnCloseHowto.textContent = t.howTo.gotIt;

      // 7. Footer (Brand, Headings, Links, Copyright)
      updateFooterTranslations(lang);

    } catch (err) {
      console.error('Error applying translations:', err);
    }

    updateCalibrationUI();
    window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
  }

  // --- RULER RENDERING ENGINE ---
  function renderAllRulers() {
    const isDark = document.documentElement.classList.contains('dark');

    const topCanvas = document.getElementById('ruler-canvas-top') as HTMLCanvasElement;
    const bottomCanvas = document.getElementById('ruler-canvas-bottom') as HTMLCanvasElement;
    const leftCanvas = document.getElementById('ruler-canvas-left') as HTMLCanvasElement;
    const rightCanvas = document.getElementById('ruler-canvas-right') as HTMLCanvasElement;
    const gridCanvas = document.getElementById('grid-canvas') as HTMLCanvasElement;

    if (topCanvas && activeEdges.top) {
      topCanvas.style.display = 'block';
      renderRulerEdge({ canvas: topCanvas, edge: 'top', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (topCanvas) {
      topCanvas.style.display = 'none';
    }

    if (bottomCanvas && activeEdges.bottom) {
      bottomCanvas.style.display = 'block';
      renderRulerEdge({ canvas: bottomCanvas, edge: 'bottom', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (bottomCanvas) {
      bottomCanvas.style.display = 'none';
    }

    if (leftCanvas && activeEdges.left) {
      leftCanvas.style.display = 'block';
      renderRulerEdge({ canvas: leftCanvas, edge: 'left', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (leftCanvas) {
      leftCanvas.style.display = 'none';
    }

    if (rightCanvas && activeEdges.right) {
      rightCanvas.style.display = 'block';
      renderRulerEdge({ canvas: rightCanvas, edge: 'right', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (rightCanvas) {
      rightCanvas.style.display = 'none';
    }

    if (gridCanvas && showGrid) {
      gridCanvas.style.display = 'block';
      renderGridOverlay(gridCanvas, activeUnit, calState.ppi, isDark);
    } else if (gridCanvas) {
      gridCanvas.style.display = 'none';
    }

    updateEdgeButtonStyles();
    updateUnitButtonStyles();
    updateMarker();
    updateCaliper();
    updateCardSimulator();
  }

  // --- CALIBRATION UI UPDATES ---
  function updateCalibrationUI() {
    const navDot = document.getElementById('cal-nav-dot');
    const navPpi = document.getElementById('cal-nav-ppi');
    const welcomeDot = document.getElementById('welcome-status-dot');
    const welcomeText = document.getElementById('welcome-status-text');
    const modalActiveBadge = document.getElementById('modal-active-ppi-badge');
    const cardPpiDisplay = document.getElementById('card-ppi-display');
    const cardSlider = document.getElementById('card-ppi-slider') as HTMLInputElement;

    const ppiRounded = Math.round(calState.ppi * 10) / 10;

    if (navDot) {
      navDot.className = calState.isCalibrated
        ? 'w-2 h-2 rounded-full bg-emerald-500 shrink-0 group-hover:scale-125 transition-transform'
        : 'w-2 h-2 rounded-full bg-amber-500 shrink-0 group-hover:scale-125 transition-transform';
    }
    if (navPpi) {
      navPpi.textContent = `(${ppiRounded} PPI)`;
    }
    if (welcomeDot) {
      welcomeDot.className = calState.isCalibrated ? 'w-2 h-2 rounded-full bg-emerald-500' : 'w-2 h-2 rounded-full bg-amber-500';
    }
    const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
    if (welcomeText) {
      welcomeText.textContent = `${calState.isCalibrated ? t.welcome.calStatusCalibrated : t.welcome.calStatusNot}: ${calState.deviceName} (${ppiRounded} PPI)`;
    }
    if (modalActiveBadge) {
      modalActiveBadge.textContent = `${t.common.active}: ${ppiRounded} PPI (${calState.deviceName})`;
    }
    if (cardPpiDisplay) {
      cardPpiDisplay.textContent = `${ppiRounded} PPI`;
    }
    if (cardSlider) {
      cardSlider.value = `${ppiRounded}`;
    }
  }

  function updateCardSimulator() {
    const cardBox = document.getElementById('modal-card-box');
    const dimsLabel = document.getElementById('screen-card-dims');
    if (!cardBox) return;

    // Card width: 85.60 mm -> CSS pixels = (85.60 / 25.4) * calState.ppi
    const cardWidthPx = Math.round((85.60 / 25.4) * calState.ppi);
    const cardHeightPx = Math.round((53.98 / 25.4) * calState.ppi);

    cardBox.style.width = `${cardWidthPx}px`;
    cardBox.style.height = `${cardHeightPx}px`;

    if (dimsLabel) {
      dimsLabel.textContent = `85.60 × 53.98 mm (${cardWidthPx} × ${cardHeightPx} px)`;
    }
  }

  function checkAutoDetection() {
    const detected = detectCurrentDevice();
    const badge = document.getElementById('auto-confidence-badge');
    const title = document.getElementById('auto-device-title');
    const specs = document.getElementById('auto-device-specs');
    const ppiVal = document.getElementById('auto-ppi-val');

    if (detected.match) {
      if (title) title.textContent = detected.match.name;
      if (specs) {
        specs.textContent = `Resolusi: ${detected.match.width}×${detected.match.height} px | Diagonal: ${detected.match.diagonal}″ | DPR: ${detected.match.dpr}x`;
      }
      if (ppiVal) ppiVal.textContent = `${detected.estimatedPpi} PPI`;

      if (badge) {
        const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
        if (detected.confidence === 'exact') {
          badge.textContent = t.calModal.autoConfidenceExact;
          badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 inline-block mb-1';
        } else {
          badge.textContent = t.calModal.autoConfidenceHigh;
          badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-indigo-500/10 text-indigo-500 inline-block mb-1';
        }
      }
    } else {
      const sw = typeof screen !== 'undefined' ? screen.width : 1920;
      const sh = typeof screen !== 'undefined' ? screen.height : 1080;
      const dpr = typeof window !== 'undefined' ? (window.devicePixelRatio || 1) : 1;
      const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
      if (title) title.textContent = `${t.calModal.title} (${sw * dpr} × ${sh * dpr} px)`;
      if (specs) specs.textContent = `DPR: ${dpr}x | Viewport: ${sw}×${sh} px`;
      if (ppiVal) ppiVal.textContent = `${detected.estimatedPpi} PPI`;
      if (badge) {
        badge.textContent = t.calModal.autoConfidenceFallback;
        badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-amber-500/10 text-amber-500 inline-block mb-1';
      }
    }
  }

  function updateDevCategoryPills(activeCategory: string) {
    document.querySelectorAll('.dev-cat-btn, [data-dev-filter], .cat-pill').forEach(btn => {
      const cat = btn.getAttribute('data-dev-filter') || btn.getAttribute('data-cat') || 'all';
      if (cat === activeCategory) {
        btn.className = 'dev-cat-btn active px-2.5 py-1 rounded-full bg-[var(--color-primary)] text-white font-medium shrink-0 cursor-pointer border-transparent shadow-xs';
      } else {
        btn.className = 'dev-cat-btn px-2.5 py-1 rounded-full bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-[var(--color-body)] font-medium shrink-0 cursor-pointer hover:border-[var(--color-primary)] hover:text-[var(--color-ink)] transition-colors';
      }
    });
  }

  function renderDeviceCatalog(filterCat = activeDevCat, searchQuery = '') {
    const listContainer = document.getElementById('device-results-list') || document.getElementById('device-catalog-list');
    if (!listContainer) return;

    listContainer.innerHTML = '';
    const query = searchQuery.toLowerCase().trim();
    const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;

    const filtered = DEVICE_DATABASE.filter(dev => {
      const matchesCat = filterCat === 'all' || dev.category === filterCat;
      const matchesQuery = !query ||
        dev.name.toLowerCase().includes(query) ||
        dev.id.toLowerCase().includes(query) ||
        dev.category.toLowerCase().includes(query) ||
        `${dev.diagonal}`.includes(query) ||
        `${dev.width}`.includes(query) ||
        `${dev.height}`.includes(query);
      return matchesCat && matchesQuery;
    });

    if (filtered.length === 0) {
      listContainer.innerHTML = `
        <div class="py-8 text-center text-[var(--color-mute)] space-y-2">
          <svg class="w-7 h-7 mx-auto opacity-40 text-[var(--color-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <p class="text-xs font-medium">${t.calModal.deviceSearchPlaceholder || 'No matching devices found'}</p>
          <button id="btn-reset-device-filter" class="text-xs text-[var(--color-primary)] hover:underline font-semibold cursor-pointer">
            ${currentLang === 'id' ? 'Tampilkan Semua Perangkat' : 'Show All Devices'}
          </button>
        </div>
      `;
      document.getElementById('btn-reset-device-filter')?.addEventListener('click', () => {
        const searchInput = document.getElementById('device-search-input') as HTMLInputElement;
        if (searchInput) searchInput.value = '';
        activeDevCat = 'all';
        updateDevCategoryPills('all');
        renderDeviceCatalog('all', '');
      });
      return;
    }

    filtered.forEach(dev => {
      const cssPpi = Math.round((dev.ppi / dev.dpr) * 10) / 10;
      const isCurrent = calState.isCalibrated && (calState.deviceName === dev.name || Math.abs(calState.ppi - cssPpi) < 0.1);

      const card = document.createElement('div');
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.className = `p-2.5 sm:p-3 rounded-xl border transition-all flex items-center justify-between cursor-pointer select-none group min-h-[48px] ${
        isCurrent
          ? 'border-[var(--color-primary)] bg-[var(--color-primary-subdued)] shadow-xs ring-1 ring-[var(--color-primary)]'
          : 'border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas)] active:scale-[0.99]'
      }`;

      const iconSvg = (dev.category === 'iphone' || dev.category === 'android')
        ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>'
        : dev.category === 'ipad'
        ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>'
        : dev.category === 'monitor'
        ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>'
        : '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M2 20h20"/></svg>';

      card.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0 pr-2">
          <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center ${
            isCurrent
              ? 'bg-[var(--color-primary)] text-white'
              : 'bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-mute)] group-hover:text-[var(--color-primary)] group-hover:border-[var(--color-primary)]'
          } transition-colors">
            ${iconSvg}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-xs font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)] truncate">${dev.name}</span>
              ${isCurrent ? '<span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-[var(--color-primary)] text-white shrink-0">Active</span>' : ''}
            </div>
            <span class="text-[10px] font-mono text-[var(--color-mute)] block truncate mt-0.5">
              ${dev.diagonal}″ • ${dev.width}×${dev.height} px • DPR ${dev.dpr}x
            </span>
          </div>
        </div>
        <div class="text-right shrink-0">
          <span class="px-2 py-0.5 rounded-md bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs font-mono font-bold text-[var(--color-primary)] inline-block">
            ${cssPpi} PPI
          </span>
          <span class="text-[9px] text-[var(--color-mute)] block mt-0.5 font-mono">
            ${dev.ppi} physical
          </span>
        </div>
      `;

      const selectDevice = () => {
        calState = {
          ppi: cssPpi,
          method: 'device',
          deviceName: dev.name,
          isCalibrated: true,
          calibratedAt: new Date().toISOString(),
        };
        saveCalibration(calState);
        updateCalibrationUI();
        renderAllRulers();
        closeModal('calibration-modal');
      };

      card.addEventListener('click', selectDevice);
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectDevice();
        }
      });

      listContainer.appendChild(card);
    });
  }

  // --- INTERACTIVE MEASURING POINTER & MARKER ---
  function updateMarker() {
    const markerV = document.getElementById('interactive-marker-v');
    const markerH = document.getElementById('interactive-marker-h');
    const valV = document.getElementById('marker-value-v');
    const valH = document.getElementById('marker-value-h');
    const btnMarker = document.getElementById('btn-tool-marker');
    const btnMobileMarker = document.getElementById('btn-mobile-tool-marker');

    if (btnMarker) {
      btnMarker.setAttribute('aria-pressed', showMarker ? 'true' : 'false');
      btnMarker.className = showMarker
        ? 'tool-btn px-2.5 py-1.5 rounded-lg border border-[var(--color-primary)] bg-[var(--color-primary)] text-white transition-all flex items-center gap-1.5 text-xs font-semibold shadow-xs'
        : 'tool-btn px-2.5 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] transition-all flex items-center gap-1.5 text-xs font-medium';
    }

    const mSwitchBg = document.getElementById('mobile-marker-switch-bg');
    const mSwitchThumb = document.getElementById('mobile-marker-switch-thumb');
    const mMarkerStatus = document.getElementById('mobile-marker-row-status');
    const mMarkerTitle = document.getElementById('mobile-marker-row-title');

    if (btnMobileMarker) {
      btnMobileMarker.setAttribute('aria-pressed', showMarker ? 'true' : 'false');
      btnMobileMarker.className = showMarker
        ? 'w-full p-2.5 rounded-xl border border-[var(--color-primary)]/40 bg-[var(--color-primary-subdued)] hover:bg-[var(--color-primary-subdued)] transition-all flex items-center justify-between text-left cursor-pointer shadow-xs'
        : 'w-full p-2.5 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] transition-all flex items-center justify-between text-left cursor-pointer';
    }

    if (mSwitchBg) {
      mSwitchBg.className = showMarker
        ? 'w-10 h-6 bg-[var(--color-primary)] rounded-full p-0.5 transition-colors duration-200 flex items-center shrink-0'
        : 'w-10 h-6 bg-zinc-300 dark:bg-zinc-600 rounded-full p-0.5 transition-colors duration-200 flex items-center shrink-0';
    }
    if (mSwitchThumb) {
      mSwitchThumb.className = showMarker
        ? 'bg-white w-5 h-5 rounded-full shadow-md transform translate-x-4 transition-transform duration-200'
        : 'bg-white w-5 h-5 rounded-full shadow-md transform translate-x-0 transition-transform duration-200';
    }
    const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
    if (mMarkerTitle) {
      mMarkerTitle.textContent = t.tools.marker;
    }
    if (mMarkerStatus) {
      mMarkerStatus.textContent = `${t.common.status}: ${showMarker ? t.common.active : t.common.inactive}`;
      mMarkerStatus.className = showMarker
        ? 'text-[11px] text-red-600 dark:text-red-400 font-medium'
        : 'text-[11px] text-[var(--color-mute)] font-medium';
    }

    const navMarkerText = document.getElementById('nav-marker-text');
    if (navMarkerText) {
      navMarkerText.textContent = showMarker ? t.tools.marker : `${t.tools.marker} (${t.common.inactive})`;
    }

    if (!showMarker) {
      if (markerV) markerV.style.display = 'none';
      if (markerH) markerH.style.display = 'none';
      return;
    }

    const hasHorizontalEdge = activeEdges.top || activeEdges.bottom;
    const hasVerticalEdge = activeEdges.left || activeEdges.right;

    // 1. Horizontal rulers (Top or Bottom active) -> Vertical Line (markerV) moves on X-axis
    if (hasHorizontalEdge) {
      if (markerV) {
        markerV.style.display = 'flex';
        markerV.style.left = `${markerPosX}px`;
        const handleV = document.getElementById('marker-handle-v');
        if (handleV) {
          if (activeEdges.bottom && !activeEdges.top) {
            handleV.style.top = 'auto';
            handleV.style.bottom = '48px';
          } else {
            handleV.style.bottom = 'auto';
            handleV.style.top = '48px';
          }
        }
      }
      if (valV) valV.textContent = formatMeasurement(markerPosX, activeUnit, calState.ppi);
    } else {
      if (markerV) markerV.style.display = 'none';
    }

    // 2. Vertical rulers (Left or Right active) -> Horizontal Line (markerH) moves on Y-axis
    if (hasVerticalEdge) {
      if (markerH) {
        markerH.style.display = 'flex';
        markerH.style.top = `${markerPosY}px`;
        const handleH = document.getElementById('marker-handle-h');
        if (handleH) {
          if (activeEdges.right && !activeEdges.left) {
            handleH.style.left = 'auto';
            handleH.style.right = '48px';
          } else {
            handleH.style.right = 'auto';
            handleH.style.left = '48px';
          }
        }
      }
      if (valH) valH.textContent = formatMeasurement(markerPosY, activeUnit, calState.ppi);
    } else {
      if (markerH) markerH.style.display = 'none';
    }
  }

  // --- CALIPER LOGIC ---
  function updateCaliper() {
    const hud = document.getElementById('caliper-hud');
    const container = document.getElementById('caliper-container');
    const line = document.getElementById('caliper-line');
    const proj = document.getElementById('caliper-proj');
    const handleA = document.getElementById('caliper-handle-a');
    const handleB = document.getElementById('caliper-handle-b');
    const badge = document.getElementById('caliper-badge');
    const distText = document.getElementById('caliper-distance-text');
    const hudDist = document.getElementById('hud-caliper-dist');
    const hudDx = document.getElementById('hud-caliper-dx');
    const hudDy = document.getElementById('hud-caliper-dy');

    if (!showCaliper) {
      if (hud) hud.style.display = 'none';
      if (container) container.style.display = 'none';
      return;
    }

    if (hud) hud.style.display = 'flex';
    if (container) container.style.display = 'block';

    const { p1, p2 } = caliperPoints;

    if (handleA) {
      handleA.style.left = `${p1.x}px`;
      handleA.style.top = `${p1.y}px`;
    }
    if (handleB) {
      handleB.style.left = `${p2.x}px`;
      handleB.style.top = `${p2.y}px`;
    }

    if (line) {
      line.setAttribute('x1', `${p1.x}`);
      line.setAttribute('y1', `${p1.y}`);
      line.setAttribute('x2', `${p2.x}`);
      line.setAttribute('y2', `${p2.y}`);
    }

    if (proj) {
      proj.setAttribute('d', `M ${p1.x} ${p1.y} L ${p2.x} ${p1.y} L ${p2.x} ${p2.y}`);
    }

    const midX = (p1.x + p2.x) / 2;
    const midY = (p1.y + p2.y) / 2;

    if (badge) {
      badge.style.left = `${midX}px`;
      badge.style.top = `${midY}px`;
    }

    const dxPx = Math.abs(p2.x - p1.x);
    const dyPx = Math.abs(p2.y - p1.y);
    const distPx = Math.sqrt(dxPx * dxPx + dyPx * dyPx);

    const formattedDist = formatMeasurement(distPx, activeUnit, calState.ppi);
    const formattedDx = formatMeasurement(dxPx, activeUnit, calState.ppi);
    const formattedDy = formatMeasurement(dyPx, activeUnit, calState.ppi);

    if (distText) distText.textContent = formattedDist;
    if (hudDist) hudDist.textContent = formattedDist;
    if (hudDx) hudDx.textContent = formattedDx;
    if (hudDy) hudDy.textContent = formattedDy;
  }



  function renderGuideLines() {
    const container = document.getElementById('guides-container');
    if (!container) return;
    container.innerHTML = '';

    if (!showGuides && guideLines.length === 0) return;

    guideLines.forEach(g => {
      const line = document.createElement('div');
      line.className = `guide-line ${g.type === 'h' ? 'horizontal' : 'vertical'}`;
      if (g.type === 'h') {
        line.style.top = `${g.pos}px`;
      } else {
        line.style.left = `${g.pos}px`;
      }

      const badge = document.createElement('div');
      badge.className = 'guide-badge';
      const formatted = formatMeasurement(g.pos, activeUnit, calState.ppi);
      badge.textContent = formatted;

      if (g.type === 'h') {
        badge.style.left = '50px';
        badge.style.top = '-20px';
      } else {
        badge.style.left = '6px';
        badge.style.top = '60px';
      }

      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        guideLines = guideLines.filter(item => item.id !== g.id);
        renderGuideLines();
      });

      line.appendChild(badge);
      container.appendChild(line);
    });
  }

  // --- BUTTON STATE STYLING ---
  function updateEdgeButtonStyles() {
    const isAll = activeEdges.top && activeEdges.bottom && activeEdges.left && activeEdges.right;

    document.querySelectorAll('[data-edge-btn]').forEach(btn => {
      const edge = btn.getAttribute('data-edge-btn');
      let isActive = false;
      if (edge === 'frame') {
        isActive = isAll;
      } else if (edge && edge in activeEdges) {
        isActive = !!activeEdges[edge as keyof typeof activeEdges];
      }
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      btn.classList.toggle('active', isActive);
    });

    document.querySelectorAll('[data-edge-btn-mobile]').forEach(btn => {
      const edge = btn.getAttribute('data-edge-btn-mobile');
      let isActive = false;
      if (edge === 'frame') {
        isActive = isAll;
      } else if (edge && edge in activeEdges) {
        isActive = !!activeEdges[edge as keyof typeof activeEdges];
      }
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      btn.classList.toggle('active', isActive);
    });



    const caliperBtn = document.getElementById('btn-tool-caliper');
    if (caliperBtn) caliperBtn.setAttribute('aria-pressed', showCaliper ? 'true' : 'false');

    const mobileCaliperBtn = document.getElementById('btn-mobile-tool-caliper');
    if (mobileCaliperBtn) {
      mobileCaliperBtn.className = showCaliper
        ? 'p-2 rounded-xl border border-[var(--color-primary)] bg-[var(--color-primary)] text-white text-xs font-semibold flex flex-col items-center gap-1 shadow-xs'
        : 'p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-[var(--color-body)] text-xs font-medium flex flex-col items-center gap-1';
    }
  }

  function updateUnitButtonStyles() {
    document.querySelectorAll('.unit-btn').forEach(btn => {
      const u = btn.getAttribute('data-unit');
      if (u === activeUnit) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  function openModal(id: string) {
    const m = document.getElementById(id);
    if (m) m.style.display = 'flex';
  }

  function closeModal(id: string) {
    const m = document.getElementById(id);
    if (m) m.style.display = 'none';
  }

  // --- EVENT LISTENERS BINDINGS ---
  function bindEvents() {
    // Window Resize
    window.addEventListener('resize', () => {
      renderAllRulers();
      checkAutoDetection();
    });

    // Theme Toggle
    const themeBtn = document.getElementById('btn-theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
      } catch (e) {}
      renderAllRulers();
    });

    // Listen for external language changes
    window.addEventListener('languagechange', ((e: CustomEvent<{ lang: Language }>) => {
      const nextLang = e.detail?.lang;
      if (nextLang && nextLang !== currentLang) {
        applyLanguage(nextLang);
        renderAllRulers();
        renderDeviceCatalog();
        checkAutoDetection();
      }
    }) as EventListener);

    // Coordinate Mobile Tools Drawer with Ruler State
    const mobileToolsBtn = document.getElementById('btn-mobile-tools-toggle');
    mobileToolsBtn?.addEventListener('click', () => {
      updateEdgeButtonStyles();
      updateMarker();
    });

    // Edge Placement Handler (Desktop & Mobile Unified)
    const handleEdgeClick = (edge: string) => {
      if (edge === 'frame') {
        const isAll = activeEdges.top && activeEdges.bottom && activeEdges.left && activeEdges.right;
        if (isAll) {
          activeEdges = { top: true, bottom: false, left: false, right: false };
        } else {
          activeEdges = { top: true, bottom: true, left: true, right: true };
        }
      } else if (edge && edge in activeEdges) {
        const k = edge as keyof typeof activeEdges;
        const currentVal = activeEdges[k];
        const activeCount = Object.values(activeEdges).filter(Boolean).length;

        // If clicking the only active edge, keep it active (ensure at least 1 edge is visible)
        if (currentVal && activeCount === 1) {
          activeEdges[k] = true;
        } else {
          activeEdges[k] = !currentVal;
        }
      }

      // Hide welcome banner once an edge is clicked
      const welcome = document.getElementById('welcome-state');
      if (welcome) welcome.style.display = 'none';

      const mobileSheet = document.getElementById('mobile-tools-sheet');
      if (mobileSheet) mobileSheet.style.display = 'none';

      renderAllRulers();
    };

    // Mobile Edge Buttons
    document.querySelectorAll('[data-edge-btn-mobile]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const edge = btn.getAttribute('data-edge-btn-mobile');
        if (edge) handleEdgeClick(edge);
      });
    });

    function closeMobileDrawer() {
      const drawer = document.getElementById('mobile-tools-drawer');
      const backdrop = document.getElementById('mobile-tools-backdrop');
      drawer?.classList.add('translate-y-full');
      drawer?.classList.remove('translate-y-0');
      drawer?.setAttribute('aria-hidden', 'true');
      backdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Mobile Drawer Tool Buttons
    document.getElementById('btn-mobile-tool-marker')?.addEventListener('click', (e) => {
      e.preventDefault();
      showMarker = !showMarker;
      updateMarker();
      closeMobileDrawer();
    });

    document.getElementById('btn-mobile-tool-caliper')?.addEventListener('click', () => {
      showCaliper = !showCaliper;
      updateCaliper();
      updateEdgeButtonStyles();
      closeMobileDrawer();
    });

    // Edge Placement Buttons (Desktop Navbar)
    document.querySelectorAll('[data-edge-btn]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const edge = btn.getAttribute('data-edge-btn');
        if (edge) handleEdgeClick(edge);
      });
    });

    // Quick Edge Buttons in Welcome Banner
    document.querySelectorAll('[data-quick-edge]').forEach(btn => {
      btn.addEventListener('click', () => {
        const edge = btn.getAttribute('data-quick-edge');
        if (edge && edge in activeEdges) {
          activeEdges = { top: false, bottom: false, left: false, right: false };
          activeEdges[edge as keyof typeof activeEdges] = true;
          const welcome = document.getElementById('welcome-state');
          if (welcome) welcome.style.display = 'none';
          renderAllRulers();
        }
      });
    });

    // Hide Welcome Banner
    document.getElementById('btn-hide-welcome')?.addEventListener('click', () => {
      const welcome = document.getElementById('welcome-state');
      if (welcome) welcome.style.display = 'none';
    });

    // Unit Switcher (cm, mm, in, px, pt)
    document.querySelectorAll('.unit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const u = btn.getAttribute('data-unit') as MeasurementUnit;
        if (u) {
          activeUnit = u;
          try {
            localStorage.setItem(STORAGE_KEY_UNIT, activeUnit);
          } catch (e) {}
          renderAllRulers();
        }
      });
    });

    // Tool Toggles

    document.getElementById('btn-tool-crosshair')?.addEventListener('click', () => {
      showCrosshair = !showCrosshair;
      const chH = document.getElementById('crosshair-h');
      const chV = document.getElementById('crosshair-v');
      const readout = document.getElementById('cursor-readout');
      if (chH) chH.style.display = showCrosshair ? 'block' : 'none';
      if (chV) chV.style.display = showCrosshair ? 'block' : 'none';
      if (readout) readout.style.display = showCrosshair ? 'block' : 'none';
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-tool-grid')?.addEventListener('click', () => {
      showGrid = !showGrid;
      renderAllRulers();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-tool-caliper')?.addEventListener('click', () => {
      showCaliper = !showCaliper;
      updateCaliper();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-close-caliper-hud')?.addEventListener('click', () => {
      showCaliper = false;
      updateCaliper();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-copy-caliper')?.addEventListener('click', () => {
      const hudDist = document.getElementById('hud-caliper-dist')?.textContent;
      if (hudDist) {
        navigator.clipboard.writeText(hudDist);
        const copyText = document.getElementById('copy-caliper-text');
        if (copyText) {
          const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
          copyText.textContent = t.tools.copied;
          setTimeout(() => {
            if (copyText) copyText.textContent = t.tools.copy;
          }, 1500);
        }
      }
    });

    document.getElementById('caliper-badge')?.addEventListener('click', () => {
      const distText = document.getElementById('caliper-distance-text')?.textContent;
      if (distText) {
        navigator.clipboard.writeText(distText);
      }
    });

    // Caliper drag handles (Pointer & Touch support)
    const handleA = document.getElementById('caliper-handle-a');
    const handleB = document.getElementById('caliper-handle-b');
    const rulerWs = document.getElementById('ruler-workspace');

    handleA?.addEventListener('pointerdown', (e) => {
      isDraggingCaliper = 'p1';
      (e.target as HTMLElement).setPointerCapture(e.pointerId);
    });

    handleB?.addEventListener('pointerdown', (e) => {
      isDraggingCaliper = 'p2';
      (e.target as HTMLElement).setPointerCapture(e.pointerId);
    });

    window.addEventListener('pointermove', (e) => {
      if (isDraggingCaliper && rulerWs) {
        const rect = rulerWs.getBoundingClientRect();
        const x = Math.max(10, Math.min(rect.width - 10, e.clientX - rect.left));
        const y = Math.max(10, Math.min(rect.height - 10, e.clientY - rect.top));

        if (isDraggingCaliper === 'p1') {
          caliperPoints.p1 = { x, y };
        } else if (isDraggingCaliper === 'p2') {
          caliperPoints.p2 = { x, y };
        }
        updateCaliper();
      }

      // Crosshair Movement
      if (showCrosshair && rulerWs) {
        const rect = rulerWs.getBoundingClientRect();
        if (e.clientY >= rect.top && e.clientY <= rect.bottom) {
          const chH = document.getElementById('crosshair-h');
          const chV = document.getElementById('crosshair-v');
          const readout = document.getElementById('cursor-readout');

          const relY = e.clientY - rect.top;
          const relX = e.clientX - rect.left;

          if (chH) chH.style.top = `${relY}px`;
          if (chV) chV.style.left = `${relX}px`;

          if (readout) {
            readout.style.left = `${relX}px`;
            readout.style.top = `${relY}px`;
            const formattedX = formatMeasurement(relX, activeUnit, calState.ppi);
            const formattedY = formatMeasurement(relY, activeUnit, calState.ppi);
            readout.textContent = `X: ${formattedX} | Y: ${formattedY}`;
          }
        }
      }
    });

    window.addEventListener('pointerup', () => {
      isDraggingCaliper = null;
    });

    // Marker Toggle Button
    const btnToolMarker = document.getElementById('btn-tool-marker');
    btnToolMarker?.addEventListener('click', () => {
      showMarker = !showMarker;
      updateMarker();
    });

    // Copy Measurement when clicking on Point Tag
    document.getElementById('marker-handle-v')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const val = document.getElementById('marker-value-v')?.textContent;
      if (val) {
        navigator.clipboard.writeText(val);
        const feedback = document.createElement('div');
        feedback.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 px-3 py-1.5 rounded-full bg-[var(--color-primary)] text-white text-xs font-mono shadow-lg z-50 animate-bounce';
        const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
        feedback.textContent = `✓ ${t.common.copied}: ${val}`;
        document.body.appendChild(feedback);
        setTimeout(() => feedback.remove(), 1500);
      }
    });

    document.getElementById('marker-handle-h')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const val = document.getElementById('marker-value-h')?.textContent;
      if (val) {
        navigator.clipboard.writeText(val);
        const feedback = document.createElement('div');
        feedback.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 px-3 py-1.5 rounded-full bg-[var(--color-primary)] text-white text-xs font-mono shadow-lg z-50 animate-bounce';
        const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
        feedback.textContent = `✓ ${t.common.copied}: ${val}`;
        document.body.appendChild(feedback);
        setTimeout(() => feedback.remove(), 1500);
      }
    });

    // Marker Drag Handles & Touch Zones
    const handleV = document.getElementById('marker-handle-v');
    const handleH = document.getElementById('marker-handle-h');
    const touchZoneV = document.getElementById('marker-touch-zone-v');
    const touchZoneH = document.getElementById('marker-touch-zone-h');

    [handleV, touchZoneV].forEach(el => {
      el?.addEventListener('mousedown', () => { isDraggingMarkerV = true; });
      el?.addEventListener('touchstart', () => { isDraggingMarkerV = true; }, { passive: true });
    });

    [handleH, touchZoneH].forEach(el => {
      el?.addEventListener('mousedown', () => { isDraggingMarkerH = true; });
      el?.addEventListener('touchstart', () => { isDraggingMarkerH = true; }, { passive: true });
    });

    window.addEventListener('mousemove', (e) => {
      if (rulerWs) {
        const rect = rulerWs.getBoundingClientRect();
        if (isDraggingMarkerV) {
          markerPosX = Math.max(0, e.clientX - rect.left);
          updateMarker();
        }
        if (isDraggingMarkerH) {
          markerPosY = Math.max(0, e.clientY - rect.top);
          updateMarker();
        }
      }
    });

    window.addEventListener('touchmove', (e) => {
      if (rulerWs && e.touches[0]) {
        const rect = rulerWs.getBoundingClientRect();
        if (isDraggingMarkerV) {
          markerPosX = Math.max(0, e.touches[0].clientX - rect.left);
          updateMarker();
        }
        if (isDraggingMarkerH) {
          markerPosY = Math.max(0, e.touches[0].clientY - rect.top);
          updateMarker();
        }
      }
    }, { passive: true });

    window.addEventListener('mouseup', () => {
      isDraggingMarkerV = false;
      isDraggingMarkerH = false;
    });
    window.addEventListener('touchend', () => {
      isDraggingMarkerV = false;
      isDraggingMarkerH = false;
    });

    // Click on ruler canvases or surface to drop / move marker instantly (preserves show/hide state)
    ['ruler-canvas-top', 'ruler-canvas-bottom'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', (e: MouseEvent) => {
        const wsRect = rulerWs?.getBoundingClientRect() || { left: 0, top: 52 };
        markerPosX = Math.max(0, e.clientX - wsRect.left);
        if (showMarker) updateMarker();
      });
    });

    ['ruler-canvas-left', 'ruler-canvas-right'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', (e: MouseEvent) => {
        const wsRect = rulerWs?.getBoundingClientRect() || { left: 0, top: 52 };
        markerPosY = Math.max(0, e.clientY - wsRect.top);
        if (showMarker) updateMarker();
      });
    });

    document.getElementById('measuring-surface')?.addEventListener('click', (e: MouseEvent) => {
      const wsRect = rulerWs?.getBoundingClientRect() || { left: 0, top: 52 };
      markerPosX = Math.max(0, e.clientX - wsRect.left);
      markerPosY = Math.max(0, e.clientY - wsRect.top);
      if (showMarker) updateMarker();
    });

    // Modals open / close triggers
    const searchInput = document.getElementById('device-search-input') as HTMLInputElement;

    const openCalibrateModal = () => {
      openModal('calibration-modal');
      updateDevCategoryPills(activeDevCat);
      renderDeviceCatalog(activeDevCat, searchInput?.value || '');
      updateDiagonalPreview();
      updateCardSimulator();
    };

    document.getElementById('btn-open-calibrate')?.addEventListener('click', openCalibrateModal);
    document.getElementById('btn-welcome-cal-status')?.addEventListener('click', openCalibrateModal);
    document.getElementById('welcome-change-device')?.addEventListener('click', openCalibrateModal);
    document.getElementById('btn-close-cal-modal')?.addEventListener('click', () => closeModal('calibration-modal'));
    document.getElementById('btn-close-cal-bottom')?.addEventListener('click', () => closeModal('calibration-modal'));

    document.getElementById('btn-open-howto')?.addEventListener('click', () => openModal('howto-modal'));
    document.getElementById('btn-close-howto-modal')?.addEventListener('click', () => closeModal('howto-modal'));
    document.getElementById('btn-close-howto-bottom')?.addEventListener('click', () => closeModal('howto-modal'));

    document.getElementById('btn-tool-silhouettes')?.addEventListener('click', () => openModal('silhouettes-modal'));
    document.getElementById('btn-close-silhouettes')?.addEventListener('click', () => closeModal('silhouettes-modal'));

    // Calibration modal tabs
    document.querySelectorAll('[data-cal-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-cal-tab');
        document.querySelectorAll('.cal-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('.cal-panel').forEach(p => ((p as HTMLElement).style.display = 'none'));
        const activePanel = document.getElementById(`tab-panel-${tab}`);
        if (activePanel) activePanel.style.display = 'block';

        if (tab === 'device') {
          updateDevCategoryPills(activeDevCat);
          renderDeviceCatalog(activeDevCat, searchInput?.value || '');
        } else if (tab === 'diagonal') {
          updateDiagonalPreview();
        } else if (tab === 'card') {
          updateCardSimulator();
        }
      });
    });

    // Calibration Method 1: Apply Auto
    document.getElementById('btn-apply-auto')?.addEventListener('click', () => {
      const detected = detectCurrentDevice();
      calState = {
        ppi: detected.estimatedPpi,
        method: 'auto',
        deviceName: detected.match ? detected.match.name : (currentLang === 'id' ? `Layar Terdeteksi (~${Math.round(detected.estimatedPpi)} PPI)` : `Detected Screen (~${Math.round(detected.estimatedPpi)} PPI)`),
        isCalibrated: true,
        calibratedAt: new Date().toISOString(),
      };
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Calibration Method 2: Diagonal
    const diagInput = (document.getElementById('diagonal-input') || document.getElementById('diagonal-input-val')) as HTMLInputElement;
    const diagCalcRes = document.getElementById('diagonal-calc-result');

    function updateDiagonalPreview() {
      const val = parseFloat(diagInput?.value || '0');
      if (val >= 3 && val <= 100) {
        const ppi = calculatePpiFromDiagonal(val);
        if (diagCalcRes) diagCalcRes.textContent = `≈ ${ppi.toFixed(1)} PPI`;
      } else if (diagCalcRes) {
        diagCalcRes.textContent = '';
      }
    }

    diagInput?.addEventListener('input', updateDiagonalPreview);

    document.querySelectorAll('.diag-preset-btn, .diag-chip, [data-diag-preset], [data-diag]').forEach(chip => {
      chip.addEventListener('click', () => {
        const d = chip.getAttribute('data-diag-preset') || chip.getAttribute('data-diag');
        if (d && diagInput) {
          diagInput.value = d;
          updateDiagonalPreview();
        }
      });
    });

    document.getElementById('btn-apply-diagonal')?.addEventListener('click', () => {
      const val = parseFloat(diagInput?.value || '0');
      if (val >= 3 && val <= 100) {
        const ppi = calculatePpiFromDiagonal(val);
        calState = {
          ppi,
          method: 'diagonal',
          deviceName: `Diagonal ${val}″`,
          isCalibrated: true,
          calibratedAt: new Date().toISOString(),
        };
        saveCalibration(calState);
        updateCalibrationUI();
        renderAllRulers();
        closeModal('calibration-modal');
      }
    });

    // Calibration Method 3: Credit Card Slider & Nudging
    const cardSlider = document.getElementById('card-ppi-slider') as HTMLInputElement;
    const cardPpiDisplay = document.getElementById('card-ppi-display');

    cardSlider?.addEventListener('input', (e) => {
      const newPpi = parseFloat((e.target as HTMLInputElement).value);
      calState.ppi = newPpi;
      if (cardPpiDisplay) cardPpiDisplay.textContent = `${newPpi.toFixed(1)} PPI`;
      updateCardSimulator();
    });

    document.getElementById('btn-card-minus')?.addEventListener('click', () => {
      if (cardSlider) {
        const val = Math.max(50, parseFloat(cardSlider.value) - 0.5);
        cardSlider.value = `${val}`;
        calState.ppi = val;
        if (cardPpiDisplay) cardPpiDisplay.textContent = `${val.toFixed(1)} PPI`;
        updateCardSimulator();
      }
    });

    document.getElementById('btn-card-plus')?.addEventListener('click', () => {
      if (cardSlider) {
        const val = Math.min(260, parseFloat(cardSlider.value) + 0.5);
        cardSlider.value = `${val}`;
        calState.ppi = val;
        if (cardPpiDisplay) cardPpiDisplay.textContent = `${val.toFixed(1)} PPI`;
        updateCardSimulator();
      }
    });

    document.getElementById('btn-apply-card-cal')?.addEventListener('click', () => {
      calState.isCalibrated = true;
      calState.method = 'card';
      calState.deviceName = currentLang === 'id' ? 'Kalibrasi Kartu Fisik' : 'Physical Card Calibrated';
      calState.calibratedAt = new Date().toISOString();
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Reset Calibration
    document.getElementById('btn-reset-cal')?.addEventListener('click', () => {
      calState = {
        ppi: 96,
        method: 'custom',
        deviceName: currentLang === 'id' ? 'Standar Default (96 PPI)' : 'Default Standard (96 PPI)',
        isCalibrated: false,
        calibratedAt: new Date().toISOString(),
      };
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Device Catalog Search & Categories
    searchInput?.addEventListener('input', (e) => {
      renderDeviceCatalog(activeDevCat, (e.target as HTMLInputElement).value);
    });

    document.querySelectorAll('.dev-cat-btn, [data-dev-filter], .cat-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-dev-filter') || btn.getAttribute('data-cat') || 'all';
        activeDevCat = cat;
        updateDevCategoryPills(activeDevCat);
        renderDeviceCatalog(activeDevCat, searchInput?.value || '');
      });
    });

    // Silhouette Item Selector
    document.querySelectorAll('.obj-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const obj = btn.getAttribute('data-obj');
        const box = document.getElementById('active-silhouette-box');
        const label = document.getElementById('silhouette-label');
        if (!box) return;

        let wMm = 85.6;
        let hMm = 53.98;
        let name = currentLang === 'id' ? 'Kartu ATM / KTP' : 'Credit Card / ID';

        if (obj === 'coin-idr') {
          wMm = 24.15;
          hMm = 24.15;
          name = currentLang === 'id' ? 'Koin Rp 1.000 (Ø 24.15 mm)' : 'Rp 1,000 Coin (Ø 24.15 mm)';
        } else if (obj === 'coin-usd') {
          wMm = 24.26;
          hMm = 24.26;
          name = currentLang === 'id' ? 'US Quarter $0.25 (Ø 24.26 mm)' : 'US Quarter $0.25 (Ø 24.26 mm)';
        } else if (obj === 'battery-aa') {
          wMm = 50.5;
          hMm = 14.5;
          name = currentLang === 'id' ? 'Baterai AA (50.50 × 14.50 mm)' : 'AA Battery (50.50 × 14.50 mm)';
        } else if (obj === 'sim') {
          wMm = 12.3;
          hMm = 8.8;
          name = currentLang === 'id' ? 'Nano SIM Card (12.30 × 8.80 mm)' : 'Nano SIM Card (12.30 × 8.80 mm)';
        } else if (obj === 'banknote') {
          wMm = 121.0;
          hMm = 65.0;
          name = currentLang === 'id' ? 'Uang Kertas IDR (121.0 × 65.0 mm)' : 'IDR Banknote (121.0 × 65.0 mm)';
        }

        const wPx = Math.round((wMm / 25.4) * calState.ppi);
        const hPx = Math.round((hMm / 25.4) * calState.ppi);

        box.style.width = `${wPx}px`;
        box.style.height = `${hPx}px`;
        if (obj === 'coin-idr' || obj === 'coin-usd') {
          box.style.borderRadius = '9999px';
        } else {
          box.style.borderRadius = '8px';
        }

        if (label) label.textContent = `${name} (${wPx}×${hPx} px)`;
      });
    });

    // Global Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'SELECT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
        return;
      }

      switch (e.key) {
        case '1':
          activeUnit = 'cm';
          renderAllRulers();
          break;
        case '2':
          activeUnit = 'mm';
          renderAllRulers();
          break;
        case '3':
          activeUnit = 'in';
          renderAllRulers();
          break;
        case 't':
        case 'T':
          handleEdgeClick('top');
          break;
        case 'b':
        case 'B':
          handleEdgeClick('bottom');
          break;
        case 'l':
        case 'L':
          handleEdgeClick('left');
          break;
        case 'r':
        case 'R':
          handleEdgeClick('right');
          break;
        case 'a':
        case 'A':
          handleEdgeClick('frame');
          break;
        case 'p':
        case 'P':
          showMarker = !showMarker;
          updateMarker();
          break;
        case 'g':
        case 'G':
          showGuides = !showGuides;
          renderGuideLines();
          updateEdgeButtonStyles();
          break;
        case 'c':
        case 'C':
          showCrosshair = !showCrosshair;
          const chH = document.getElementById('crosshair-h');
          const chV = document.getElementById('crosshair-v');
          const readout = document.getElementById('cursor-readout');
          if (chH) chH.style.display = showCrosshair ? 'block' : 'none';
          if (chV) chV.style.display = showCrosshair ? 'block' : 'none';
          if (readout) readout.style.display = showCrosshair ? 'block' : 'none';
          updateEdgeButtonStyles();
          break;
        case 'm':
        case 'M':
          showGrid = !showGrid;
          renderAllRulers();
          updateEdgeButtonStyles();
          break;
        case 'k':
        case 'K':
          showCaliper = !showCaliper;
          updateCaliper();
          updateEdgeButtonStyles();
          break;
        case 'f':
        case 'F':
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
          break;
        case 'd':
        case 'D':
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
          } catch (err) {}
          renderAllRulers();
          break;
        case 'h':
        case 'H':
          openModal('howto-modal');
          break;
        case 'Escape':
          closeModal('calibration-modal');
          closeModal('howto-modal');
          closeModal('silhouettes-modal');
          const mobDrawer = document.getElementById('mobile-tools-drawer');
          if (mobDrawer) mobDrawer.style.display = 'none';
          guideLines = [];
          renderGuideLines();
          break;
        case 'ArrowLeft':
        case 'ArrowDown':
          if (document.getElementById('tab-panel-card')?.style.display === 'block') {
            const val = Math.max(50, calState.ppi - 0.2);
            calState.ppi = val;
            const slider = document.getElementById('card-ppi-slider') as HTMLInputElement;
            if (slider) slider.value = `${val}`;
            const disp = document.getElementById('card-ppi-display');
            if (disp) disp.textContent = `${val.toFixed(1)} PPI`;
            updateCardSimulator();
          }
          break;
        case 'ArrowRight':
        case 'ArrowUp':
          if (document.getElementById('tab-panel-card')?.style.display === 'block') {
            const val = Math.min(260, calState.ppi + 0.2);
            calState.ppi = val;
            const slider = document.getElementById('card-ppi-slider') as HTMLInputElement;
            if (slider) slider.value = `${val}`;
            const disp = document.getElementById('card-ppi-display');
            if (disp) disp.textContent = `${val.toFixed(1)} PPI`;
            updateCardSimulator();
          }
          break;
      }
    });
  }

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
  } else {
    initApp();
  }
</script>
