---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={`${t.contact.title} — ${t.siteName}`}
  description={t.contact.lead}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-3xl mx-auto text-[var(--color-ink)] space-y-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-mute)]" aria-label="Breadcrumb">
      <a href={translatePath('/')} class="hover:text-[var(--color-ink)] transition-colors">
        {t.footer.home}
      </a>
      <span>/</span>
      <span class="text-[var(--color-primary)] font-medium">{t.contact.title}</span>
    </nav>

    <!-- Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-primary-subdued)] text-[var(--color-primary)] text-xs font-bold font-mono border border-[var(--color-hairline)]">
        {t.contact.badge}
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        {t.contact.title}
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-body)] leading-relaxed">
        {t.contact.lead}
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="space-y-4">
      <div class="p-5 sm:p-6 rounded-xl bg-[var(--color-canvas-card)] border border-[var(--color-hairline)] space-y-4 shadow-xs">
        <h2 class="text-sm sm:text-base font-bold text-[var(--color-ink)] flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-primary)] shrink-0"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>{t.contact.infoTitle}</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-1">
            <span class="text-[11px] text-[var(--color-mute)] block font-medium">{t.contact.emailLabel}:</span>
            <a href={`mailto:${t.contact.email}`} class="font-mono text-xs sm:text-sm font-bold text-[var(--color-primary)] hover:underline">
              {t.contact.email}
            </a>
          </div>

          <div class="p-3.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-1">
            <span class="text-[11px] text-[var(--color-mute)] block font-medium">{t.contact.domainLabel}:</span>
            <span class="font-mono text-xs sm:text-sm font-bold text-[var(--color-ink)]">{t.contact.domain}</span>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs text-[var(--color-body)]">
          <strong class="text-[var(--color-ink)]">{t.contact.respLabel}:</strong> {t.contact.respVal}
        </div>
      </div>

      <!-- Tip Card -->
      <div class="p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs text-[var(--color-body)] leading-relaxed">
        <strong class="text-[var(--color-primary)]">Tip:</strong> {t.contact.tipBox}
      </div>
    </div>

    <!-- Back Action -->
    <div class="pt-2">
      <a
        href={translatePath('/')}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--color-primary)] text-white text-xs font-semibold hover:bg-[var(--color-primary-hover)] transition-all shadow-xs"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>{t.common.backToRuler}</span>
      </a>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
