---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}
const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
---

<div
  id="welcome-state"
  class="absolute inset-0 flex flex-col items-center justify-center p-4 sm:p-6 text-center select-none pointer-events-auto z-15 transition-all duration-300"
  style="display: none;"
>
  <div class="max-w-md w-full mx-auto space-y-5 p-5 sm:p-6 rounded-2xl bg-[var(--color-canvas-card)] border border-[var(--color-hairline)] shadow-lg text-[var(--color-ink)]">
    <!-- Icon & Title -->
    <div class="space-y-2">
      <div class="w-10 h-10 rounded-xl bg-[var(--color-primary)] text-white flex items-center justify-center mx-auto shadow-xs">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="2" y="6" width="20" height="12" rx="2" />
          <line x1="6" y1="6" x2="6" y2="12" />
          <line x1="10" y1="6" x2="10" y2="9" />
          <line x1="14" y1="6" x2="14" y2="12" />
          <line x1="18" y1="6" x2="18" y2="9" />
        </svg>
      </div>

      <h2 id="welcome-title" class="text-base sm:text-lg font-bold tracking-tight text-[var(--color-ink)]">
        {t.welcome.title}
      </h2>
      <p id="welcome-subtitle" class="text-xs text-[var(--color-body)] leading-relaxed">
        {t.welcome.subtitle}
      </p>
    </div>

    <!-- Quick Start Edge Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <button
        data-quick-edge="top"
        class="quick-edge-btn p-2.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas-card)] text-left transition-all group cursor-pointer"
      >
        <span id="welcome-quick-top-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-[var(--color-primary)] block mb-0.5">{t.welcome.top}</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">{t.common.horizontal}</span>
      </button>

      <button
        data-quick-edge="bottom"
        class="quick-edge-btn p-2.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas-card)] text-left transition-all group cursor-pointer"
      >
        <span id="welcome-quick-bottom-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-[var(--color-primary)] block mb-0.5">{t.welcome.bottom}</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">{t.common.horizontal}</span>
      </button>

      <button
        data-quick-edge="left"
        class="quick-edge-btn p-2.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas-card)] text-left transition-all group cursor-pointer"
      >
        <span id="welcome-quick-left-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-[var(--color-primary)] block mb-0.5">{t.welcome.left}</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">{t.common.vertical}</span>
      </button>

      <button
        data-quick-edge="right"
        class="quick-edge-btn p-2.5 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas-card)] text-left transition-all group cursor-pointer"
      >
        <span id="welcome-quick-right-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-[var(--color-primary)] block mb-0.5">{t.welcome.right}</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">{t.common.vertical}</span>
      </button>
    </div>

    <!-- Calibration Status & Action -->
    <div class="space-y-1.5 pt-1">
      <button
        id="btn-welcome-cal-status"
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-xs text-[var(--color-ink)] hover:bg-[var(--color-canvas-card)] transition-all shadow-xs group cursor-pointer"
      >
        <span id="welcome-status-dot" class="w-2 h-2 rounded-full bg-emerald-500 group-hover:scale-125 transition-transform shadow-xs"></span>
        <span id="welcome-status-text" class="font-medium text-xs">{t.welcome.calStatusCalibrated}</span>
      </button>

      <p id="welcome-change-device" class="text-[11px] text-[var(--color-mute)] hover:text-[var(--color-primary)] hover:underline cursor-pointer transition-colors">
        {t.welcome.calWrongDevice}
      </p>
    </div>

    <!-- Hide Banner Button -->
    <div>
      <button
        id="btn-hide-welcome"
        class="px-3.5 py-1 rounded-full border border-[var(--color-hairline)] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-colors cursor-pointer"
      >
        {t.welcome.hideInfo}
      </button>
    </div>
  </div>
</div>
