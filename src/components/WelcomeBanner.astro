---
export interface Props {
  lang?: 'id' | 'en';
}
const { lang = 'id' } = Astro.props;
---

<div
  id="welcome-state"
  class="absolute inset-0 flex flex-col items-center justify-center p-4 sm:p-6 text-center select-none pointer-events-auto z-15 transition-all duration-300"
>
  <div class="max-w-md w-full mx-auto space-y-4">
    <!-- Icon & Title -->
    <div class="space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-sm text-indigo-500 flex items-center justify-center mx-auto">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="2" y="6" width="20" height="12" rx="2" />
          <line x1="6" y1="6" x2="6" y2="12" />
          <line x1="10" y1="6" x2="10" y2="9" />
          <line x1="14" y1="6" x2="14" y2="12" />
          <line x1="18" y1="6" x2="18" y2="9" />
        </svg>
      </div>

      <h1 id="welcome-title" class="text-lg sm:text-xl font-bold tracking-tight text-[var(--color-ink)]">
        Pilih Posisi Penggaris pada Layar
      </h1>
      <p id="welcome-subtitle" class="text-xs text-[var(--color-body)] leading-relaxed">
        Pilih sisi tepi layar untuk meletakkan penggaris, atau gunakan tombol cepat di bawah:
      </p>
    </div>

    <!-- Quick Start Edge Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <button
        data-quick-edge="top"
        class="quick-edge-btn p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-indigo-500 hover:shadow-md text-left transition-all group"
      >
        <span id="welcome-quick-top-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-indigo-500 block mb-0.5">ATAS</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">Horizontal</span>
      </button>

      <button
        data-quick-edge="bottom"
        class="quick-edge-btn p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-indigo-500 hover:shadow-md text-left transition-all group"
      >
        <span id="welcome-quick-bottom-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-indigo-500 block mb-0.5">BAWAH</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">Horizontal</span>
      </button>

      <button
        data-quick-edge="left"
        class="quick-edge-btn p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-indigo-500 hover:shadow-md text-left transition-all group"
      >
        <span id="welcome-quick-left-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-indigo-500 block mb-0.5">KIRI</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">Vertikal</span>
      </button>

      <button
        data-quick-edge="right"
        class="quick-edge-btn p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-indigo-500 hover:shadow-md text-left transition-all group"
      >
        <span id="welcome-quick-right-label" class="text-[10px] font-mono font-bold text-[var(--color-mute)] group-hover:text-indigo-500 block mb-0.5">KANAN</span>
        <span class="text-xs font-semibold text-[var(--color-ink)]">Vertikal</span>
      </button>
    </div>

    <!-- Calibration Status & Action -->
    <div class="space-y-1.5 pt-1">
      <button
        id="btn-welcome-cal-status"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-all shadow-sm group"
      >
        <span id="welcome-status-dot" class="w-2 h-2 rounded-full bg-emerald-500 group-hover:scale-125 transition-transform"></span>
        <span id="welcome-status-text" class="font-medium">Terkalibrasi otomatis untuk layar ini</span>
      </button>

      <p id="welcome-change-device" class="text-[11px] text-[var(--color-mute)] hover:text-indigo-500 hover:underline cursor-pointer transition-colors">
        Bukan perangkat Anda? Klik di sini untuk kalibrasi ulang.
      </p>
    </div>

    <!-- Hide Banner Button -->
    <div>
      <button
        id="btn-hide-welcome"
        class="px-4 py-1.5 rounded-full border border-[var(--color-hairline)] text-xs font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-colors"
      >
        Tutup Info Ini
      </button>
    </div>
  </div>
</div>
