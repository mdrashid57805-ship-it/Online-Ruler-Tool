---
import { defaultLang, type SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}
const { lang = defaultLang } = Astro.props;
const isId = lang === 'id';
---

<div
  id="silhouettes-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-md select-none transition-opacity duration-200"
  style="display: none;"
>
  <div class="bg-[var(--color-canvas)] rounded-2xl shadow-2xl border border-[var(--color-hairline)] w-full max-w-[520px] p-5 space-y-4 text-[var(--color-ink)]">
    <div class="flex items-center justify-between border-b border-[var(--color-hairline)] pb-3">
      <div class="flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-red-600"></div>
        <h3 id="silhouettes-modal-title" class="text-sm sm:text-base font-bold text-[var(--color-ink)]">
          {isId ? 'Bandingkan Ukuran Objek Fisik (Skala 1:1)' : 'Physical Object Scale Reference (1:1)'}
        </h3>
      </div>
      <button
        id="btn-close-silhouettes"
        class="w-7 h-7 rounded-lg flex items-center justify-center text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-colors"
        title="Close (Esc)"
      >
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </div>

    <p id="silhouettes-modal-desc" class="text-xs text-[var(--color-body)] leading-relaxed">
      {isId 
        ? 'Pilih objek di bawah untuk menampilkan siluet ukuran sebenarnya di layar. Tempelkan objek fisik Anda pada layar untuk memeriksa presisi kalibrasi:'
        : 'Select an object below to display its true 1:1 physical silhouette on screen. Place the real item against your screen to verify calibration:'}
    </p>

    <!-- Silhouette Scale Item Previews -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
      <button data-obj="card" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-card" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          {isId ? 'Kartu ATM / KTP' : 'Credit Card / ID'}
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">85.60 × 53.98 mm</span>
      </button>

      <button data-obj="coin-idr" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-coin" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          {isId ? 'Koin Rp 1.000' : 'Rp 1,000 Coin'}
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">Ø 24.15 mm</span>
      </button>

      <button data-obj="coin-usd" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-quarter" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          US Quarter ($0.25)
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">Ø 24.26 mm</span>
      </button>

      <button data-obj="battery-aa" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-battery" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          {isId ? 'Baterai AA' : 'AA Battery'}
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">50.50 × 14.50 mm</span>
      </button>

      <button data-obj="sim" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-sim" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          Nano SIM Card
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">12.30 × 8.80 mm</span>
      </button>

      <button data-obj="banknote-idr" class="obj-btn p-2.5 rounded-xl border border-[var(--color-hairline)] hover:border-red-500 hover:bg-[var(--color-canvas-soft)] text-left transition-all group">
        <span id="sil-obj-note" class="font-semibold block text-[var(--color-ink)] group-hover:text-red-600">
          {isId ? 'Uang Kertas IDR' : 'Banknote (IDR)'}
        </span>
        <span class="text-[10px] font-mono text-[var(--color-mute)]">121.0 × 65.0 mm</span>
      </button>
    </div>

    <!-- Active Silhouette Canvas Box -->
    <div id="silhouette-display-box" class="p-4 rounded-xl border border-dashed border-red-500 bg-red-500/5 flex flex-col items-center justify-center min-h-[140px] text-center" style="display: none;">
      <div id="silhouette-shape" class="border-2 border-red-600 bg-red-600/20 rounded-md transition-all flex items-center justify-center">
        <span id="silhouette-shape-label" class="text-[10px] font-mono font-bold text-red-600 px-1">Objek</span>
      </div>
      <span id="silhouette-actual-size" class="text-[10px] font-mono text-[var(--color-mute)] mt-2">Ukuran skala fisik 1:1</span>
    </div>
  </div>
</div>
