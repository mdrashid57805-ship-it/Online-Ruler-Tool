---
export interface Props {
  lang?: 'id' | 'en';
}
const { lang = 'id' } = Astro.props;
---

<div
  id="calibration-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/60 backdrop-blur-md select-none transition-opacity duration-200"
  style="display: none;"
>
  <div class="bg-[var(--color-canvas)] rounded-2xl sm:rounded-3xl shadow-2xl border border-[var(--color-hairline)] w-full max-w-[560px] max-h-[92vh] flex flex-col overflow-hidden text-[var(--color-ink)]">
    
    <!-- Modal Header -->
    <div class="p-3.5 sm:p-5 border-b border-[var(--color-hairline)] flex items-center justify-between shrink-0 bg-[var(--color-canvas-soft)]">
      <div class="flex items-center gap-2">
        <span id="modal-badge-text" class="px-2 py-0.5 rounded-full text-[10px] font-bold font-mono bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">
          KALIBRASI LAYAR
        </span>
        <h2 id="modal-title-text" class="text-sm sm:text-base font-bold tracking-tight text-[var(--color-ink)]">
          Pilih Metode Kalibrasi Akurat
        </h2>
      </div>
      <button
        id="btn-close-cal-modal"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas)] transition-colors"
        title="Tutup (Esc)"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </div>

    <!-- Segmented Tab Navigation -->
    <div class="grid grid-cols-4 border-b border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-xs font-semibold shrink-0">
      <button
        data-cal-tab="auto"
        class="cal-tab-btn active py-2.5 sm:py-3 text-center transition-all flex flex-col sm:flex-row items-center justify-center gap-1 hover:text-[var(--color-ink)]"
      >
        <span class="text-sm">⚡</span>
        <span id="tab-btn-auto-text" class="text-[11px] sm:text-xs">Otomatis</span>
      </button>

      <button
        data-cal-tab="card"
        class="cal-tab-btn py-2.5 sm:py-3 text-center transition-all flex flex-col sm:flex-row items-center justify-center gap-1 hover:text-[var(--color-ink)]"
      >
        <span class="text-sm">💳</span>
        <span id="tab-btn-card-text" class="text-[11px] sm:text-xs">Kartu ATM</span>
      </button>

      <button
        data-cal-tab="diagonal"
        class="cal-tab-btn py-2.5 sm:py-3 text-center transition-all flex flex-col sm:flex-row items-center justify-center gap-1 hover:text-[var(--color-ink)]"
      >
        <span class="text-sm">📐</span>
        <span id="tab-btn-diagonal-text" class="text-[11px] sm:text-xs">Diagonal</span>
      </button>

      <button
        data-cal-tab="device"
        class="cal-tab-btn py-2.5 sm:py-3 text-center transition-all flex flex-col sm:flex-row items-center justify-center gap-1 hover:text-[var(--color-ink)]"
      >
        <span class="text-sm">📱</span>
        <span id="tab-btn-device-text" class="text-[11px] sm:text-xs">Perangkat</span>
      </button>
    </div>

    <!-- Tab Content Panels (Scrollable Area) -->
    <div class="p-3.5 sm:p-5 overflow-y-auto space-y-4 flex-1">
      
      <!-- TAB 1: AUTO-DETECT DEVICE -->
      <div id="tab-panel-auto" class="cal-panel space-y-4" style="display: block;">
        <div class="p-4 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3 text-xs">
          <div>
            <span id="auto-confidence-badge" class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 inline-block mb-1">
              Kecocokan Pabrikan Sangat Akurat (100%)
            </span>
            <h4 id="auto-device-title" class="text-sm font-bold text-[var(--color-ink)]">
              Mendeteksi spesifikasi layar Anda...
            </h4>
            <p id="auto-device-specs" class="text-[11px] text-[var(--color-mute)] font-mono mt-0.5">
              Resolusi & kerapatan piksel otomatis
            </p>
          </div>

          <div class="p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-between">
            <span id="auto-ppi-label" class="text-[var(--color-body)] font-medium">Hasil Kalibrasi Layar:</span>
            <span id="auto-ppi-val" class="font-mono text-base font-bold text-indigo-500">127.0 PPI</span>
          </div>

          <p id="auto-desc-text" class="text-[11px] text-[var(--color-mute)] leading-relaxed">
            Sistem secara otomatis membaca ukuran resolusi layar, Device Pixel Ratio (DPR), dan user agent browser Anda untuk menyesuaikan skala penggaris 1:1 tanpa perlu input manual.
          </p>
        </div>

        <button
          id="btn-apply-auto"
          class="w-full py-2.5 sm:py-3 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-semibold text-xs tracking-tight hover:opacity-90 transition-all shadow-md flex items-center justify-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z" />
          </svg>
          <span id="btn-apply-auto-text">Terapkan Kalibrasi Otomatis Ini</span>
        </button>
      </div>

      <!-- TAB 2: CREDIT CARD / KTP CALIBRATION -->
      <div id="tab-panel-card" class="cal-panel space-y-4" style="display: none;">
        <div id="card-instruction-text" class="p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs leading-relaxed text-[var(--color-ink)]">
          👉 <strong>Tempelkan kartu fisik (KTP / ATM / Debit / SIM)</strong> pada layar Anda. Sesuaikan ukuran kotak di layar menggunakan slider di bawah sampai sama persis dengan kartu fisik (Standar ISO: <strong>85.60 × 53.98 mm</strong>).
        </div>

        <!-- In-Modal True 1:1 Card Alignment Box -->
        <div class="p-3 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] flex flex-col items-center justify-center min-h-[160px] overflow-hidden">
          <div
            id="modal-card-box"
            class="rounded-xl border-2 border-dashed border-indigo-500 bg-indigo-500/10 flex flex-col items-center justify-center transition-all p-2 text-center"
            style="width: 270px; height: 170px;"
          >
            <span id="screen-card-title" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 block">
              Tempelkan Kartu Fisik Di Sini
            </span>
            <span id="screen-card-dims" class="text-[10px] text-[var(--color-mute)] font-mono block mt-0.5">
              85.60 × 53.98 mm
            </span>
          </div>
        </div>

        <!-- Interactive Slider & Nudging Controls -->
        <div class="space-y-2 p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
          <div class="flex items-center justify-between text-xs">
            <span id="card-adjust-label" class="font-semibold text-[var(--color-ink)]">Sesuaikan Ukuran Kotak:</span>
            <span id="card-ppi-display" class="font-mono font-bold text-indigo-500">127.0 PPI</span>
          </div>

          <div class="flex items-center gap-2">
            <button id="btn-card-minus" class="w-8 h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft)] active:scale-95 transition-all">-</button>
            <input
              id="card-ppi-slider"
              type="range"
              min="50"
              max="260"
              step="0.2"
              value="127"
              class="w-full cursor-pointer accent-indigo-600"
            />
            <button id="btn-card-plus" class="w-8 h-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft)] active:scale-95 transition-all">+</button>
          </div>

          <p id="card-tip-text" class="text-[11px] text-[var(--color-mute)] text-center">
            💡 Tip: Anda juga dapat menggunakan <strong class="text-[var(--color-ink)]">tombol panah keyboard (← / →)</strong> untuk akurasi sub-piksel!
          </p>
        </div>

        <button
          id="btn-apply-card-cal"
          class="w-full py-2.5 sm:py-3 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-semibold text-xs tracking-tight hover:opacity-90 transition-all shadow-md"
        >
          Simpan Kalibrasi Kartu
        </button>
      </div>

      <!-- TAB 3: SCREEN DIAGONAL (INCHES) -->
      <div id="tab-panel-diagonal" class="cal-panel space-y-4" style="display: none;">
        <div class="space-y-2">
          <label id="diag-label-text" for="diagonal-input-val" class="text-xs font-semibold text-[var(--color-ink)] block">
            Masukkan Ukuran Diagonal Layar (Inci):
          </label>
          <div class="flex gap-2">
            <input
              id="diagonal-input-val"
              type="number"
              min="4"
              max="100"
              step="0.1"
              value="14.0"
              placeholder="e.g. 14.0, 15.6, 24, 27"
              class="flex-1 px-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-mono text-[var(--color-ink)] focus:outline-none focus:border-indigo-500 transition-colors"
            />
            <button
              id="btn-apply-diagonal"
              class="px-4 py-2 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] text-xs font-semibold hover:opacity-90 transition-opacity shrink-0"
            >
              Hitung & Terapkan
            </button>
          </div>
          <p id="diag-desc-text" class="text-[11px] text-[var(--color-mute)] leading-relaxed">
            Lihat ukuran layar pada dus laptop, spesifikasi teknis monitor, atau buku panduan perangkat Anda.
          </p>
        </div>

        <!-- Diagonal Presets Chips -->
        <div class="space-y-1">
          <span id="diag-presets-label" class="text-[11px] font-semibold text-[var(--color-body)] block mb-1.5">Pilihan Ukuran Populer:</span>
          <div class="flex flex-wrap gap-1.5">
            <button data-diag="6.1" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">6.1″ (HP)</button>
            <button data-diag="6.7" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">6.7″ (HP Max)</button>
            <button data-diag="11.0" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">11.0″ (Tablet)</button>
            <button data-diag="13.3" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">13.3″</button>
            <button data-diag="14.0" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">14.0″</button>
            <button data-diag="15.6" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">15.6″</button>
            <button data-diag="24.0" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">24.0″</button>
            <button data-diag="27.0" class="diag-chip px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-body)] hover:bg-[var(--color-canvas-soft)] hover:text-[var(--color-ink)] transition-colors">27.0″</button>
          </div>
        </div>

        <!-- Live Math Formula Card -->
        <div class="p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs space-y-1.5">
          <div class="flex justify-between text-[var(--color-body)]">
            <span id="diag-formula-label">Rumus Geometris:</span>
            <span class="font-mono">PPI = √(W² + H²) / (Diagonal × DPR)</span>
          </div>
          <div class="flex justify-between font-semibold text-[var(--color-ink)]">
            <span id="diag-result-label">Estimasi Nilai PPI:</span>
            <span id="diagonal-calc-result" class="font-mono text-indigo-500">127.0 PPI</span>
          </div>
        </div>
      </div>

      <!-- TAB 4: DEVICE CATALOG SEARCH -->
      <div id="tab-panel-device" class="cal-panel space-y-3" style="display: none;">
        <!-- Search input -->
        <div class="relative">
          <svg class="absolute left-3 top-3 text-[var(--color-mute)]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="device-search-input"
            type="text"
            placeholder="Cari MacBook, iPhone, Galaxy, ThinkPad, Monitor..."
            class="w-full pl-9 pr-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs text-[var(--color-ink)] focus:outline-none focus:border-indigo-500 transition-colors"
          />
        </div>

        <!-- Category Pills -->
        <div class="flex gap-1 overflow-x-auto pb-1 text-[11px] no-scrollbar">
          <button data-cat="all" class="cat-pill active px-2.5 py-1 rounded-full border border-[var(--color-hairline)] bg-indigo-500 text-white font-medium shrink-0">Semua</button>
          <button data-cat="android" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">Android</button>
          <button data-cat="iphone" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">iPhone</button>
          <button data-cat="ipad" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">iPad</button>
          <button data-cat="macbook" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">MacBook</button>
          <button data-cat="laptop" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">Laptop</button>
          <button data-cat="monitor" class="cat-pill px-2.5 py-1 rounded-full border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shrink-0">Monitor</button>
        </div>

        <!-- Device List -->
        <div id="device-catalog-list" class="max-h-[260px] overflow-y-auto space-y-1.5 pr-1"></div>
      </div>

    </div>

    <!-- Modal Footer / Reset -->
    <div class="px-4 sm:px-5 py-3 border-t border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] flex items-center justify-between text-xs shrink-0">
      <button id="btn-reset-cal" class="text-[var(--color-mute)] hover:text-red-500 transition-colors font-medium">
        Reset Standar (96 PPI)
      </button>
      <span id="modal-active-ppi-badge" class="font-mono text-indigo-500 font-bold">
        Aktif: 127 PPI
      </span>
    </div>
  </div>
</div>

<style>
  .cal-tab-btn.active {
    background-color: var(--color-canvas);
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
  }
  .cat-pill.active {
    background-color: var(--color-primary) !important;
    color: var(--color-on-primary) !important;
    border-color: var(--color-primary) !important;
  }
</style>
