---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}
const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
---

<div
  id="howto-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-md select-none transition-opacity duration-200"
  style="display: none;"
>
  <div
    class="bg-[var(--color-canvas)] rounded-2xl shadow-2xl border border-[var(--color-hairline)] w-full max-w-[480px] max-h-[88vh] flex flex-col overflow-hidden text-[var(--color-ink)]"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 pt-5 pb-4 border-b border-[var(--color-hairline)] shrink-0">
      <div>
        <span id="howto-badge-text" class="text-[10px] font-bold text-[var(--color-primary)] uppercase tracking-widest font-mono block">{t.howTo.badge}</span>
        <h2 id="howto-title-text" class="text-base sm:text-lg font-bold tracking-tight">{t.howTo.title}</h2>
      </div>

      <button
        id="btn-close-howto-modal"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] transition-colors cursor-pointer"
        title={`${t.common.close} (Esc)`}
      >
        <svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="p-5 overflow-y-auto space-y-5 text-xs text-[var(--color-body)] leading-relaxed">
      
      <!-- Step 1 -->
      <div class="flex gap-3">
        <div class="w-6 h-6 rounded-full bg-[var(--color-primary-subdued)] text-[var(--color-primary)] font-bold flex items-center justify-center shrink-0 font-mono text-[11px]">
          1
        </div>
        <div class="space-y-1">
          <h4 id="howto-step1-title" class="font-bold text-[var(--color-ink)] text-sm">{t.howTo.step1Title}</h4>
          <p id="howto-step1-desc">
            {t.howTo.step1Desc}
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-3">
        <div class="w-6 h-6 rounded-full bg-[var(--color-primary-subdued)] text-[var(--color-primary)] font-bold flex items-center justify-center shrink-0 font-mono text-[11px]">
          2
        </div>
        <div class="space-y-1">
          <h4 id="howto-step2-title" class="font-bold text-[var(--color-ink)] text-sm">{t.howTo.step2Title}</h4>
          <p id="howto-step2-desc">
            {t.howTo.step2Desc}
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex gap-3">
        <div class="w-6 h-6 rounded-full bg-[var(--color-primary-subdued)] text-[var(--color-primary)] font-bold flex items-center justify-center shrink-0 font-mono text-[11px]">
          3
        </div>
        <div class="space-y-1">
          <h4 id="howto-step3-title" class="font-bold text-[var(--color-ink)] text-sm">{t.howTo.step3Title}</h4>
          <p id="howto-step3-desc">
            {t.howTo.step3Desc}
          </p>
        </div>
      </div>

      <!-- Keyboard Shortcuts Cheatsheet -->
      <div class="pt-4 border-t border-[var(--color-hairline)] space-y-2.5">
        <h4 id="howto-shortcuts-title" class="font-bold text-[var(--color-ink)] text-xs flex items-center gap-2 font-mono uppercase tracking-wider">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-primary)]"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="6" y1="8" x2="6.01" y2="8"/><line x1="10" y1="8" x2="10.01" y2="8"/><line x1="14" y1="8" x2="14.01" y2="8"/><line x1="18" y1="8" x2="18.01" y2="8"/><line x1="8" y1="16" x2="16" y2="16"/></svg>
          <span>{t.howTo.shortcutsTitle}</span>
        </h4>

        <div class="grid grid-cols-1 gap-1.5 font-mono text-[11px]">
          <div class="flex items-center justify-between py-1 border-b border-[var(--color-hairline)]">
            <span id="sc-label-guides" class="font-sans text-[var(--color-body)]">{t.tools.guides}</span>
            <kbd class="px-2 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">G</kbd>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-[var(--color-hairline)]">
            <span id="sc-label-crosshair" class="font-sans text-[var(--color-body)]">{t.tools.marker}</span>
            <kbd class="px-2 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">P</kbd>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-[var(--color-hairline)]">
            <span id="sc-label-grid" class="font-sans text-[var(--color-body)]">{t.tools.grid}</span>
            <kbd class="px-2 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">M</kbd>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-[var(--color-hairline)]">
            <span id="sc-label-caliper" class="font-sans text-[var(--color-body)]">{t.tools.caliper}</span>
            <kbd class="px-2 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">K</kbd>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-[var(--color-hairline)]">
            <span id="sc-label-theme" class="font-sans text-[var(--color-body)]">{t.tools.theme}</span>
            <kbd class="px-2 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">D</kbd>
          </div>
          <div class="flex items-center justify-between py-1">
            <span id="sc-label-units" class="font-sans text-[var(--color-body)]">{t.howTo.shortcutUnits}</span>
            <div class="flex gap-1">
              <kbd class="px-1.5 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">1</kbd>
              <kbd class="px-1.5 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">2</kbd>
              <kbd class="px-1.5 py-0.5 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-bold text-[var(--color-ink)]">3</kbd>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="px-5 py-3 border-t border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] shrink-0">
      <button
        id="btn-close-howto-bottom"
        class="w-full py-2 rounded-lg bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold text-xs transition-all shadow-xs cursor-pointer"
      >
        {t.howTo.gotIt}
      </button>
    </div>
  </div>
</div>
