---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={`${t.calGuide.title} — ${t.siteName}`}
  description={t.calGuide.lead}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-3xl mx-auto text-[var(--color-ink)] space-y-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-mute)]" aria-label="Breadcrumb">
      <a href={translatePath('/')} class="hover:text-[var(--color-ink)] transition-colors">
        {t.footer.home}
      </a>
      <span>/</span>
      <span class="text-[var(--color-primary)] font-medium">{t.calGuide.title}</span>
    </nav>

    <!-- Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 text-xs font-bold font-mono border border-red-500/20">
        {t.calGuide.badge}
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        {t.calGuide.title}
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-body)] leading-relaxed">
        {t.calGuide.lead}
      </p>
    </div>

    <!-- 3 Concise Calibration Methods -->
    <article class="space-y-4 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
      <!-- Method 1 -->
      <section class="p-5 sm:p-6 rounded-xl bg-[var(--color-canvas-card)] border border-[var(--color-hairline)] space-y-3 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-[var(--color-primary-subdued)] text-[var(--color-primary)]">
            {t.calGuide.m1Badge}
          </span>
          <h2 class="text-sm sm:text-base font-bold text-[var(--color-ink)]">
            {t.calGuide.m1Title}
          </h2>
        </div>
        <p>{t.calGuide.m1Desc}</p>
        <div class="p-3 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs text-[var(--color-ink)] font-medium">
          {t.calGuide.m1Step}
        </div>
      </section>

      <!-- Method 2 -->
      <section class="p-5 sm:p-6 rounded-xl bg-[var(--color-canvas-card)] border border-[var(--color-hairline)] space-y-3 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-[var(--color-primary-subdued)] text-[var(--color-primary)]">
            {t.calGuide.m2Badge}
          </span>
          <h2 class="text-sm sm:text-base font-bold text-[var(--color-ink)]">
            {t.calGuide.m2Title}
          </h2>
        </div>
        <p>{t.calGuide.m2Desc}</p>
        <div class="p-3 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs text-[var(--color-ink)] font-medium">
          {t.calGuide.m2Step}
        </div>
      </section>

      <!-- Method 3 -->
      <section class="p-5 sm:p-6 rounded-xl bg-[var(--color-canvas-card)] border border-[var(--color-hairline)] space-y-3 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-red-500/10 text-red-600 dark:text-red-400">
            {t.calGuide.m3Badge}
          </span>
          <h2 class="text-sm sm:text-base font-bold text-[var(--color-ink)]">
            {t.calGuide.m3Title}
          </h2>
        </div>
        <p>{t.calGuide.m3Desc}</p>
        <div class="p-3 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs text-[var(--color-ink)] font-medium">
          {t.calGuide.m3Step}
        </div>
      </section>
    </article>

    <!-- Back Action -->
    <div class="pt-2">
      <a
        href={translatePath('/')}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--color-primary)] text-white text-xs font-semibold hover:bg-[var(--color-primary-hover)] transition-all shadow-xs"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>{t.calGuide.back}</span>
      </a>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
