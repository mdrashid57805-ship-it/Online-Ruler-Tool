---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="500 — Terjadi Kesalahan Server | Online Penggaris"
  description="Terjadi kendala teknis internal pada server. Silakan coba muat ulang halaman."
  lang="id"
>
  <Navbar lang="id" />

  <main class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-20">
    <div class="max-w-md w-full text-center space-y-6">
      
      <!-- Icon Graphic for 500 with Red Accents -->
      <div class="w-16 h-16 rounded-2xl bg-red-500/10 text-red-600 border border-red-500/20 flex items-center justify-center mx-auto shadow-sm">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>

      <!-- Text Header -->
      <div class="space-y-2">
        <span class="inline-block px-3 py-0.5 rounded-full bg-red-500/10 text-red-600 text-xs font-mono font-bold border border-red-500/20">
          ERROR 500
        </span>
        <h1 id="err5-h1" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-ink)]">
          Terjadi Kesalahan Teknis
        </h1>
        <p id="err5-desc" class="text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
          Maaf, terjadi kendala saat memproses permintaan Anda. Sistem kami telah mencatat masalah ini secara otomatis.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          id="btn-err5-reload"
          onclick="window.location.reload();"
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          <span id="btn-err5-reload-text">Muat Ulang Halaman</span>
        </button>

        <a
          id="btn-err5-home"
          href="/"
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-[var(--color-ink)] font-semibold text-xs hover:border-red-500 transition-colors"
        >
          Kembali ke Beranda
        </a>
      </div>

      <!-- Quick Helpful Links -->
      <div class="pt-6 border-t border-[var(--color-hairline)]">
        <span id="err5-nav-label" class="text-[11px] text-[var(--color-mute)] block mb-2 font-medium">Bantuan & Kontak:</span>
        <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
          <a id="err5-link-contact" href="/contact" class="text-red-600 hover:underline">Laporkan Masalah</a>
          <span class="text-[var(--color-hairline-strong)]">•</span>
          <a id="err5-link-cal" href="/cara-kalibrasi" class="text-red-600 hover:underline">Panduan Kalibrasi</a>
        </div>
      </div>

    </div>
  </main>

  <Footer lang="id" />

  <!-- Subpage Language Synchronization Script -->
  <script is:inline>
    (function () {
      const DICT = {
        id: {
          h1: 'Terjadi Kesalahan Teknis',
          desc: 'Maaf, terjadi kendala saat memproses permintaan Anda. Sistem kami telah mencatat masalah ini secara otomatis.',
          reload: 'Muat Ulang Halaman',
          home: 'Kembali ke Beranda',
          navLabel: 'Bantuan & Kontak:',
          linkContact: 'Laporkan Masalah',
          linkCal: 'Panduan Kalibrasi',
          btnLabel: 'EN'
        },
        en: {
          h1: 'Internal Server Error',
          desc: 'Sorry, a technical issue occurred while processing your request. Our systems have logged this incident.',
          reload: 'Reload Page',
          home: 'Return to Home',
          navLabel: 'Support & Help:',
          linkContact: 'Report Issue',
          linkCal: 'Calibration Guide',
          btnLabel: 'ID'
        }
      };

      function updatePage(lang) {
        const d = DICT[lang] || DICT.id;
        const h1 = document.getElementById('err5-h1');
        if (h1) h1.textContent = d.h1;
        const desc = document.getElementById('err5-desc');
        if (desc) desc.textContent = d.desc;
        const rText = document.getElementById('btn-err5-reload-text');
        if (rText) rText.textContent = d.reload;
        const hLink = document.getElementById('btn-err5-home');
        if (hLink) hLink.textContent = d.home;
        const navL = document.getElementById('err5-nav-label');
        if (navL) navL.textContent = d.navLabel;
        const lContact = document.getElementById('err5-link-contact');
        if (lContact) lContact.textContent = d.linkContact;
        const lCal = document.getElementById('err5-link-cal');
        if (lCal) lCal.textContent = d.linkCal;

        const langBtnLabel = document.getElementById('lang-btn-label');
        if (langBtnLabel) langBtnLabel.textContent = d.btnLabel;
      }

      let currentLang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
      updatePage(currentLang);

      const btnLang = document.getElementById('btn-lang-toggle');
      if (btnLang) {
        btnLang.addEventListener('click', function () {
          currentLang = currentLang === 'id' ? 'en' : 'id';
          localStorage.setItem('onlinepenggaris_lang_v1', currentLang);
          updatePage(currentLang);
        });
      }
    })();
  </script>
</BaseLayout>
