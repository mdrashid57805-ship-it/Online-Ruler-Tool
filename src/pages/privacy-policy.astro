---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Kebijakan Privasi — Online Penggaris | Privasi Aman & Tanpa Pelacakan"
  description="Kebijakan Privasi resmi OnlinePenggaris.com: Komitmen kami untuk melindungi privasi Anda. Pengukuran diproses lokal di browser tanpa penyimpanan data pribadi."
  lang="id"
>
  <Navbar lang="id" />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-4xl mx-auto text-[var(--color-ink)] space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-mute)]" aria-label="Breadcrumb">
      <a id="priv-bread-home" href="/" class="hover:text-[var(--color-ink)] transition-colors">Beranda</a>
      <span>/</span>
      <span id="priv-bread-curr" class="text-red-600 font-medium">Kebijakan Privasi</span>
    </nav>

    <!-- Header -->
    <div class="space-y-3">
      <div id="priv-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
        PRIVASI PENGGUNA
      </div>
      <h1 id="priv-h1" class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Kebijakan Privasi (Privacy Policy)
      </h1>
      <p id="priv-date" class="text-xs text-[var(--color-mute)] font-mono">
        Terakhir Diperbarui: {new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </div>

    <!-- Main Content -->
    <article class="space-y-6 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
      
      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="priv-sec1-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          1. Komitmen Perlindungan Privasi
        </h2>
        <p id="priv-sec1-p">
          Di <strong>Online Penggaris</strong> (<em>onlinepenggaris.com</em>), kami sangat menghargai dan menjunjung tinggi privasi setiap pengunjung. Kebijakan ini menjelaskan bagaimana data teknis dasar ditangani saat Anda menggunakan layanan penggaris digital kami.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="priv-sec2-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          2. Data Penyimpanan Lokal (Local Storage)
        </h2>
        <p id="priv-sec2-p">
          Layanan kami menggunakan fitur <strong>Web Storage (localStorage)</strong> yang berada di peramban (browser) perangkat Anda sendiri. Data yang disimpan mencakup:
        </p>
        <ul id="priv-sec2-list" class="list-disc pl-5 space-y-1.5 text-xs">
          <li><strong>Preferensi Tema:</strong> Mode Terang (Light Mode) atau Mode Gelap (Dark Mode).</li>
          <li><strong>Satuan Pengukuran:</strong> Satuan yang terakhir Anda pilih (cm, mm, in).</li>
          <li><strong>Nilai Kalibrasi Layar (PPI):</strong> Nilai PPI terkalibrasi agar Anda tidak perlu mengulang proses kalibrasi.</li>
          <li><strong>Preferensi Bahasa:</strong> Pilihan tampilan Bahasa Indonesia (ID) atau English (EN).</li>
        </ul>
        <p id="priv-sec2-note" class="text-xs text-red-600 font-semibold">
          💡 Catatan Penting: Data tersebut tersimpan 100% secara lokal pada memori peramban gawai Anda dan tidak pernah dikirimkan ke server kami.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="priv-sec3-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          3. Tidak Ada Rekaman Kamera atau Data Fisik
        </h2>
        <p id="priv-sec3-p">
          Fitur kalibrasi menggunakan kartu ATM/KTP atau perbandingan siluet objek dilakukan murni secara visual pada kanvas layar kaca. Kami tidak meminta akses kamera, tidak memindai kartu Anda, dan tidak menyimpan informasi nomor maupun foto apapun.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="priv-sec4-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          4. Cookies & Log Statistik Web Standar
        </h2>
        <p id="priv-sec4-p">
          Seperti situs web pada umumnya, server kami dapat mencatat log lalu lintas standar (seperti jenis peramban, resolusi viewport, waktu kunjungan, dan halaman rujukan) untuk pemeliharaan performa dan keamanan server dari serangan siber.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="priv-sec5-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          5. Hubungi Kami
        </h2>
        <p id="priv-sec5-p">
          Jika Anda memiliki pertanyaan mengenai kebijakan privasi ini, silakan hubungi tim kami melalui email: <a href="mailto:support@onlinepenggaris.com" class="text-red-600 font-mono font-semibold hover:underline">support@onlinepenggaris.com</a>.
        </p>
      </section>

    </article>

    <!-- Return to Tool CTA -->
    <div class="pt-4 text-center">
      <a id="btn-priv-back" href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-md transition-all">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Kembali ke Alat Penggaris Online</span>
      </a>
    </div>
  </main>

  <Footer lang="id" />

  <!-- Subpage Language Synchronization Script -->
  <script is:inline>
    (function () {
      const DICT = {
        id: {
          breadHome: 'Beranda',
          breadCurr: 'Kebijakan Privasi',
          badge: 'PRIVASI PENGGUNA',
          h1: 'Kebijakan Privasi (Privacy Policy)',
          date: 'Terakhir Diperbarui: September 2026',
          s1T: '1. Komitmen Perlindungan Privasi',
          s1P: 'Di Online Penggaris (onlinepenggaris.com), kami sangat menghargai dan menjunjung tinggi privasi setiap pengunjung. Kebijakan ini menjelaskan bagaimana data teknis dasar ditangani saat Anda menggunakan layanan penggaris digital kami.',
          s2T: '2. Data Penyimpanan Lokal (Local Storage)',
          s2P: 'Layanan kami menggunakan fitur Web Storage (localStorage) yang berada di peramban (browser) perangkat Anda sendiri. Data yang disimpan mencakup:',
          s2Note: '💡 Catatan Penting: Data tersebut tersimpan 100% secara lokal pada memori peramban gawai Anda dan tidak pernah dikirimkan ke server kami.',
          s3T: '3. Tidak Ada Rekaman Kamera atau Data Fisik',
          s3P: 'Fitur kalibrasi menggunakan kartu ATM/KTP atau perbandingan siluet objek dilakukan murni secara visual pada kanvas layar kaca. Kami tidak meminta akses kamera, tidak memindai kartu Anda, dan tidak menyimpan informasi nomor maupun foto apapun.',
          s4T: '4. Cookies & Log Statistik Web Standar',
          s4P: 'Seperti situs web pada umumnya, server kami dapat mencatat log lalu lintas standar (seperti jenis peramban, resolusi viewport, waktu kunjungan, dan halaman rujukan) untuk pemeliharaan performa dan keamanan server dari serangan siber.',
          s5T: '5. Hubungi Kami',
          s5P: 'Jika Anda memiliki pertanyaan mengenai kebijakan privasi ini, silakan hubungi tim kami melalui email: support@onlinepenggaris.com.',
          backCta: 'Kembali ke Alat Penggaris Online',
          btnLabel: 'EN'
        },
        en: {
          breadHome: 'Home',
          breadCurr: 'Privacy Policy',
          badge: 'USER PRIVACY',
          h1: 'Privacy Policy',
          date: 'Last Updated: September 2026',
          s1T: '1. Privacy Protection Commitment',
          s1P: 'At Online Penggaris (onlinepenggaris.com), we strongly respect and protect your privacy. This policy explains how technical preferences are handled when you utilize our online digital ruler tool.',
          s2T: '2. Local Browser Storage (localStorage)',
          s2P: 'Our application relies entirely on client-side Web Storage (localStorage) within your web browser. Stored values include:',
          s2Note: '💡 Important Note: All configuration settings are stored 100% locally on your device browser memory and are never transmitted to our servers.',
          s3T: '3. Zero Camera Capture & Zero Physical Card Scanning',
          s3P: 'Calibration using an ATM/ID card or silhouette comparison is purely an on-screen visual alignment. We never request camera access, scan card chips, or capture any photos/numbers.',
          s4T: '4. Standard Web Server Traffic Logs',
          s4P: 'Like most websites, our host may log anonymous network traffic (e.g. browser user-agent, viewport size, and referral headers) strictly for infrastructure security and performance uptime.',
          s5T: '5. Contact Us',
          s5P: 'If you have any questions or feedback regarding this privacy policy, contact our support team at: support@onlinepenggaris.com.',
          backCta: 'Return to Online Ruler Tool',
          btnLabel: 'ID'
        }
      };

      function updatePage(lang) {
        const d = DICT[lang] || DICT.id;
        const bH = document.getElementById('priv-bread-home');
        if (bH) bH.textContent = d.breadHome;
        const bC = document.getElementById('priv-bread-curr');
        if (bC) bC.textContent = d.breadCurr;
        const badge = document.getElementById('priv-badge');
        if (badge) badge.textContent = d.badge;
        const h1 = document.getElementById('priv-h1');
        if (h1) h1.textContent = d.h1;
        const date = document.getElementById('priv-date');
        if (date) date.textContent = d.date;

        const s1T = document.getElementById('priv-sec1-title');
        if (s1T) s1T.textContent = d.s1T;
        const s1P = document.getElementById('priv-sec1-p');
        if (s1P) s1P.textContent = d.s1P;

        const s2T = document.getElementById('priv-sec2-title');
        if (s2T) s2T.textContent = d.s2T;
        const s2P = document.getElementById('priv-sec2-p');
        if (s2P) s2P.textContent = d.s2P;
        const s2N = document.getElementById('priv-sec2-note');
        if (s2N) s2N.textContent = d.s2Note;

        const s3T = document.getElementById('priv-sec3-title');
        if (s3T) s3T.textContent = d.s3T;
        const s3P = document.getElementById('priv-sec3-p');
        if (s3P) s3P.textContent = d.s3P;

        const s4T = document.getElementById('priv-sec4-title');
        if (s4T) s4T.textContent = d.s4T;
        const s4P = document.getElementById('priv-sec4-p');
        if (s4P) s4P.textContent = d.s4P;

        const s5T = document.getElementById('priv-sec5-title');
        if (s5T) s5T.textContent = d.s5T;
        const s5P = document.getElementById('priv-sec5-p');
        if (s5P) s5P.innerHTML = lang === 'en'
          ? 'If you have any questions regarding this privacy policy, contact our team at: <a href="mailto:support@onlinepenggaris.com" class="text-red-600 font-mono font-semibold hover:underline">support@onlinepenggaris.com</a>.'
          : 'Jika Anda memiliki pertanyaan mengenai kebijakan privasi ini, silakan hubungi tim kami melalui email: <a href="mailto:support@onlinepenggaris.com" class="text-red-600 font-mono font-semibold hover:underline">support@onlinepenggaris.com</a>.';

        const btnCta = document.getElementById('btn-priv-back');
        if (btnCta) {
          const span = btnCta.querySelector('span');
          if (span) span.textContent = d.backCta;
        }

        const langBtnLabel = document.getElementById('lang-btn-label');
        if (langBtnLabel) langBtnLabel.textContent = d.btnLabel;
      }

      let currentLang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
      updatePage(currentLang);

      const btnLang = document.getElementById('btn-lang-toggle');
      if (btnLang) {
        btnLang.addEventListener('click', function () {
          currentLang = currentLang === 'id' ? 'en' : 'id';
          localStorage.setItem('onlinepenggaris_lang_v1', currentLang);
          updatePage(currentLang);
        });
      }
    })();
  </script>
</BaseLayout>
