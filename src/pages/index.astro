  // --- RULER RENDERING ENGINE ---
  function renderAllRulers() {
    const isDark = document.documentElement.classList.contains('dark');

    const topCanvas = document.getElementById('ruler-canvas-top') as HTMLCanvasElement;
    const bottomCanvas = document.getElementById('ruler-canvas-bottom') as HTMLCanvasElement;
    const leftCanvas = document.getElementById('ruler-canvas-left') as HTMLCanvasElement;
    const rightCanvas = document.getElementById('ruler-canvas-right') as HTMLCanvasElement;
    const gridCanvas = document.getElementById('grid-canvas') as HTMLCanvasElement;

    if (topCanvas && activeEdges.top) {
      topCanvas.style.display = 'block';
      renderRulerEdge({ canvas: topCanvas, edge: 'top', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (topCanvas) {
      topCanvas.style.display = 'none';
    }

    if (bottomCanvas && activeEdges.bottom) {
      bottomCanvas.style.display = 'block';
      renderRulerEdge({ canvas: bottomCanvas, edge: 'bottom', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (bottomCanvas) {
      bottomCanvas.style.display = 'none';
    }

    if (leftCanvas && activeEdges.left) {
      leftCanvas.style.display = 'block';
      renderRulerEdge({ canvas: leftCanvas, edge: 'left', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (leftCanvas) {
      leftCanvas.style.display = 'none';
    }

    if (rightCanvas && activeEdges.right) {
      rightCanvas.style.display = 'block';
      renderRulerEdge({ canvas: rightCanvas, edge: 'right', unit: activeUnit, ppi: calState.ppi, isDark });
    } else if (rightCanvas) {
      rightCanvas.style.display = 'none';
    }

    if (gridCanvas && showGrid) {
      gridCanvas.style.display = 'block';
      renderGridOverlay(gridCanvas, activeUnit, calState.ppi, isDark);
    } else if (gridCanvas) {
      gridCanvas.style.display = 'none';
    }

    updateEdgeButtonStyles();
    updateUnitButtonStyles();
    updateCaliper();
    updateCardSimulator();
  }

