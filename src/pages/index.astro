---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import RulerCanvas from '../components/RulerCanvas.astro';
import CalibrationModal from '../components/CalibrationModal.astro';
import CaliperHud from '../components/CaliperHud.astro';
import ReferenceOverlays from '../components/ReferenceOverlays.astro';
import HowToModal from '../components/HowToModal.astro';
import WelcomeBanner from '../components/WelcomeBanner.astro';
import ContentSection from '../components/ContentSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Online Penggaris — Penggaris Online Akurat Seukuran Asli (cm, mm, inci)"
  description="Penggaris online gratis akurat seukuran asli dalam cm, mm, dan inci. Kalibrasi layar otomatis, diagonal layar, atau kartu ATM/KTP untuk pengukuran presisi tanpa download aplikasi."
  lang="id"
>
  <!-- Fixed Top Navbar & Mobile Bottom Dock -->
  <Navbar lang="id" />

  <!-- Main Document Flow (Navbar offset at pt-[52px]) -->
  <main id="app-main" class="relative w-full overflow-x-hidden pt-[52px]">
    
    <!-- Ruler Measuring Workspace: Full-screen height hero area -->
    <div id="ruler-workspace" class="relative w-full h-[calc(100vh-52px)] min-h-[500px] overflow-hidden bg-[var(--color-canvas-soft)]">
      <!-- Ruler Canvas & Guides Overlay -->
      <RulerCanvas lang="id" />

      <!-- Welcome State / Quick Edge Launcher -->
      <WelcomeBanner lang="id" />
    </div>

    <!-- Two-Point Caliper Readout HUD (Fixed bottom pill) -->
    <CaliperHud lang="id" />

    <!-- Object Silhouettes Scale Comparison Modal -->
    <ReferenceOverlays lang="id" />

    <!-- Calibration Modal (3 Methods) -->
    <CalibrationModal lang="id" />

    <!-- Help & Shortcuts Modal -->
    <HowToModal lang="id" />

    <!-- Rich SEO Article, PPI Matrix & FAQ Section (Flows smoothly below ruler workspace) -->
    <ContentSection lang="id" />
  </main>

  <!-- Site Footer -->
  <Footer lang="id" />
</BaseLayout>

<script>
  import {
    getSavedCalibration,
    saveCalibration,
    calculatePpiFromDiagonal,
    formatMeasurement,
    type MeasurementUnit,
    type CalibrationState,
    STORAGE_KEY_UNIT,
    STORAGE_KEY_THEME,
    STORAGE_KEY_LANG,
  } from '../lib/calibration';
  import { detectCurrentDevice, DEVICE_DATABASE } from '../lib/devices';
  import { renderRulerEdge, renderGridOverlay } from '../lib/rulerRenderer';
  import { TRANSLATIONS, type Language } from '../lib/i18n';

  // --- APPLICATION STATE ---
  let activeUnit: MeasurementUnit = 'cm';
  let activeEdges: { top: boolean; bottom: boolean; left: boolean; right: boolean } = {
    top: true,
    bottom: false,
    left: false,
    right: false,
  };
  let calState: CalibrationState = getSavedCalibration();
  let currentLang: Language = 'id'; // Strictly default to Indonesian!
  let showGuides = false;
  let showCrosshair = false;
  let showGrid = false;
  let showCaliper = false;
  let caliperPoints = { p1: { x: 80, y: 140 }, p2: { x: 300, y: 140 } };
  let isDraggingCaliper: 'p1' | 'p2' | null = null;
  let guideLines: { id: string; type: 'h' | 'v'; pos: number }[] = [];

  // --- INITIALIZATION ---
  function initApp() {
    loadSavedSettings();
    bindEvents();
    applyLanguage(currentLang);
    renderAllRulers();
    updateCalibrationUI();
    renderDeviceCatalog();
    checkAutoDetection();
  }

  function loadSavedSettings() {
    try {
      const savedUnit = localStorage.getItem(STORAGE_KEY_UNIT) as MeasurementUnit;
      if (savedUnit && ['cm', 'mm', 'in', 'px', 'pt'].includes(savedUnit)) {
        activeUnit = savedUnit;
      }
      const savedLang = localStorage.getItem(STORAGE_KEY_LANG) as Language;
      if (savedLang === 'en') {
        currentLang = 'en';
      } else {
        currentLang = 'id'; // Default strictly Indonesian!
      }
    } catch (e) {
      currentLang = 'id';
    }
  }

  // --- DYNAMIC I18N BILINGUAL SWITCHER ---
  function applyLanguage(lang: Language) {
    currentLang = lang;
    document.documentElement.lang = lang;
    const t = TRANSLATIONS[lang] || TRANSLATIONS.id;

    try {
      // 1. Navbar
      const langLabel = document.getElementById('lang-btn-label');
      if (langLabel) langLabel.textContent = lang === 'id' ? 'EN' : 'ID';

      const navLogo = document.getElementById('nav-logo-text');
      if (navLogo) navLogo.textContent = t.siteName;

      const topText = document.getElementById('nav-edge-top-text');
      if (topText) topText.textContent = lang === 'id' ? 'Atas' : 'Top';
      const btmText = document.getElementById('nav-edge-bottom-text');
      if (btmText) btmText.textContent = lang === 'id' ? 'Bawah' : 'Bottom';
      const leftText = document.getElementById('nav-edge-left-text');
      if (leftText) leftText.textContent = lang === 'id' ? 'Kiri' : 'Left';
      const rightText = document.getElementById('nav-edge-right-text');
      if (rightText) rightText.textContent = lang === 'id' ? 'Kanan' : 'Right';
      const frameText = document.getElementById('nav-edge-frame-text');
      if (frameText) frameText.textContent = lang === 'id' ? '4 Sisi' : '4-Way';
      const navCal = document.getElementById('nav-cal-text');
      if (navCal) navCal.textContent = lang === 'id' ? 'Kalibrasi' : 'Calibrate';

      // 2. Welcome Banner
      const wTitle = document.getElementById('welcome-title');
      if (wTitle) wTitle.textContent = t.welcome.title;
      const wSub = document.getElementById('welcome-subtitle');
      if (wSub) wSub.textContent = t.welcome.subtitle;
      const wTop = document.getElementById('welcome-quick-top-label');
      if (wTop) wTop.textContent = t.welcome.top;
      const wBtm = document.getElementById('welcome-quick-bottom-label');
      if (wBtm) wBtm.textContent = t.welcome.bottom;
      const wLeft = document.getElementById('welcome-quick-left-label');
      if (wLeft) wLeft.textContent = t.welcome.left;
      const wRight = document.getElementById('welcome-quick-right-label');
      if (wRight) wRight.textContent = t.welcome.right;
      const wChange = document.getElementById('welcome-change-device');
      if (wChange) wChange.textContent = t.welcome.calWrongDevice;
      const wHide = document.getElementById('btn-hide-welcome');
      if (wHide) wHide.textContent = t.welcome.hideInfo;

      // 3. Calibration Modal
      const mBadge = document.getElementById('modal-badge-text');
      if (mBadge) mBadge.textContent = t.calModal.badge;
      const mTitle = document.getElementById('modal-title-text');
      if (mTitle) mTitle.textContent = t.calModal.title;
      const tabAuto = document.getElementById('tab-btn-auto-text');
      if (tabAuto) tabAuto.textContent = t.calModal.tabAuto;
      const tabDiag = document.getElementById('tab-btn-diagonal-text');
      if (tabDiag) tabDiag.textContent = t.calModal.tabDiagonal;
      const tabCard = document.getElementById('tab-btn-card-text');
      if (tabCard) tabCard.textContent = t.calModal.tabCard;
      const tabDev = document.getElementById('tab-btn-device-text');
      if (tabDev) tabDev.textContent = t.calModal.tabDevice;

      const autoPpiLabel = document.getElementById('auto-ppi-label');
      if (autoPpiLabel) autoPpiLabel.textContent = lang === 'id' ? 'Hasil Kalibrasi Layar:' : 'Calibrated Screen PPI:';
      const autoDesc = document.getElementById('auto-desc-text');
      if (autoDesc) autoDesc.textContent = t.calModal.autoDesc;
      const btnApplyAuto = document.getElementById('btn-apply-auto-text');
      if (btnApplyAuto) btnApplyAuto.textContent = t.calModal.applyAuto;

      const diagLabel = document.getElementById('diag-label-text');
      if (diagLabel) diagLabel.textContent = t.calModal.diagonalLabel;
      const diagDesc = document.getElementById('diag-desc-text');
      if (diagDesc) diagDesc.textContent = t.calModal.diagonalDesc;
      const btnApplyDiag = document.getElementById('btn-apply-diagonal');
      if (btnApplyDiag) btnApplyDiag.textContent = t.calModal.diagonalApply;
      const diagPresets = document.getElementById('diag-presets-label');
      if (diagPresets) diagPresets.textContent = t.calModal.diagonalPresets;
      const diagFormula = document.getElementById('diag-formula-label');
      if (diagFormula) diagFormula.textContent = lang === 'id' ? 'Rumus Geometris:' : 'Geometric Formula:';
      const diagResLabel = document.getElementById('diag-result-label');
      if (diagResLabel) diagResLabel.textContent = lang === 'id' ? 'Estimasi Nilai PPI:' : 'Estimated PPI Value:';

      const cardInstr = document.getElementById('card-instruction-text');
      if (cardInstr) {
        cardInstr.innerHTML = lang === 'id'
          ? `👉 <strong>Tempelkan kartu fisik (KTP / ATM / Debit / SIM)</strong> pada layar Anda. Sesuaikan ukuran kotak di layar menggunakan slider di bawah sampai sama persis dengan kartu fisik (Standar ISO: <strong>85.60 × 53.98 mm</strong>).`
          : `👉 <strong>Hold any physical card (Credit / Debit / ID card)</strong> against your screen. Adjust the slider below until the on-screen card matches the physical card exactly (ISO Standard: <strong>85.60 × 53.98 mm</strong>).`;
      }
      const cardRefLabel = document.getElementById('card-ref-label');
      if (cardRefLabel) cardRefLabel.textContent = t.calModal.cardRefLabel;
      const cardAdj = document.getElementById('card-adjust-label');
      if (cardAdj) cardAdj.textContent = t.calModal.cardAdjustPpi;
      const cardTip = document.getElementById('card-tip-text');
      if (cardTip) {
        cardTip.innerHTML = lang === 'id'
          ? `💡 Tip: Anda juga dapat menggunakan <strong class="text-[var(--color-ink)]">tombol panah keyboard (← / →)</strong> untuk akurasi sub-piksel!`
          : `💡 Tip: You can also use your <strong class="text-[var(--color-ink)]">keyboard arrow keys (← / →)</strong> for sub-pixel precision!`;
      }
      const btnApplyCard = document.getElementById('btn-apply-card-cal');
      if (btnApplyCard) btnApplyCard.textContent = t.calModal.cardApply;
      const devSearch = document.getElementById('device-search-input') as HTMLInputElement;
      if (devSearch) devSearch.placeholder = t.calModal.deviceSearchPlaceholder;
      const btnReset = document.getElementById('btn-reset-cal');
      if (btnReset) btnReset.textContent = t.calModal.resetDefault;

      const screenCardTitle = document.getElementById('screen-card-title');
      if (screenCardTitle) screenCardTitle.textContent = lang === 'id' ? 'Tempelkan Kartu Fisik Di Sini' : 'Align Physical Card Here';

      // 4. Caliper HUD
      const caliperTitle = document.getElementById('caliper-hud-title');
      if (caliperTitle) caliperTitle.textContent = t.caliper.title;
      const labelSpan = document.getElementById('hud-label-span');
      if (labelSpan) labelSpan.textContent = t.caliper.distance;
      const labelDx = document.getElementById('hud-label-dx');
      if (labelDx) labelDx.textContent = t.caliper.deltaX;
      const labelDy = document.getElementById('hud-label-dy');
      if (labelDy) labelDy.textContent = t.caliper.deltaY;
      const copyCaliperText = document.getElementById('copy-caliper-text');
      if (copyCaliperText) copyCaliperText.textContent = t.caliper.copyValue;

      // 5. Silhouettes Modal
      const silTitle = document.getElementById('silhouettes-modal-title');
      if (silTitle) silTitle.textContent = lang === 'id' ? 'Bandingkan Ukuran Objek Fisik (Skala 1:1)' : 'Physical Object Scale Reference (1:1)';
      const silDesc = document.getElementById('silhouettes-modal-desc');
      if (silDesc) silDesc.textContent = lang === 'id'
        ? 'Pilih objek di bawah untuk menampilkan siluet ukuran sebenarnya di layar. Tempelkan objek fisik Anda pada layar untuk memeriksa presisi kalibrasi:'
        : 'Select an item below to render a 1:1 true-scale silhouette on your screen. Place physical objects directly on glass to verify calibration accuracy:';
      const silCard = document.getElementById('sil-obj-card');
      if (silCard) silCard.textContent = lang === 'id' ? 'Kartu ATM / KTP' : 'Credit Card / ID';
      const silCoin = document.getElementById('sil-obj-coin');
      if (silCoin) silCoin.textContent = lang === 'id' ? 'Koin Rp 1.000' : 'Rp 1,000 Coin';
      const silQuarter = document.getElementById('sil-obj-quarter');
      if (silQuarter) silQuarter.textContent = lang === 'id' ? 'US Quarter ($0.25)' : 'US Quarter ($0.25)';
      const silBatt = document.getElementById('sil-obj-battery');
      if (silBatt) silBatt.textContent = lang === 'id' ? 'Baterai AA' : 'AA Battery';
      const silSim = document.getElementById('sil-obj-sim');
      if (silSim) silSim.textContent = lang === 'id' ? 'Nano SIM Card' : 'Nano SIM Card';
      const silNote = document.getElementById('sil-obj-note');
      if (silNote) silNote.textContent = lang === 'id' ? 'Uang Kertas (IDR)' : 'Banknote (IDR)';

      // 6. How-To Modal
      const howtoBadge = document.getElementById('howto-badge-text');
      if (howtoBadge) howtoBadge.textContent = t.howTo.badge;
      const howtoTitle = document.getElementById('howto-title-text');
      if (howtoTitle) howtoTitle.textContent = t.howTo.title;
      const hStep1T = document.getElementById('howto-step1-title');
      if (hStep1T) hStep1T.textContent = t.howTo.step1Title;
      const hStep1D = document.getElementById('howto-step1-desc');
      if (hStep1D) hStep1D.textContent = t.howTo.step1Desc;
      const hStep2T = document.getElementById('howto-step2-title');
      if (hStep2T) hStep2T.textContent = t.howTo.step2Title;
      const hStep2D = document.getElementById('howto-step2-desc');
      if (hStep2D) hStep2D.textContent = t.howTo.step2Desc;
      const hStep3T = document.getElementById('howto-step3-title');
      if (hStep3T) hStep3T.textContent = t.howTo.step3Title;
      const hStep3D = document.getElementById('howto-step3-desc');
      if (hStep3D) hStep3D.textContent = t.howTo.step3Desc;
      const hShortcuts = document.getElementById('howto-shortcuts-title');
      if (hShortcuts) hShortcuts.textContent = t.howTo.shortcutsTitle;

      const scGuides = document.getElementById('sc-label-guides');
      if (scGuides) scGuides.textContent = t.howTo.shortcutGuides;
      const scCross = document.getElementById('sc-label-crosshair');
      if (scCross) scCross.textContent = t.howTo.shortcutCrosshair;
      const scGrid = document.getElementById('sc-label-grid');
      if (scGrid) scGrid.textContent = t.howTo.shortcutGrid;
      const scCaliper = document.getElementById('sc-label-caliper');
      if (scCaliper) scCaliper.textContent = t.howTo.shortcutCaliper;
      const scFull = document.getElementById('sc-label-fullscreen');
      if (scFull) scFull.textContent = t.howTo.shortcutFullscreen;
      const scTheme = document.getElementById('sc-label-theme');
      if (scTheme) scTheme.textContent = t.howTo.shortcutTheme;
      const scClear = document.getElementById('sc-label-clear');
      if (scClear) scClear.textContent = t.howTo.shortcutClear;
      const scUnits = document.getElementById('sc-label-units');
      if (scUnits) scUnits.textContent = t.howTo.shortcutUnits;
      const btnCloseHowto = document.getElementById('btn-close-howto-bottom');
      if (btnCloseHowto) btnCloseHowto.textContent = t.howTo.gotIt;

      const thPpi = document.getElementById('th-col-ppi');
      if (thPpi) thPpi.textContent = lang === 'id' ? 'Kerapatan PPI' : 'Factory PPI';

      // Mobile Tools Drawer
      const mobTitle = document.getElementById('mobile-tools-title');
      if (mobTitle) mobTitle.textContent = lang === 'id' ? 'Alat Pengukuran Studio' : 'Measuring Studio Tools';

      // 7. SEO Content Section
      const seoBadge = document.getElementById('seo-badge');
      if (seoBadge) seoBadge.textContent = lang === 'id' ? 'ALAT UKUR DIGITAL PRESISI 1:1' : 'PRECISION 1:1 DIGITAL MEASURING STUDIO';
      const seoH1 = document.getElementById('seo-h1');
      if (seoH1) seoH1.textContent = lang === 'id' ? 'Online Penggaris — Penggaris Online Akurat Seukuran Asli (cm, mm, inches)' : 'Online Ruler — Accurate Free Online Ruler Actual Size to Scale (cm, mm, inches)';
      const seoLead = document.getElementById('seo-lead');
      if (seoLead) {
        seoLead.innerHTML = lang === 'id'
          ? `<strong>Online Penggaris</strong> (<em>onlinepenggaris.com</em>) adalah alat ukur <strong>penggaris digital</strong> berbasis web (<strong>free online ruler</strong>) yang mengubah layar laptop, monitor PC, tablet, maupun smartphone Anda menjadi <strong>penggaris online akurat</strong> seukuran fisik nyata (<strong>actual size online ruler to scale</strong>). Dilengkapi pilihan <strong>penggaris online cm</strong>, <strong>online ruler in mm</strong>, <strong>online penggaris inches</strong> (skala <strong>12 inch online ruler</strong>), visual <strong>gambar penggaris</strong>, dan jangka sorong digital dua titik tanpa perlu instalasi aplikasi apapun.`
          : `<strong>Online Penggaris</strong> (<em>onlinepenggaris.com</em>) is a free browser-based <strong>digital ruler</strong> (<strong>free online ruler</strong>) that transforms your laptop, PC monitor, tablet, or smartphone into an <strong>accurate online ruler</strong> calibrated to 1:1 physical dimensions (<strong>actual size online ruler to scale</strong>). Featuring <strong>online ruler in cm</strong>, <strong>online ruler in mm</strong>, <strong>online ruler inches</strong> (standard <strong>12 inch online ruler</strong> scale), visual reference silhouettes, and digital two-point calipers without installing any software.`;
      }

      const sec1Title = document.getElementById('seo-sec1-title');
      if (sec1Title) sec1Title.textContent = lang === 'id' ? 'Mengapa Kalibrasi Kerapatan Piksel (PPI) Penting untuk Penggaris Digital?' : 'Why Pixel Density (PPI) Calibration is Crucial for Actual Size Online Rulers';
      const sec1P1 = document.getElementById('seo-sec1-p1');
      if (sec1P1) sec1P1.textContent = lang === 'id'
        ? 'Setiap layar gawai memiliki kerapatan piksel fisik atau Pixels Per Inch (PPI) yang berlainan. Sebagai contoh, layar monitor desktop 24 inci standar memiliki kerapatan ~93 PPI, laptop 15.6 inci Full HD berada di ~141 PPI, sedangkan layar smartphone modern dan MacBook Retina mencapai 224 hingga 460+ PPI.'
        : 'Every display has a unique hardware pixel density (PPI). A standard 24" desktop monitor has ~93 PPI, a 15.6" Full HD laptop is ~141 PPI, while modern smartphone screens and Retina displays reach 224 to 460+ PPI.';
      const sec1P2 = document.getElementById('seo-sec1-p2');
      if (sec1P2) sec1P2.textContent = lang === 'id'
        ? 'Banyak situs penggaris konvensional hanya mengandalkan nilai default 96 CSS PPI, yang menyebabkan hasil pengukuran meleset hingga 50% atau lebih pada layar resolusi tinggi. Online Penggaris memecahkan permasalahan ini dengan menghadirkan kalibrasi presisi berbasis CSS-Level Device Pixel Ratio (DPR), memastikan bahwa 1 sentimeter atau 1 inci di layar kaca Anda 100% identik dengan penggaris fisik di dunia nyata.'
        : 'Most generic web rulers blindly assume a legacy 96 PPI default, causing measurements to be off by 50% or more on high-DPI screens. Online Penggaris eliminates distortion with CSS-level DPR normalization, guaranteeing that 1 cm or 1 inch on glass matches real physical rulers with sub-millimeter precision.';

      const sec2Title = document.getElementById('seo-sec2-title');
      if (sec2Title) sec2Title.textContent = lang === 'id' ? 'Pilihan Satuan Lengkap: Penggaris Online CM, MM, dan Inches' : 'Comprehensive Unit Options: Online Ruler in CM, MM, and Inches';
      const sec2P1 = document.getElementById('seo-sec2-p1');
      if (sec2P1) sec2P1.textContent = lang === 'id'
        ? 'Untuk memenuhi berbagai kebutuhan pengukuran teknis, kerajinan tangan, arsitektur, hingga edukasi sekolah, Online Penggaris menyediakan dukungan multi-satuan instan:'
        : 'To support engineering, crafting, digital design, and educational workflows, Online Penggaris offers instant multi-unit scaling:';

      const unitCmTitle = document.getElementById('card-unit-cm-title');
      if (unitCmTitle) unitCmTitle.textContent = lang === 'id' ? 'Penggaris Online CM (Centimeter)' : 'Online Ruler in CM (Centimeter)';
      const unitCmDesc = document.getElementById('card-unit-cm-desc');
      if (unitCmDesc) unitCmDesc.textContent = lang === 'id'
        ? 'Menampilkan penomoran skala sentimeter (1, 2, 3, 4... cm) dengan garis pembagi 1 mm dan tanda paruh 5 mm untuk pengukuran metrik harian.'
        : 'Renders crisp centimeter increments (1, 2, 3, 4... cm) with 1 mm sub-divisions and 5 mm half-marks for daily metric tasks.';

      const unitMmTitle = document.getElementById('card-unit-mm-title');
      if (unitMmTitle) unitMmTitle.textContent = lang === 'id' ? 'Online Ruler in MM (Millimeter)' : 'Online Ruler in MM (Millimeter)';
      const unitMmDesc = document.getElementById('card-unit-mm-desc');
      if (unitMmDesc) unitMmDesc.textContent = lang === 'id'
        ? 'Menampilkan penomoran skala milimeter (10, 20, 30, 40... mm) seperti pada mistar teknik presisi untuk mengukur komponen mikro, baut, dan perhiasan.'
        : 'Renders millimeter numbers (10, 20, 30, 40... mm) matching precision engineering rulers for micro-parts, jewelry, and screws.';

      const unitInTitle = document.getElementById('card-unit-in-title');
      if (unitInTitle) unitInTitle.textContent = lang === 'id' ? 'Online Penggaris Inches (12 Inch)' : 'Online Ruler Inches (12 Inch Scale)';
      const unitInDesc = document.getElementById('card-unit-in-desc');
      if (unitInDesc) unitInDesc.textContent = lang === 'id'
        ? 'Menampilkan fraksi imperial 1/8, 1/16, hingga 1/32 inci (12 inch online ruler) untuk standar internasional dan dokumen cetak.'
        : 'Features fractional imperial graduation (1/8, 1/16, and 1/32") representing an actual 12 inch online ruler on larger displays.';

      const sec3Title = document.getElementById('seo-sec3-title');
      if (sec3Title) sec3Title.textContent = lang === 'id' ? 'Mengenal Ragam Penggaris: Penggaris Busur, Penggaris Segitiga & Penggaris Kamera' : 'Ruler Types: Protractor, Triangle Set Square & Camera Measurement';
      const sec3P1 = document.getElementById('seo-sec3-p1');
      if (sec3P1) sec3P1.textContent = lang === 'id'
        ? 'Dalam aktivitas desain teknis dan pendidikan matematika, terdapat berbagai bentuk alat ukur:'
        : 'In technical drawing, architecture, and mathematics, different specialized instruments are used:';

      const sec3BusurTitle = document.getElementById('sec3-busur-title');
      if (sec3BusurTitle) sec3BusurTitle.textContent = lang === 'id' ? '📐 Penggaris Busur Derajat (Protractor 180° / 360°)' : '📐 Protractor (Busur Derajat 180° / 360°)';
      const sec3BusurDesc = document.getElementById('sec3-busur-desc');
      if (sec3BusurDesc) sec3BusurDesc.textContent = lang === 'id'
        ? 'Penggaris busur digunakan untuk mengukur dan menggambar sudut geometris secara akurat mulai dari 0° hingga 180°. Pada studio online kami, Anda dapat memanfaatkan kalkulasi trigonometri digital dan jangka sorong untuk mengukur kemiringan sudut objek.'
        : 'A protractor measures and draws geometric angles from 0° to 180°. In our online studio, you can leverage digital trigonometry and dual-point calipers to calculate precise angular orientation.';

      const sec3SegitigaTitle = document.getElementById('sec3-segitiga-title');
      if (sec3SegitigaTitle) sec3SegitigaTitle.textContent = lang === 'id' ? '📐 Penggaris Segitiga (Set Square 45° & 30°/60°)' : '📐 Triangle Set Square (Penggaris Segitiga 45° & 30°/60°)';
      const sec3SegitigaDesc = document.getElementById('sec3-segitiga-desc');
      if (sec3SegitigaDesc) sec3SegitigaDesc.textContent = lang === 'id'
        ? 'Penggaris segitiga merupakan alat wajib arsitek dan drafter untuk menarik garis tegak lurus (90°) dan sudut istimewa. Melalui fitur Bingkai 4 Sisi (Full Frame) dan Matriks Grid, layar perangkat Anda berubah menjadi meja gambar berpresisi tinggi.'
        : 'Set squares allow draftsmen to draw true perpendicular lines (90°) and special angles. With our 4-Way Full Frame and Grid Matrix overlays, your screen transforms into a drafting workbench.';

      const sec3KameraTitle = document.getElementById('sec3-kamera-title');
      if (sec3KameraTitle) sec3KameraTitle.textContent = lang === 'id' ? '📷 Penggaris Online Kamera (Online Ruler Camera Tips)' : '📷 Online Ruler Camera Tips (Penggaris Online Kamera)';
      const sec3KameraDesc = document.getElementById('sec3-kamera-desc');
      if (sec3KameraDesc) sec3KameraDesc.textContent = lang === 'id'
        ? 'Bagi pengguna smartphone yang mencari penggaris online kamera (online ruler camera), cara paling akurat untuk mengukur benda fisik adalah dengan menempelkan benda langsung pada kaca layar berpelindung sejajar dengan garis skala 1:1, atau menggunakan siluet referensi standar kami (seperti kartu KTP atau koin Rp 1.000) sebagai acuan pembanding.'
