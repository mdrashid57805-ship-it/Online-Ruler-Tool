  function updateCardSimulator() {
    const cardBox = document.getElementById('modal-card-box');
    const dimsLabel = document.getElementById('screen-card-dims');
    if (!cardBox) return;

    // Card width: 85.60 mm -> CSS pixels = (85.60 / 25.4) * calState.ppi
    const cardWidthPx = Math.round((85.60 / 25.4) * calState.ppi);
    const cardHeightPx = Math.round((53.98 / 25.4) * calState.ppi);

    cardBox.style.width = `${cardWidthPx}px`;
    cardBox.style.height = `${cardHeightPx}px`;

    if (dimsLabel) {
      dimsLabel.textContent = `85.60 × 53.98 mm (${cardWidthPx} × ${cardHeightPx} px)`;
    }
  }

  function checkAutoDetection() {
    const detected = detectCurrentDevice();
    const badge = document.getElementById('auto-confidence-badge');
    const title = document.getElementById('auto-device-title');
    const specs = document.getElementById('auto-device-specs');
    const ppiVal = document.getElementById('auto-ppi-val');

    if (detected.match) {
      if (title) title.textContent = detected.match.name;
      if (specs) {
        specs.textContent = `Resolusi: ${detected.match.width}×${detected.match.height} px | Diagonal: ${detected.match.diagonal}″ | DPR: ${detected.match.dpr}x`;
      }
      if (ppiVal) ppiVal.textContent = `${detected.estimatedPpi} PPI`;

      if (badge) {
        if (detected.confidence === 'exact') {
          badge.textContent = currentLang === 'id' ? 'Kecocokan Pabrikan Sangat Akurat (100%)' : 'Exact Factory Match (100%)';
          badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 inline-block mb-1';
        } else {
          badge.textContent = currentLang === 'id' ? 'Kecocokan Profil Layar Tinggi' : 'High Confidence Profile';
          badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-indigo-500/10 text-indigo-500 inline-block mb-1';
        }
      }
    } else {
      const sw = typeof screen !== 'undefined' ? screen.width : 1920;
      const sh = typeof screen !== 'undefined' ? screen.height : 1080;
      const dpr = typeof window !== 'undefined' ? (window.devicePixelRatio || 1) : 1;
      if (title) title.textContent = currentLang === 'id' ? `Layar Standar (${sw * dpr} × ${sh * dpr} px)` : `Standard Display (${sw * dpr} × ${sh * dpr} px)`;
      if (specs) specs.textContent = `DPR: ${dpr}x | Viewport: ${sw}×${sh} px`;
      if (ppiVal) ppiVal.textContent = `${detected.estimatedPpi} PPI`;
      if (badge) {
        badge.textContent = currentLang === 'id' ? 'Estimasi Standar' : 'Standard Fallback';
        badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-amber-500/10 text-amber-500 inline-block mb-1';
      }
    }
  }

  function renderDeviceCatalog(filterCat = 'all', searchQuery = '') {
    const listContainer = document.getElementById('device-catalog-list');
    if (!listContainer) return;

    listContainer.innerHTML = '';
    const query = searchQuery.toLowerCase().trim();

    const filtered = DEVICE_DATABASE.filter(dev => {
      const matchesCat = filterCat === 'all' || dev.category === filterCat;
      const matchesQuery = !query || dev.name.toLowerCase().includes(query) || dev.id.includes(query);
      return matchesCat && matchesQuery;
    });

    if (filtered.length === 0) {
      listContainer.innerHTML = `<p class="text-xs text-[var(--color-mute)] py-4 text-center">${currentLang === 'id' ? 'Tidak ada perangkat yang cocok.' : 'No matching devices found.'}</p>`;
      return;
    }

    filtered.forEach(dev => {
      const cssPpi = Math.round((dev.ppi / dev.dpr) * 10) / 10;
      const card = document.createElement('div');
      card.className = 'p-2.5 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:border-indigo-500 hover:bg-[var(--color-canvas)] transition-all flex items-center justify-between cursor-pointer group';
      card.innerHTML = `
        <div>
          <span class="text-xs font-semibold text-[var(--color-ink)] group-hover:text-indigo-500 block">${dev.name}</span>
          <span class="text-[10px] font-mono text-[var(--color-mute)]">${dev.diagonal}″ • ${dev.width}×${dev.height} px • DPR ${dev.dpr}x</span>
        </div>
        <div class="text-right">
          <span class="text-xs font-mono font-bold text-indigo-500 block">${cssPpi} PPI</span>
          <span class="text-[9px] text-[var(--color-mute)] font-medium">${currentLang === 'id' ? 'Pilih' : 'Select'}</span>
        </div>
      `;
      card.addEventListener('click', () => {
        calState = {
          ppi: cssPpi,
          method: 'device',
          deviceName: dev.name,
          isCalibrated: true,
          calibratedAt: new Date().toISOString(),
        };
        saveCalibration(calState);
        updateCalibrationUI();
        renderAllRulers();
        closeModal('calibration-modal');
      });
      listContainer.appendChild(card);
    });
  }

  // --- CALIPER LOGIC ---
  function updateCaliper() {
    const hud = document.getElementById('caliper-hud');
    const container = document.getElementById('caliper-container');
    const line = document.getElementById('caliper-line');
    const proj = document.getElementById('caliper-proj');
    const handleA = document.getElementById('caliper-handle-a');
    const handleB = document.getElementById('caliper-handle-b');
    const badge = document.getElementById('caliper-badge');
    const distText = document.getElementById('caliper-distance-text');
    const hudDist = document.getElementById('hud-caliper-dist');
    const hudDx = document.getElementById('hud-caliper-dx');
    const hudDy = document.getElementById('hud-caliper-dy');

    if (!showCaliper) {
      if (hud) hud.style.display = 'none';
      if (container) container.style.display = 'none';
      return;
    }

    if (hud) hud.style.display = 'flex';
    if (container) container.style.display = 'block';

    const { p1, p2 } = caliperPoints;

    if (handleA) {
      handleA.style.left = `${p1.x}px`;
      handleA.style.top = `${p1.y}px`;
    }
    if (handleB) {
      handleB.style.left = `${p2.x}px`;
      handleB.style.top = `${p2.y}px`;
    }

    if (line) {
      line.setAttribute('x1', `${p1.x}`);
      line.setAttribute('y1', `${p1.y}`);
      line.setAttribute('x2', `${p2.x}`);
      line.setAttribute('y2', `${p2.y}`);
    }

    if (proj) {
      proj.setAttribute('d', `M ${p1.x} ${p1.y} L ${p2.x} ${p1.y} L ${p2.x} ${p2.y}`);
    }

    const midX = (p1.x + p2.x) / 2;
    const midY = (p1.y + p2.y) / 2;

    if (badge) {
      badge.style.left = `${midX}px`;
      badge.style.top = `${midY}px`;
    }

    const dxPx = Math.abs(p2.x - p1.x);
    const dyPx = Math.abs(p2.y - p1.y);
    const distPx = Math.sqrt(dxPx * dxPx + dyPx * dyPx);

    const formattedDist = formatMeasurement(distPx, activeUnit, calState.ppi);
    const formattedDx = formatMeasurement(dxPx, activeUnit, calState.ppi);
    const formattedDy = formatMeasurement(dyPx, activeUnit, calState.ppi);

    if (distText) distText.textContent = formattedDist;
    if (hudDist) hudDist.textContent = formattedDist;
    if (hudDx) hudDx.textContent = formattedDx;
    if (hudDy) hudDy.textContent = formattedDy;
  }

  // --- GUIDE LINES ---
  function addGuideLine(type: 'h' | 'v', pos: number) {
    const id = `guide-${Date.now()}`;
    guideLines.push({ id, type, pos });
    renderGuideLines();
  }

  function renderGuideLines() {
    const container = document.getElementById('guides-container');
    if (!container) return;
    container.innerHTML = '';

    if (!showGuides && guideLines.length === 0) return;

    guideLines.forEach(g => {
      const line = document.createElement('div');
      line.className = `guide-line ${g.type === 'h' ? 'horizontal' : 'vertical'}`;
      if (g.type === 'h') {
        line.style.top = `${g.pos}px`;
      } else {
        line.style.left = `${g.pos}px`;
      }

      const badge = document.createElement('div');
      badge.className = 'guide-badge';
      const formatted = formatMeasurement(g.pos, activeUnit, calState.ppi);
      badge.textContent = `${formatted} (${currentLang === 'id' ? 'Klik untuk hapus' : 'Click to delete'})`;

      if (g.type === 'h') {
        badge.style.left = '50px';
        badge.style.top = '-20px';
      } else {
        badge.style.left = '6px';
        badge.style.top = '60px';
      }

      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        guideLines = guideLines.filter(item => item.id !== g.id);
        renderGuideLines();
      });

      line.appendChild(badge);
      container.appendChild(line);
    });
  }

  // --- BUTTON STATE STYLING ---
  function updateEdgeButtonStyles() {
    document.querySelectorAll('[data-edge-btn]').forEach(btn => {
      const edge = btn.getAttribute('data-edge-btn');
      if (edge === 'frame') {
        const isFrame = activeEdges.top && activeEdges.bottom && activeEdges.left && activeEdges.right;
        btn.setAttribute('aria-pressed', isFrame ? 'true' : 'false');
      } else if (edge && edge in activeEdges) {
        btn.setAttribute('aria-pressed', activeEdges[edge as keyof typeof activeEdges] ? 'true' : 'false');
      }
    });

    const guidesBtn = document.getElementById('btn-tool-guides');
    if (guidesBtn) guidesBtn.setAttribute('aria-pressed', showGuides ? 'true' : 'false');

    const crossBtn = document.getElementById('btn-tool-crosshair');
    if (crossBtn) crossBtn.setAttribute('aria-pressed', showCrosshair ? 'true' : 'false');

    const gridBtn = document.getElementById('btn-tool-grid');
    if (gridBtn) gridBtn.setAttribute('aria-pressed', showGrid ? 'true' : 'false');

    const caliperBtn = document.getElementById('btn-tool-caliper');
    if (caliperBtn) caliperBtn.setAttribute('aria-pressed', showCaliper ? 'true' : 'false');
  }

  function updateUnitButtonStyles() {
    document.querySelectorAll('.unit-btn').forEach(btn => {
      const u = btn.getAttribute('data-unit');
      if (u === activeUnit) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  function openModal(id: string) {
    const m = document.getElementById(id);
    if (m) m.style.display = 'flex';
  }

  function closeModal(id: string) {
    const m = document.getElementById(id);
    if (m) m.style.display = 'none';
  }

  // --- EVENT LISTENERS BINDINGS ---
  function bindEvents() {
    // Window Resize
    window.addEventListener('resize', () => {
      renderAllRulers();
      checkAutoDetection();
    });

    // Theme Toggle
    const themeBtn = document.getElementById('btn-theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
      } catch (e) {}
      renderAllRulers();
    });

    // Language Toggle Button (Switches between ID and EN)
    const langBtn = document.getElementById('btn-lang-toggle');
    langBtn?.addEventListener('click', () => {
      const nextLang: Language = currentLang === 'id' ? 'en' : 'id';
      applyLanguage(nextLang);
      try {
        localStorage.setItem(STORAGE_KEY_LANG, nextLang);
      } catch (e) {}
      renderAllRulers();
      renderDeviceCatalog();
      checkAutoDetection();
    });

    // Mobile Tools Sheet Toggle
    const mobileToolsBtn = document.getElementById('btn-mobile-tools-toggle');
    const mobileDrawer = document.getElementById('mobile-tools-drawer');
    const btnCloseDrawer = document.getElementById('btn-close-mobile-drawer');

    mobileToolsBtn?.addEventListener('click', () => {
      if (mobileDrawer) mobileDrawer.style.display = 'flex';
    });
    btnCloseDrawer?.addEventListener('click', () => {
      if (mobileDrawer) mobileDrawer.style.display = 'none';
    });

    // Mobile Drawer Action Triggers
    document.getElementById('btn-drawer-caliper')?.addEventListener('click', () => {
      showCaliper = true;
      if (mobileDrawer) mobileDrawer.style.display = 'none';
      updateCaliper();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-drawer-grid')?.addEventListener('click', () => {
      showGrid = !showGrid;
      if (mobileDrawer) mobileDrawer.style.display = 'none';
      renderAllRulers();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-drawer-silhouettes')?.addEventListener('click', () => {
      if (mobileDrawer) mobileDrawer.style.display = 'none';
      openModal('silhouettes-modal');
    });

    document.getElementById('btn-drawer-guides')?.addEventListener('click', () => {
      showGuides = !showGuides;
      if (mobileDrawer) mobileDrawer.style.display = 'none';
      renderGuideLines();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-drawer-howto')?.addEventListener('click', () => {
      if (mobileDrawer) mobileDrawer.style.display = 'none';
      openModal('howto-modal');
    });

    // Edge Placement Buttons (Desktop and Mobile)
    document.querySelectorAll('[data-edge-btn]').forEach(btn => {
      btn.addEventListener('click', () => {
        const edge = btn.getAttribute('data-edge-btn');
        if (edge === 'frame') {
          const isAll = activeEdges.top && activeEdges.bottom && activeEdges.left && activeEdges.right;
          activeEdges = { top: !isAll, bottom: !isAll, left: !isAll, right: !isAll };
        } else if (edge && edge in activeEdges) {
          activeEdges[edge as keyof typeof activeEdges] = !activeEdges[edge as keyof typeof activeEdges];
        }
        // Hide welcome banner once an edge is clicked
        const welcome = document.getElementById('welcome-state');
        if (welcome) welcome.style.display = 'none';
        // Smoothly scroll to top workspace if scrolled down
        window.scrollTo({ top: 0, behavior: 'smooth' });
        renderAllRulers();
      });
    });

    // Quick Edge Buttons in Welcome Banner
    document.querySelectorAll('[data-quick-edge]').forEach(btn => {
      btn.addEventListener('click', () => {
        const edge = btn.getAttribute('data-quick-edge');
        if (edge && edge in activeEdges) {
          activeEdges = { top: false, bottom: false, left: false, right: false };
          activeEdges[edge as keyof typeof activeEdges] = true;
          const welcome = document.getElementById('welcome-state');
          if (welcome) welcome.style.display = 'none';
          renderAllRulers();
        }
      });
    });

    // Hide Welcome Banner
    document.getElementById('btn-hide-welcome')?.addEventListener('click', () => {
      const welcome = document.getElementById('welcome-state');
      if (welcome) welcome.style.display = 'none';
    });

    // Unit Switcher (cm, mm, in, px, pt)
    document.querySelectorAll('.unit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const u = btn.getAttribute('data-unit') as MeasurementUnit;
        if (u) {
          activeUnit = u;
          try {
            localStorage.setItem(STORAGE_KEY_UNIT, activeUnit);
          } catch (e) {}
          renderAllRulers();
        }
      });
    });

    // Tool Toggles
    document.getElementById('btn-tool-guides')?.addEventListener('click', () => {
      showGuides = !showGuides;
      renderGuideLines();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-tool-crosshair')?.addEventListener('click', () => {
      showCrosshair = !showCrosshair;
      const chH = document.getElementById('crosshair-h');
      const chV = document.getElementById('crosshair-v');
      const readout = document.getElementById('cursor-readout');
      if (chH) chH.style.display = showCrosshair ? 'block' : 'none';
      if (chV) chV.style.display = showCrosshair ? 'block' : 'none';
      if (readout) readout.style.display = showCrosshair ? 'block' : 'none';
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-tool-grid')?.addEventListener('click', () => {
      showGrid = !showGrid;
      renderAllRulers();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-tool-caliper')?.addEventListener('click', () => {
      showCaliper = !showCaliper;
      updateCaliper();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-close-caliper-hud')?.addEventListener('click', () => {
      showCaliper = false;
      updateCaliper();
      updateEdgeButtonStyles();
    });

    document.getElementById('btn-copy-caliper')?.addEventListener('click', () => {
      const hudDist = document.getElementById('hud-caliper-dist')?.textContent;
      if (hudDist) {
        navigator.clipboard.writeText(hudDist);
        const copyText = document.getElementById('copy-caliper-text');
        if (copyText) {
          copyText.textContent = currentLang === 'id' ? 'Tersalin!' : 'Copied!';
          setTimeout(() => {
            if (copyText) copyText.textContent = currentLang === 'id' ? 'Salin' : 'Copy';
          }, 1500);
        }
      }
    });

    document.getElementById('caliper-badge')?.addEventListener('click', () => {
      const distText = document.getElementById('caliper-distance-text')?.textContent;
      if (distText) {
        navigator.clipboard.writeText(distText);
      }
    });

    // Caliper drag handles (Pointer & Touch support)
    const handleA = document.getElementById('caliper-handle-a');
    const handleB = document.getElementById('caliper-handle-b');
    const rulerWs = document.getElementById('ruler-workspace');

    handleA?.addEventListener('pointerdown', (e) => {
      isDraggingCaliper = 'p1';
      (e.target as HTMLElement).setPointerCapture(e.pointerId);
    });

    handleB?.addEventListener('pointerdown', (e) => {
      isDraggingCaliper = 'p2';
      (e.target as HTMLElement).setPointerCapture(e.pointerId);
    });

    window.addEventListener('pointermove', (e) => {
      if (isDraggingCaliper && rulerWs) {
        const rect = rulerWs.getBoundingClientRect();
        const x = Math.max(10, Math.min(rect.width - 10, e.clientX - rect.left));
        const y = Math.max(10, Math.min(rect.height - 10, e.clientY - rect.top));

        if (isDraggingCaliper === 'p1') {
          caliperPoints.p1 = { x, y };
        } else if (isDraggingCaliper === 'p2') {
          caliperPoints.p2 = { x, y };
        }
        updateCaliper();
      }

      // Crosshair Movement
      if (showCrosshair && rulerWs) {
        const rect = rulerWs.getBoundingClientRect();
        if (e.clientY >= rect.top && e.clientY <= rect.bottom) {
          const chH = document.getElementById('crosshair-h');
          const chV = document.getElementById('crosshair-v');
          const readout = document.getElementById('cursor-readout');

          const relY = e.clientY - rect.top;
          const relX = e.clientX - rect.left;

          if (chH) chH.style.top = `${relY}px`;
          if (chV) chV.style.left = `${relX}px`;

          if (readout) {
            readout.style.left = `${relX}px`;
            readout.style.top = `${relY}px`;
            const formattedX = formatMeasurement(relX, activeUnit, calState.ppi);
            const formattedY = formatMeasurement(relY, activeUnit, calState.ppi);
            readout.textContent = `X: ${formattedX} | Y: ${formattedY}`;
          }
        }
      }
    });

    window.addEventListener('pointerup', () => {
      isDraggingCaliper = null;
    });

    // Fullscreen Toggle
    document.getElementById('btn-fullscreen-toggle')?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    // Canvas click to place guide lines
    document.getElementById('ruler-canvas-top')?.addEventListener('click', (e) => {
      const wsRect = rulerWs?.getBoundingClientRect() || { left: 0 };
      addGuideLine('v', e.clientX - wsRect.left);
    });
    document.getElementById('ruler-canvas-bottom')?.addEventListener('click', (e) => {
      const wsRect = rulerWs?.getBoundingClientRect() || { left: 0 };
      addGuideLine('v', e.clientX - wsRect.left);
    });
    document.getElementById('ruler-canvas-left')?.addEventListener('click', (e) => {
      const wsRect = rulerWs?.getBoundingClientRect() || { top: 52 };
      addGuideLine('h', e.clientY - wsRect.top);
    });
    document.getElementById('ruler-canvas-right')?.addEventListener('click', (e) => {
      const wsRect = rulerWs?.getBoundingClientRect() || { top: 52 };
      addGuideLine('h', e.clientY - wsRect.top);
    });

    // Modals open / close triggers
    document.getElementById('btn-open-calibrate')?.addEventListener('click', () => openModal('calibration-modal'));
    document.getElementById('btn-welcome-cal-status')?.addEventListener('click', () => openModal('calibration-modal'));
    document.getElementById('welcome-change-device')?.addEventListener('click', () => openModal('calibration-modal'));
    document.getElementById('btn-close-cal-modal')?.addEventListener('click', () => closeModal('calibration-modal'));

    document.getElementById('btn-open-howto')?.addEventListener('click', () => openModal('howto-modal'));
    document.getElementById('btn-close-howto-modal')?.addEventListener('click', () => closeModal('howto-modal'));
    document.getElementById('btn-close-howto-bottom')?.addEventListener('click', () => closeModal('howto-modal'));

    document.getElementById('btn-tool-silhouettes')?.addEventListener('click', () => openModal('silhouettes-modal'));
    document.getElementById('btn-close-silhouettes')?.addEventListener('click', () => closeModal('silhouettes-modal'));

    // Calibration modal tabs
    document.querySelectorAll('[data-cal-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-cal-tab');
        document.querySelectorAll('.cal-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('.cal-panel').forEach(p => ((p as HTMLElement).style.display = 'none'));
        const activePanel = document.getElementById(`tab-panel-${tab}`);
        if (activePanel) activePanel.style.display = 'block';
      });
    });

    // Calibration Method 1: Apply Auto
    document.getElementById('btn-apply-auto')?.addEventListener('click', () => {
      const detected = detectCurrentDevice();
      calState = {
        ppi: detected.estimatedPpi,
        method: 'auto',
        deviceName: detected.match ? detected.match.name : (currentLang === 'id' ? `Layar Terdeteksi (~${Math.round(detected.estimatedPpi)} PPI)` : `Detected Screen (~${Math.round(detected.estimatedPpi)} PPI)`),
        isCalibrated: true,
        calibratedAt: new Date().toISOString(),
      };
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Calibration Method 2: Diagonal
    const diagInput = document.getElementById('diagonal-input-val') as HTMLInputElement;
    const diagCalcRes = document.getElementById('diagonal-calc-result');

    function updateDiagonalPreview() {
      const val = parseFloat(diagInput?.value || '0');
      if (val > 0) {
        const ppi = calculatePpiFromDiagonal(val);
        if (diagCalcRes) diagCalcRes.textContent = `${ppi.toFixed(1)} PPI`;
      }
    }

    diagInput?.addEventListener('input', updateDiagonalPreview);

    document.querySelectorAll('.diag-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const d = chip.getAttribute('data-diag');
        if (d && diagInput) {
          diagInput.value = d;
          updateDiagonalPreview();
        }
      });
    });

    document.getElementById('btn-apply-diagonal')?.addEventListener('click', () => {
      const val = parseFloat(diagInput?.value || '0');
      if (val >= 4 && val <= 100) {
        const ppi = calculatePpiFromDiagonal(val);
        calState = {
          ppi,
          method: 'diagonal',
          deviceName: `Diagonal ${val}″`,
          isCalibrated: true,
          calibratedAt: new Date().toISOString(),
        };
        saveCalibration(calState);
        updateCalibrationUI();
        renderAllRulers();
        closeModal('calibration-modal');
      }
    });

    // Calibration Method 3: Credit Card Slider & Nudging
    const cardSlider = document.getElementById('card-ppi-slider') as HTMLInputElement;
    const cardPpiDisplay = document.getElementById('card-ppi-display');

    cardSlider?.addEventListener('input', (e) => {
      const newPpi = parseFloat((e.target as HTMLInputElement).value);
      calState.ppi = newPpi;
      if (cardPpiDisplay) cardPpiDisplay.textContent = `${newPpi.toFixed(1)} PPI`;
      updateCardSimulator();
    });

    document.getElementById('btn-card-minus')?.addEventListener('click', () => {
      if (cardSlider) {
        const val = Math.max(50, parseFloat(cardSlider.value) - 0.5);
        cardSlider.value = `${val}`;
        calState.ppi = val;
        if (cardPpiDisplay) cardPpiDisplay.textContent = `${val.toFixed(1)} PPI`;
        updateCardSimulator();
      }
    });

    document.getElementById('btn-card-plus')?.addEventListener('click', () => {
      if (cardSlider) {
        const val = Math.min(260, parseFloat(cardSlider.value) + 0.5);
        cardSlider.value = `${val}`;
        calState.ppi = val;
        if (cardPpiDisplay) cardPpiDisplay.textContent = `${val.toFixed(1)} PPI`;
        updateCardSimulator();
      }
    });

    document.getElementById('btn-apply-card-cal')?.addEventListener('click', () => {
      calState.isCalibrated = true;
      calState.method = 'card';
      calState.deviceName = currentLang === 'id' ? 'Kalibrasi Kartu Fisik' : 'Physical Card Calibrated';
      calState.calibratedAt = new Date().toISOString();
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Reset Calibration
    document.getElementById('btn-reset-cal')?.addEventListener('click', () => {
      calState = {
        ppi: 96,
        method: 'custom',
        deviceName: currentLang === 'id' ? 'Standar Default (96 PPI)' : 'Default Standard (96 PPI)',
        isCalibrated: false,
        calibratedAt: new Date().toISOString(),
      };
      saveCalibration(calState);
      updateCalibrationUI();
      renderAllRulers();
      closeModal('calibration-modal');
    });

    // Device Catalog Search & Categories
    const searchInput = document.getElementById('device-search-input') as HTMLInputElement;
    let activeCat = 'all';

    searchInput?.addEventListener('input', (e) => {
      renderDeviceCatalog(activeCat, (e.target as HTMLInputElement).value);
    });

    document.querySelectorAll('.cat-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.getAttribute('data-cat') || 'all';
        renderDeviceCatalog(activeCat, searchInput?.value || '');
      });
    });

    // Silhouette Item Selector
    document.querySelectorAll('.obj-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const obj = btn.getAttribute('data-obj');
        const box = document.getElementById('active-silhouette-box');
        const label = document.getElementById('silhouette-label');
        if (!box) return;

        let wMm = 85.6;
        let hMm = 53.98;
        let name = currentLang === 'id' ? 'Kartu ATM / KTP' : 'Credit Card / ID';

        if (obj === 'coin-idr') {
          wMm = 24.15;
          hMm = 24.15;
          name = currentLang === 'id' ? 'Koin Rp 1.000 (Ø 24.15 mm)' : 'Rp 1,000 Coin (Ø 24.15 mm)';
        } else if (obj === 'coin-usd') {
          wMm = 24.26;
          hMm = 24.26;
          name = currentLang === 'id' ? 'US Quarter $0.25 (Ø 24.26 mm)' : 'US Quarter $0.25 (Ø 24.26 mm)';
        } else if (obj === 'battery-aa') {
          wMm = 50.5;
          hMm = 14.5;
          name = currentLang === 'id' ? 'Baterai AA (50.50 × 14.50 mm)' : 'AA Battery (50.50 × 14.50 mm)';
        } else if (obj === 'sim') {
          wMm = 12.3;
          hMm = 8.8;
          name = currentLang === 'id' ? 'Nano SIM Card (12.30 × 8.80 mm)' : 'Nano SIM Card (12.30 × 8.80 mm)';
        } else if (obj === 'banknote') {
          wMm = 121.0;
          hMm = 65.0;
          name = currentLang === 'id' ? 'Uang Kertas IDR (121.0 × 65.0 mm)' : 'IDR Banknote (121.0 × 65.0 mm)';
        }

        const wPx = Math.round((wMm / 25.4) * calState.ppi);
        const hPx = Math.round((hMm / 25.4) * calState.ppi);

        box.style.width = `${wPx}px`;
        box.style.height = `${hPx}px`;
        if (obj === 'coin-idr' || obj === 'coin-usd') {
          box.style.borderRadius = '9999px';
        } else {
          box.style.borderRadius = '8px';
        }

        if (label) label.textContent = `${name} (${wPx}×${hPx} px)`;
      });
    });

    // Global Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'SELECT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
        return;
      }

      switch (e.key) {
        case '1':
          activeUnit = 'cm';
          renderAllRulers();
          break;
        case '2':
          activeUnit = 'mm';
          renderAllRulers();
          break;
        case '3':
          activeUnit = 'in';
          renderAllRulers();
          break;
        case 'g':
        case 'G':
          showGuides = !showGuides;
          renderGuideLines();
          updateEdgeButtonStyles();
          break;
        case 'c':
        case 'C':
          showCrosshair = !showCrosshair;
          const chH = document.getElementById('crosshair-h');
          const chV = document.getElementById('crosshair-v');
          const readout = document.getElementById('cursor-readout');
          if (chH) chH.style.display = showCrosshair ? 'block' : 'none';
          if (chV) chV.style.display = showCrosshair ? 'block' : 'none';
          if (readout) readout.style.display = showCrosshair ? 'block' : 'none';
          updateEdgeButtonStyles();
          break;
        case 'm':
        case 'M':
          showGrid = !showGrid;
          renderAllRulers();
          updateEdgeButtonStyles();
          break;
        case 'k':
        case 'K':
          showCaliper = !showCaliper;
          updateCaliper();
          updateEdgeButtonStyles();
          break;
        case 'f':
        case 'F':
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
          break;
        case 'd':
        case 'D':
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
          } catch (err) {}
          renderAllRulers();
          break;
        case 'h':
        case 'H':
          openModal('howto-modal');
          break;
        case 'Escape':
          closeModal('calibration-modal');
          closeModal('howto-modal');
          closeModal('silhouettes-modal');
          const mobDrawer = document.getElementById('mobile-tools-drawer');
          if (mobDrawer) mobDrawer.style.display = 'none';
          guideLines = [];
          renderGuideLines();
          break;
        case 'ArrowLeft':
        case 'ArrowDown':
          if (document.getElementById('tab-panel-card')?.style.display === 'block') {
            const val = Math.max(50, calState.ppi - 0.2);
            calState.ppi = val;
            const slider = document.getElementById('card-ppi-slider') as HTMLInputElement;
            if (slider) slider.value = `${val}`;
            const disp = document.getElementById('card-ppi-display');
            if (disp) disp.textContent = `${val.toFixed(1)} PPI`;
            updateCardSimulator();
          }
          break;
        case 'ArrowRight':
        case 'ArrowUp':
          if (document.getElementById('tab-panel-card')?.style.display === 'block') {
            const val = Math.min(260, calState.ppi + 0.2);
            calState.ppi = val;
            const slider = document.getElementById('card-ppi-slider') as HTMLInputElement;
            if (slider) slider.value = `${val}`;
            const disp = document.getElementById('card-ppi-display');
            if (disp) disp.textContent = `${val.toFixed(1)} PPI`;
            updateCardSimulator();
          }
          break;
      }
    });
  }

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
  } else {
    initApp();
  }
</script>
