---
import TermsPage from '../../components/TermsPage.astro';
import { languages, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as SupportedLanguage[])
    .filter((l) => l !== 'en')
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<TermsPage lang={lang} />
