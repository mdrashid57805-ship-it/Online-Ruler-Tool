---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Hubungi Kami — Online Penggaris | Kontak & Masukan Pengguna"
  description="Hubungi tim OnlinePenggaris.com untuk saran fitur, pertanyaan kalibrasi, pelaporan bug, atau pengajuan spesifikasi tipe perangkat baru."
  lang="id"
>
  <Navbar lang="id" />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-4xl mx-auto text-[var(--color-ink)] space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-mute)]" aria-label="Breadcrumb">
      <a id="cnt-bread-home" href="/" class="hover:text-[var(--color-ink)] transition-colors">Beranda</a>
      <span>/</span>
      <span id="cnt-bread-curr" class="text-red-600 font-medium">Hubungi Kami</span>
    </nav>

    <!-- Header -->
    <div class="space-y-3">
      <div id="cnt-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
        BANTUAN & KONTAK
      </div>
      <h1 id="cnt-h1" class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Hubungi Tim Online Penggaris
      </h1>
      <p id="cnt-lead" class="text-sm sm:text-base text-[var(--color-body)] leading-relaxed">
        Punya ide perbaikan, ingin menambahkan model smartphone / laptop ke database kami, atau memerlukan bantuan teknis? Kami siap membantu.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Contact Info Card -->
      <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-6 text-xs sm:text-sm">
        <h2 id="cnt-info-title" class="text-base font-bold text-[var(--color-ink)] flex items-center gap-2">
          <span>📬</span> Informasi Kontak Resmi
        </h2>
        
        <div class="space-y-4">
          <div class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] space-y-1">
            <span id="cnt-email-label" class="text-[11px] text-[var(--color-mute)] block font-medium">Email Dukungan & Kerjasama:</span>
            <a href="mailto:support@onlinepenggaris.com" class="font-mono text-sm font-bold text-red-600 hover:underline">
              support@onlinepenggaris.com
            </a>
          </div>

          <div class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] space-y-1">
            <span id="cnt-domain-label" class="text-[11px] text-[var(--color-mute)] block font-medium">Situs Resmi:</span>
            <span class="font-mono text-sm font-bold text-[var(--color-ink)]">https://onlinepenggaris.com</span>
          </div>

          <div class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] space-y-1">
            <span id="cnt-resp-label" class="text-[11px] text-[var(--color-mute)] block font-medium">Waktu Respons:</span>
            <span id="cnt-resp-val" class="text-xs text-[var(--color-body)] font-medium">Umumnya dibalas dalam 1x24 jam kerja.</span>
          </div>
        </div>

        <div id="cnt-tip-box" class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/20 text-xs text-[var(--color-ink)] leading-relaxed">
          💡 <strong>Pengajuan Database Perangkat:</strong> Sertakan nama model HP / Laptop Anda, ukuran diagonal (inci), dan resolusi layar asli agar kami dapat menambahkannya ke database kalibrasi otomatis.
        </div>
      </div>

      <!-- Quick Message Form -->
      <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-4">
        <h2 id="cnt-form-title" class="text-base font-bold text-[var(--color-ink)] flex items-center gap-2">
          <span>✍️</span> Kirim Pesan Cepat
        </h2>

        <form id="contact-form" class="space-y-3 text-xs">
          <div class="space-y-1">
            <label id="cnt-lbl-name" for="contact-name" class="font-medium text-[var(--color-ink)] block">Nama Lengkap:</label>
            <input
              id="contact-name"
              type="text"
              required
              placeholder="e.g. Budi Santoso"
              class="w-full px-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-red-500"
            />
          </div>

          <div class="space-y-1">
            <label id="cnt-lbl-email" for="contact-email" class="font-medium text-[var(--color-ink)] block">Alamat Email:</label>
            <input
              id="contact-email"
              type="email"
              required
              placeholder="nama@email.com"
              class="w-full px-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-red-500"
            />
          </div>

          <div class="space-y-1">
            <label id="cnt-lbl-topic" for="contact-topic" class="font-medium text-[var(--color-ink)] block">Topik:</label>
            <select
              id="contact-topic"
              class="w-full px-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-red-500 font-sans"
            >
              <option value="feedback">Saran Fitur & Masukan</option>
              <option value="device">Pengajuan Database Layar / Perangkat</option>
              <option value="bug">Laporan Masalah / Bug Kalibrasi</option>
              <option value="other">Pertanyaan Lainnya</option>
            </select>
          </div>

          <div class="space-y-1">
            <label id="cnt-lbl-msg" for="contact-msg" class="font-medium text-[var(--color-ink)] block">Pesan:</label>
            <textarea
              id="contact-msg"
              rows="3"
              required
              placeholder="Tuliskan masukan atau kendala Anda di sini..."
              class="w-full px-3 py-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-red-500 resize-none"
            ></textarea>
          </div>

          <button
            id="btn-submit-contact"
            type="submit"
            class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-md transition-all flex items-center justify-center gap-1.5"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span id="btn-submit-text">Kirim Pesan Sekarang</span>
          </button>
        </form>

        <script is:inline>
          document.getElementById('contact-form')?.addEventListener('submit', function (e) {
            e.preventDefault();
            const lang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
            alert(lang === 'en' ? 'Thank you! Your feedback has been received.' : 'Terima kasih! Pesan dan masukan Anda telah terkirim.');
          });
        </script>
      </div>

    </div>

    <!-- Return to Tool CTA -->
    <div class="pt-4 text-center">
      <a id="btn-cnt-back" href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-md transition-all">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Kembali ke Alat Penggaris Online</span>
      </a>
    </div>
  </main>

  <Footer lang="id" />

  <!-- Subpage Language Synchronization Script -->
  <script is:inline>
    (function () {
      const DICT = {
        id: {
          breadHome: 'Beranda',
          breadCurr: 'Hubungi Kami',
          badge: 'BANTUAN & KONTAK',
          h1: 'Hubungi Tim Online Penggaris',
          lead: 'Punya ide perbaikan, ingin menambahkan model smartphone / laptop ke database kami, atau memerlukan bantuan teknis? Kami siap membantu.',
          infoTitle: '📬 Informasi Kontak Resmi',
          emailLabel: 'Email Dukungan & Kerjasama:',
          domainLabel: 'Situs Resmi:',
          respLabel: 'Waktu Respons:',
          respVal: 'Umumnya dibalas dalam 1x24 jam kerja.',
          tipBox: '💡 <strong>Pengajuan Database Perangkat:</strong> Sertakan nama model HP / Laptop Anda, ukuran diagonal (inci), dan resolusi layar asli agar kami dapat menambahkannya ke database kalibrasi otomatis.',
          formTitle: '✍️ Kirim Pesan Cepat',
          lblName: 'Nama Lengkap:',
          lblEmail: 'Alamat Email:',
          lblTopic: 'Topik:',
          lblMsg: 'Pesan:',
          phName: 'e.g. Budi Santoso',
          phEmail: 'nama@email.com',
          phMsg: 'Tuliskan masukan atau kendala Anda di sini...',
          btnSubmit: 'Kirim Pesan Sekarang',
          backCta: 'Kembali ke Alat Penggaris Online',
          btnLabel: 'EN'
        },
        en: {
          breadHome: 'Home',
          breadCurr: 'Contact Us',
          badge: 'SUPPORT & CONTACT',
          h1: 'Contact Online Penggaris Team',
          lead: 'Have suggestions, want to add a smartphone/laptop model to our screen database, or need technical assistance? We are here to help.',
          infoTitle: '📬 Official Contact Information',
          emailLabel: 'Support & Partnerships Email:',
          domainLabel: 'Official Domain:',
          respLabel: 'Response Time:',
          respVal: 'Typically answered within 24 business hours.',
          tipBox: '💡 <strong>Device Database Submission:</strong> Please include your device model, screen diagonal (inches), and native resolution so we can add it to our auto-detection library.',
          formTitle: '✍️ Send a Quick Message',
          lblName: 'Full Name:',
          lblEmail: 'Email Address:',
          lblTopic: 'Topic:',
          lblMsg: 'Message:',
          phName: 'e.g. John Doe',
          phEmail: 'name@email.com',
          phMsg: 'Write your feedback or bug report here...',
          btnSubmit: 'Send Message Now',
          backCta: 'Return to Online Ruler Tool',
          btnLabel: 'ID'
        }
      };

      function updatePage(lang) {
        const d = DICT[lang] || DICT.id;
        const bH = document.getElementById('cnt-bread-home');
        if (bH) bH.textContent = d.breadHome;
        const bC = document.getElementById('cnt-bread-curr');
        if (bC) bC.textContent = d.breadCurr;
        const badge = document.getElementById('cnt-badge');
        if (badge) badge.textContent = d.badge;
        const h1 = document.getElementById('cnt-h1');
        if (h1) h1.textContent = d.h1;
        const lead = document.getElementById('cnt-lead');
        if (lead) lead.textContent = d.lead;

        const infoT = document.getElementById('cnt-info-title');
        if (infoT) infoT.textContent = d.infoTitle;
        const eLbl = document.getElementById('cnt-email-label');
        if (eLbl) eLbl.textContent = d.emailLabel;
        const dLbl = document.getElementById('cnt-domain-label');
        if (dLbl) dLbl.textContent = d.domainLabel;
        const rLbl = document.getElementById('cnt-resp-label');
        if (rLbl) rLbl.textContent = d.respLabel;
        const rVal = document.getElementById('cnt-resp-val');
        if (rVal) rVal.textContent = d.respVal;
        const tipBox = document.getElementById('cnt-tip-box');
        if (tipBox) tipBox.innerHTML = d.tipBox;

        const formT = document.getElementById('cnt-form-title');
        if (formT) formT.textContent = d.formTitle;
        const lName = document.getElementById('cnt-lbl-name');
        if (lName) lName.textContent = d.lblName;
        const lEmail = document.getElementById('cnt-lbl-email');
        if (lEmail) lEmail.textContent = d.lblEmail;
        const lTopic = document.getElementById('cnt-lbl-topic');
        if (lTopic) lTopic.textContent = d.lblTopic;
        const lMsg = document.getElementById('cnt-lbl-msg');
        if (lMsg) lMsg.textContent = d.lblMsg;

        const iName = document.getElementById('contact-name');
        if (iName) iName.placeholder = d.phName;
        const iEmail = document.getElementById('contact-email');
        if (iEmail) iEmail.placeholder = d.phEmail;
        const iMsg = document.getElementById('contact-msg');
        if (iMsg) iMsg.placeholder = d.phMsg;
        const btnSub = document.getElementById('btn-submit-text');
        if (btnSub) btnSub.textContent = d.btnSubmit;

        const btnCta = document.getElementById('btn-cnt-back');
        if (btnCta) {
          const span = btnCta.querySelector('span');
          if (span) span.textContent = d.backCta;
        }

        const langBtnLabel = document.getElementById('lang-btn-label');
        if (langBtnLabel) langBtnLabel.textContent = d.btnLabel;
      }

      let currentLang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
      updatePage(currentLang);

      const btnLang = document.getElementById('btn-lang-toggle');
      if (btnLang) {
        btnLang.addEventListener('click', function () {
          currentLang = currentLang === 'id' ? 'en' : 'id';
          localStorage.setItem('onlinepenggaris_lang_v1', currentLang);
          updatePage(currentLang);
        });
      }
    })();
  </script>
</BaseLayout>
