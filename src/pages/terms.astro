---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Syarat & Ketentuan Layanan — Online Penggaris"
  description="Syarat dan ketentuan resmi penggunaan situs penggaris online gratis di OnlinePenggaris.com."
  lang="id"
>
  <Navbar lang="id" />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-4xl mx-auto text-[var(--color-ink)] space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-mute)]" aria-label="Breadcrumb">
      <a id="terms-bread-home" href="/" class="hover:text-[var(--color-ink)] transition-colors">Beranda</a>
      <span>/</span>
      <span id="terms-bread-curr" class="text-red-600 font-medium">Syarat & Ketentuan</span>
    </nav>

    <!-- Header -->
    <div class="space-y-3">
      <div id="terms-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
        KETENTUAN HUKUM
      </div>
      <h1 id="terms-h1" class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Syarat & Ketentuan Layanan (Terms of Service)
      </h1>
      <p id="terms-date" class="text-xs text-[var(--color-mute)] font-mono">
        Terakhir Diperbarui: {new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </div>

    <!-- Main Content -->
    <article class="space-y-6 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
      
      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="terms-s1-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          1. Penerimaan Syarat
        </h2>
        <p id="terms-s1-p">
          Dengan mengakses dan menggunakan situs web <strong>OnlinePenggaris.com</strong>, Anda menyetujui untuk terikat oleh syarat dan ketentuan penggunaan ini secara penuh. Apabila Anda tidak menyetujui ketentuan ini, Anda dipersilakan untuk tidak menggunakan situs ini.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="terms-s2-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          2. Lisensi Penggunaan Gratis
        </h2>
        <p id="terms-s2-p">
          Layanan OnlinePenggaris.com disediakan secara <strong>100% gratis</strong> untuk penggunaan pribadi, pendidikan, komersial ringan, maupun referensi harian. Anda diperbolehkan menggunakan alat ini untuk mengukur berbagai benda fisik tanpa pungutan biaya.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="terms-s3-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          3. Batasan Tanggung Jawab & Disclaimer Kalibrasi
        </h2>
        <p id="terms-s3-p">
          Meskipun sistem kami dirancang dengan algoritma kalibrasi presisi tinggi untuk menghasilkan skala 1:1 sub-milimeter, akurasi akhir dapat dipengaruhi oleh faktor eksternal (seperti scaling resolusi sistem operasi, pengaturan zoom browser, atau pelindung layar tebal).
        </p>
        <div id="terms-s3-alert" class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/20 text-xs text-[var(--color-ink)] font-medium">
          ⚠️ Untuk kebutuhan pengukuran bersertifikasi hukum, teknik konstruksi struktural beban berat, kedokteran, atau kalibrasi laboratorium resmi, harap selalu gunakan alat ukur fisik bersertifikat metrologi resmi (seperti Vernier Caliper berstandar ISO/SNI).
        </div>
      </section>

      <section class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <h2 id="terms-s4-title" class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          4. Hak Cipta & Kekayaan Intelektual
        </h2>
        <p id="terms-s4-p">
          Seluruh elemen desain antarmuka (UI), kode program kanvas, logo, dan konten artikel edukasi pada OnlinePenggaris.com dilindungi oleh hak cipta. Dilarang menyalin atau mendistribusikan ulang kode sumber tanpa izin tertulis.
        </p>
      </section>

    </article>

    <!-- Return to Tool CTA -->
    <div class="pt-4 text-center">
      <a id="btn-terms-back" href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-md transition-all">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Kembali ke Alat Penggaris Online</span>
      </a>
    </div>
  </main>

  <Footer lang="id" />

  <!-- Subpage Language Synchronization Script -->
  <script is:inline>
    (function () {
      const DICT = {
        id: {
          breadHome: 'Beranda',
          breadCurr: 'Syarat & Ketentuan',
          badge: 'KETENTUAN HUKUM',
          h1: 'Syarat & Ketentuan Layanan (Terms of Service)',
          date: 'Terakhir Diperbarui: September 2026',
          s1T: '1. Penerimaan Syarat',
          s1P: 'Dengan mengakses dan menggunakan situs web OnlinePenggaris.com, Anda menyetujui untuk terikat oleh syarat dan ketentuan penggunaan ini secara penuh. Apabila Anda tidak menyetujui ketentuan ini, Anda dipersilakan untuk tidak menggunakan situs ini.',
          s2T: '2. Lisensi Penggunaan Gratis',
          s2P: 'Layanan OnlinePenggaris.com disediakan secara 100% gratis untuk penggunaan pribadi, pendidikan, komersial ringan, maupun referensi harian. Anda diperbolehkan menggunakan alat ini untuk mengukur berbagai benda fisik tanpa pungutan biaya.',
          s3T: '3. Batasan Tanggung Jawab & Disclaimer Kalibrasi',
          s3P: 'Meskipun sistem kami dirancang dengan algoritma kalibrasi presisi tinggi untuk menghasilkan skala 1:1 sub-milimeter, akurasi akhir dapat dipengaruhi oleh faktor eksternal (seperti scaling resolusi sistem operasi, pengaturan zoom browser, atau pelindung layar tebal).',
          s3Alert: '⚠️ Untuk kebutuhan pengukuran bersertifikasi hukum, teknik konstruksi struktural beban berat, kedokteran, atau kalibrasi laboratorium resmi, harap selalu gunakan alat ukur fisik bersertifikat metrologi resmi (seperti Vernier Caliper berstandar ISO/SNI).',
          s4T: '4. Hak Cipta & Kekayaan Intelektual',
          s4P: 'Seluruh elemen desain antarmuka (UI), kode program kanvas, logo, dan konten artikel edukasi pada OnlinePenggaris.com dilindungi oleh hak cipta. Dilarang menyalin atau mendistribusikan ulang kode sumber tanpa izin tertulis.',
          backCta: 'Kembali ke Alat Penggaris Online',
          btnLabel: 'EN'
        },
        en: {
          breadHome: 'Home',
          breadCurr: 'Terms of Service',
          badge: 'LEGAL TERMS',
          h1: 'Terms of Service',
          date: 'Last Updated: September 2026',
          s1T: '1. Acceptance of Terms',
          s1P: 'By accessing and using OnlinePenggaris.com, you agree to be fully bound by these Terms of Service. If you disagree with any part of these terms, please discontinue using this service.',
          s2T: '2. Free Usage License',
          s2P: 'OnlinePenggaris.com is provided 100% free of charge for personal, educational, creative, and commercial reference purposes. You may use all measurement features without any subscription or payment.',
          s3T: '3. Limitation of Liability & Accuracy Disclaimer',
          s3P: 'While our calibration algorithms are built for sub-millimeter 1:1 precision, real-world accuracy depends on device settings (such as OS zoom scaling, browser zoom level, or thick glass protectors).',
          s3Alert: '⚠️ For legally certified metrology, heavy structural engineering, or medical calibration, please always use officially certified physical measuring instruments (e.g. ISO/DIN certified Vernier Calipers).',
          s4T: '4. Intellectual Property Rights',
          s4P: 'All user interface designs, canvas rendering code, logos, and technical guides on OnlinePenggaris.com are protected by copyright. Unauthorized redistribution of source code is prohibited.',
          backCta: 'Return to Online Ruler Tool',
          btnLabel: 'ID'
        }
      };

      function updatePage(lang) {
        const d = DICT[lang] || DICT.id;
        const bH = document.getElementById('terms-bread-home');
        if (bH) bH.textContent = d.breadHome;
        const bC = document.getElementById('terms-bread-curr');
        if (bC) bC.textContent = d.breadCurr;
        const badge = document.getElementById('terms-badge');
        if (badge) badge.textContent = d.badge;
        const h1 = document.getElementById('terms-h1');
        if (h1) h1.textContent = d.h1;
        const date = document.getElementById('terms-date');
        if (date) date.textContent = d.date;

        const s1T = document.getElementById('terms-s1-title');
        if (s1T) s1T.textContent = d.s1T;
        const s1P = document.getElementById('terms-s1-p');
        if (s1P) s1P.textContent = d.s1P;

        const s2T = document.getElementById('terms-s2-title');
        if (s2T) s2T.textContent = d.s2T;
        const s2P = document.getElementById('terms-s2-p');
        if (s2P) s2P.textContent = d.s2P;

        const s3T = document.getElementById('terms-s3-title');
        if (s3T) s3T.textContent = d.s3T;
        const s3P = document.getElementById('terms-s3-p');
        if (s3P) s3P.textContent = d.s3P;
        const s3A = document.getElementById('terms-s3-alert');
        if (s3A) s3A.textContent = d.s3Alert;

        const s4T = document.getElementById('terms-s4-title');
        if (s4T) s4T.textContent = d.s4T;
        const s4P = document.getElementById('terms-s4-p');
        if (s4P) s4P.textContent = d.s4P;

        const btnCta = document.getElementById('btn-terms-back');
        if (btnCta) {
          const span = btnCta.querySelector('span');
          if (span) span.textContent = d.backCta;
        }

        const langBtnLabel = document.getElementById('lang-btn-label');
        if (langBtnLabel) langBtnLabel.textContent = d.btnLabel;
      }

      let currentLang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
      updatePage(currentLang);

      const btnLang = document.getElementById('btn-lang-toggle');
      if (btnLang) {
        btnLang.addEventListener('click', function () {
          currentLang = currentLang === 'id' ? 'en' : 'id';
          localStorage.setItem('onlinepenggaris_lang_v1', currentLang);
          updatePage(currentLang);
        });
      }
    })();
  </script>
</BaseLayout>
