---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Cara Kalibrasi Penggaris Online — Panduan Presisi Ukuran Asli 1:1"
  description="Panduan lengkap cara kalibrasi penggaris online di layar HP, laptop, dan monitor PC menggunakan deteksi hardware, diagonal layar, atau kartu ATM/KTP."
  lang="id"
>
  <Navbar lang="id" />

  <main class="pt-24 pb-20 px-4 sm:px-6 max-w-4xl mx-auto text-[var(--color-ink)] space-y-12">
    <!-- Header -->
    <div class="space-y-3 text-center sm:text-left">
      <a id="cal-bread-back" href="/" class="inline-flex items-center gap-1.5 text-xs text-red-600 font-semibold hover:underline mb-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span id="cal-bread-back-text">Kembali ke Penggaris</span>
      </a>
      <h1 id="cal-page-h1" class="text-3xl sm:text-4xl font-bold tracking-tight">
        Panduan Kalibrasi Layar Penggaris Online
      </h1>
      <p id="cal-page-lead" class="text-sm sm:text-base text-[var(--color-body)] leading-relaxed">
        Mengapa kalibrasi sangat penting? Setiap layar memiliki kerapatan piksel (Pixels Per Inch / PPI) yang berbeda. Tanpa kalibrasi, 1 cm di layar hanyalah estimasi perkiraan. Ikuti panduan di bawah untuk mendapatkan akurasi 100% seukuran asli.
      </p>
    </div>

    <!-- 3 Methods Detailed Walkthrough -->
    <div class="space-y-8">
      
      <!-- Method 1 -->
      <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <div id="m1-badge" class="inline-block px-2.5 py-0.5 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
          METODE 1
        </div>
        <h2 id="m1-title" class="text-xl font-bold">Deteksi Hardware Otomatis (Instan)</h2>
        <p id="m1-desc" class="text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
          Sistem Online Penggaris membaca spesifikasi rasio piksel (DPR), resolusi layar, dan platform perangkat Anda, lalu mencocokkannya ke database spesifikasi pabrikan (Apple MacBook, iPhone, iPad, Dell XPS, Samsung Galaxy, dll).
        </p>
        <div id="m1-step" class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs text-[var(--color-body)]">
          <strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">1. Auto-Detect</span> &rarr; Klik tombol <span class="text-red-600 font-semibold">Terapkan Kalibrasi Otomatis</span>.
        </div>
      </div>

      <!-- Method 2 -->
      <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <div id="m2-badge" class="inline-block px-2.5 py-0.5 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
          METODE 2
        </div>
        <h2 id="m2-title" class="text-xl font-bold">Diagonal Layar (Inci)</h2>
        <p id="m2-desc" class="text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
          Ukuran diagonal layar adalah jarak lurus dari sudut kiri bawah ke sudut kanan atas layar aktif (dalam satuan inci). Rumus Pythagoras akan menghitung kerapatan piksel:
        </p>
        <div class="p-3 font-mono text-xs rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-red-600 font-semibold">
          PPI = √(Lebar² + Tinggi²) / Diagonal_Inci
        </div>
        <div id="m2-step" class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs text-[var(--color-body)]">
          <strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">2. Diagonal Layar</span> &rarr; Masukkan ukuran (misal 14.0", 15.6", atau 27") &rarr; Klik <span class="text-red-600 font-semibold">Terapkan</span>.
        </div>
      </div>

      <!-- Method 3 -->
      <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] space-y-3">
        <div id="m3-badge" class="inline-block px-2.5 py-0.5 rounded-full bg-red-500/10 text-red-600 text-xs font-bold font-mono">
          METODE 3
        </div>
        <h2 id="m3-title" class="text-xl font-bold">Kalibrasi Kartu ATM / KTP (Paling Mudah)</h2>
        <p id="m3-desc" class="text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
          Semua kartu bank (debit, kredit, e-Toll, SIM, KTP) di seluruh dunia mengikuti standar internasional <strong>ISO/IEC 7810 ID-1</strong> dengan dimensi presisi <strong>85.60 mm × 53.98 mm</strong>.
        </p>
        <div id="m3-step" class="p-3.5 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs text-[var(--color-body)]">
          <strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">3. Kartu ATM / KTP</span> &rarr; Tempelkan kartu fisik pada layar &rarr; Geser slider sampai ukuran kotak di layar sama persis dengan kartu Anda.
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="p-8 rounded-2xl bg-red-600 text-white text-center space-y-3 shadow-xl">
      <h3 id="cal-cta-title" class="text-xl font-bold">Siap Mengukur Objek Sekarang?</h3>
      <p id="cal-cta-sub" class="text-xs text-red-100 max-w-md mx-auto">
        Buka alat penggaris dan gunakan penunjuk ukur presisi kami seukuran asli.
      </p>
      <a id="btn-cal-cta" href="/" class="inline-block px-6 py-2.5 rounded-full bg-white text-red-600 font-bold text-xs hover:bg-red-50 transition-colors shadow">
        Buka Online Penggaris
      </a>
    </div>
  </main>

  <Footer lang="id" />

  <!-- Subpage Language Synchronization Script -->
  <script is:inline>
    (function () {
      const DICT = {
        id: {
          backText: 'Kembali ke Penggaris',
          h1: 'Panduan Kalibrasi Layar Penggaris Online',
          lead: 'Mengapa kalibrasi sangat penting? Setiap layar memiliki kerapatan piksel (Pixels Per Inch / PPI) yang berbeda. Tanpa kalibrasi, 1 cm di layar hanyalah estimasi perkiraan. Ikuti panduan di bawah untuk mendapatkan akurasi 100% seukuran asli.',
          m1B: 'METODE 1',
          m1T: 'Deteksi Hardware Otomatis (Instan)',
          m1D: 'Sistem Online Penggaris membaca spesifikasi rasio piksel (DPR), resolusi layar, dan platform perangkat Anda, lalu mencocokkannya ke database spesifikasi pabrikan (Apple MacBook, iPhone, iPad, Dell XPS, Samsung Galaxy, dll).',
          m1S: '<strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">1. Auto-Detect</span> &rarr; Klik tombol <span class="text-red-600 font-semibold">Terapkan Kalibrasi Otomatis</span>.',
          m2B: 'METODE 2',
          m2T: 'Diagonal Layar (Inci)',
          m2D: 'Ukuran diagonal layar adalah jarak lurus dari sudut kiri bawah ke sudut kanan atas layar aktif (dalam satuan inci). Rumus Pythagoras akan menghitung kerapatan piksel:',
          m2S: '<strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">2. Diagonal Layar</span> &rarr; Masukkan ukuran (misal 14.0", 15.6", atau 27") &rarr; Klik <span class="text-red-600 font-semibold">Terapkan</span>.',
          m3B: 'METODE 3',
          m3T: 'Kalibrasi Kartu ATM / KTP (Paling Mudah)',
          m3D: 'Semua kartu bank (debit, kredit, e-Toll, SIM, KTP) di seluruh dunia mengikuti standar internasional <strong>ISO/IEC 7810 ID-1</strong> dengan dimensi presisi <strong>85.60 mm × 53.98 mm</strong>.',
          m3S: '<strong>Langkah:</strong> Buka menu <span class="text-red-600 font-semibold">Kalibrasi</span> &rarr; Pilih tab <span class="text-red-600 font-semibold">3. Kartu ATM / KTP</span> &rarr; Tempelkan kartu fisik pada layar &rarr; Geser slider sampai ukuran kotak di layar sama persis dengan kartu Anda.',
          ctaT: 'Siap Mengukur Objek Sekarang?',
          ctaS: 'Buka alat penggaris dan gunakan penunjuk ukur presisi kami seukuran asli.',
          ctaBtn: 'Buka Online Penggaris',
          btnLabel: 'EN'
        },
        en: {
          backText: 'Back to Online Ruler',
          h1: 'Online Ruler Screen Calibration Guide',
          lead: 'Why is calibration essential? Every display has a unique pixel density (PPI). Without calibration, 1 cm on screen is merely an uncalibrated guess. Follow the guide below to achieve 100% 1:1 true physical scale.',
          m1B: 'METHOD 1',
          m1T: 'Automatic Hardware Detection (Instant)',
          m1D: 'Our system reads viewport resolution, Device Pixel Ratio (DPR), and platform specs to match manufacturer databases (Apple MacBook, iPhone, iPad, Dell XPS, Samsung Galaxy, etc.).',
          m1S: '<strong>Steps:</strong> Click <span class="text-red-600 font-semibold">Calibrate</span> &rarr; Select <span class="text-red-600 font-semibold">1. Auto-Detect</span> &rarr; Click <span class="text-red-600 font-semibold">Apply Calibrated PPI</span>.',
          m2B: 'METHOD 2',
          m2T: 'Screen Diagonal (Inches)',
          m2D: 'Screen diagonal is the corner-to-corner active display measurement in inches. The Pythagorean theorem computes exact pixel density:',
          m2S: '<strong>Steps:</strong> Click <span class="text-red-600 font-semibold">Calibrate</span> &rarr; Select <span class="text-red-600 font-semibold">2. Screen Diagonal</span> &rarr; Enter your diagonal size (e.g. 14.0", 15.6", or 27") &rarr; Click <span class="text-red-600 font-semibold">Calculate & Apply</span>.',
          m3B: 'METHOD 3',
          m3T: 'Bank Card / ID Alignment (Easiest)',
          m3D: 'All credit cards, debit cards, driving licenses, and ID cards worldwide follow the standard <strong>ISO/IEC 7810 ID-1</strong> dimensions: <strong>85.60 mm × 53.98 mm</strong>.',
          m3S: '<strong>Steps:</strong> Click <span class="text-red-600 font-semibold">Calibrate</span> &rarr; Select <span class="text-red-600 font-semibold">3. Credit Card / ID</span> &rarr; Hold your card against the screen &rarr; Adjust the slider until the outline matches your physical card.',
          ctaT: 'Ready to Measure Objects?',
          ctaS: 'Launch the digital ruler workspace with interactive marker, dual calipers, and multi-unit scales.',
          ctaBtn: 'Open Online Ruler',
          btnLabel: 'ID'
        }
      };

      function updatePage(lang) {
        const d = DICT[lang] || DICT.id;
        const bText = document.getElementById('cal-bread-back-text');
        if (bText) bText.textContent = d.backText;
        const h1 = document.getElementById('cal-page-h1');
        if (h1) h1.textContent = d.h1;
        const lead = document.getElementById('cal-page-lead');
        if (lead) lead.textContent = d.lead;

        const m1B = document.getElementById('m1-badge');
        if (m1B) m1B.textContent = d.m1B;
        const m1T = document.getElementById('m1-title');
        if (m1T) m1T.textContent = d.m1T;
        const m1D = document.getElementById('m1-desc');
        if (m1D) m1D.textContent = d.m1D;
        const m1S = document.getElementById('m1-step');
        if (m1S) m1S.innerHTML = d.m1S;

        const m2B = document.getElementById('m2-badge');
        if (m2B) m2B.textContent = d.m2B;
        const m2T = document.getElementById('m2-title');
        if (m2T) m2T.textContent = d.m2T;
        const m2D = document.getElementById('m2-desc');
        if (m2D) m2D.textContent = d.m2D;
        const m2S = document.getElementById('m2-step');
        if (m2S) m2S.innerHTML = d.m2S;

        const m3B = document.getElementById('m3-badge');
        if (m3B) m3B.textContent = d.m3B;
        const m3T = document.getElementById('m3-title');
        if (m3T) m3T.textContent = d.m3T;
        const m3D = document.getElementById('m3-desc');
        if (m3D) m3D.textContent = d.m3D;
        const m3S = document.getElementById('m3-step');
        if (m3S) m3S.innerHTML = d.m3S;

        const ctaT = document.getElementById('cal-cta-title');
        if (ctaT) ctaT.textContent = d.ctaT;
        const ctaS = document.getElementById('cal-cta-sub');
        if (ctaS) ctaS.textContent = d.ctaS;
        const ctaBtn = document.getElementById('btn-cal-cta');
        if (ctaBtn) ctaBtn.textContent = d.ctaBtn;

        const langBtnLabel = document.getElementById('lang-btn-label');
        if (langBtnLabel) langBtnLabel.textContent = d.btnLabel;
      }

      let currentLang = localStorage.getItem('onlinepenggaris_lang_v1') || 'id';
      updatePage(currentLang);

      const btnLang = document.getElementById('btn-lang-toggle');
      if (btnLang) {
        btnLang.addEventListener('click', function () {
          currentLang = currentLang === 'id' ? 'en' : 'id';
          localStorage.setItem('onlinepenggaris_lang_v1', currentLang);
          updatePage(currentLang);
        });
      }
    })();
  </script>
</BaseLayout>
