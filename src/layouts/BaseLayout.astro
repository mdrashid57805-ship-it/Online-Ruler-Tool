---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'id' | 'en';
}

const {
  title = 'Penggaris Online — Ukur Panjang Akurat Seukuran Asli (cm, mm, inci) | onlinepenggaris.com',
  description = 'Penggaris online gratis akurat seukuran asli di layar HP, laptop, dan monitor PC (skala 1:1 cm, mm, inci). Dilengkapi penunjuk / marker ukur interaktif dan kalibrasi otomatis.',
  lang = 'id'
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '';
const pageUrl = `https://onlinepenggaris.com${pathname || '/'}`;
const pageEnUrl = `https://onlinepenggaris.com${pathname || '/'}?lang=en`;
const ogImageUrl = 'https://onlinepenggaris.com/og-image.png';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X2ST24TC94"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X2ST24TC94');
    </script>

    <!-- Theme initialization script (Defaults to clean white / light theme) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('onlinepenggaris_theme_v1');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }

          // Language initialization (strictly defaults to 'id')
          const urlParams = new URLSearchParams(window.location.search);
          const urlLang = urlParams.get('lang');
          let currentLang = 'id';
          if (urlLang === 'en') {
            currentLang = 'en';
          } else if (urlLang === 'id') {
            currentLang = 'id';
          } else {
            const savedLang = localStorage.getItem('onlinepenggaris_lang_v1');
            if (savedLang === 'en') currentLang = 'en';
          }
          document.documentElement.lang = currentLang;
        } catch (e) {}
      })();
    </script>

    <!-- Primary SEO Meta Tags for Indonesian Ranking -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="penggaris online, penggaris, penggaris digital, penggaris online cm, online penggaris, penggaris online mm, penggaris online inches, gambar penggaris, cara memunculkan penggaris di word, penggaris busur, penggaris segitiga, free online ruler, accurate online ruler, penggaris layar hp, penggaris layar laptop, online ruler in cm, online ruler in mm"
    />
    <meta name="author" content="Online Penggaris" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    
    <!-- Geo Target for Indonesia -->
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    <meta name="language" content="Indonesian" />

    <link rel="canonical" href={pageUrl} />
    
    <!-- Hreflang Tags for ID -->
    <link rel="alternate" hreflang="id" href={pageUrl} />
    <link rel="alternate" hreflang="id-ID" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={pageEnUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content="Penggaris Online — Ukur Panjang Akurat Seukuran Asli (cm, mm, in)" />
    <meta property="og:description" content="Penggaris online gratis akurat seukuran asli di layar HP dan laptop. Dilengkapi penunjuk / marker ukur dan kalibrasi layar 1:1." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Penggaris Online - OnlinePenggaris.com" />
    <meta property="og:site_name" content="Online Penggaris" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={pageUrl} />
    <meta property="twitter:title" content="Penggaris Online — Ukur Akurat Seukuran Asli (cm, mm, in)" />
    <meta property="twitter:description" content="Penggaris online digital gratis untuk layar HP, laptop, dan monitor seukuran fisik asli." />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:image:alt" content="Penggaris Online - OnlinePenggaris.com" />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Penggaris" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data: WebApplication -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Penggaris Online",
        "alternateName": [
          "Online Penggaris",
          "Penggaris Digital Online",
          "Penggaris Layar HP",
          "Penggaris Online CM"
        ],
        "url": "https://onlinepenggaris.com",
        "description": "Penggaris online gratis akurat seukuran asli (skala 1:1) dalam cm, mm, dan inci dengan penunjuk / marker ukur presisi dan kalibrasi otomatis layar.",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All (Web Browser, Android, iOS, Windows, macOS)",
        "inLanguage": ["id", "en"],
        "isAccessibleForFree": true,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "IDR"
        },
        "featureList": [
          "Penggaris online seukuran asli terkalibrasi layar 1:1",
          "Penunjuk dan marker geser interaktif (interactive ruler pointer)",
          "Penggaris online cm, mm, dan inci",
          "3 Metode Kalibrasi: Otomatis, Diagonal Layar, dan Kartu ATM/KTP",
          "Pilihan Posisi Penggaris: Atas, Bawah, Kiri, Kanan, 4 Sisi",
          "Jangka Sorong Digital (Two-Point Caliper)",
          "100% Gratis tanpa download aplikasi"
        ]
      }
    </script>

    <!-- JSON-LD Structured Data: FAQPage Schema -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Apakah penggaris online ini benar-benar akurat seukuran asli?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ya, 100% akurat. Setelah melakukan kalibrasi layar (menggunakan deteksi otomatis hardware, memasukkan ukuran diagonal layar dalam inci, atau mencocokkan kartu ATM/KTP fisik standar ISO), skala 1 cm, 1 mm, maupun 1 inci di layar kaca sama persis dengan penggaris fisik di dunia nyata."
            }
          },
          {
            "@type": "Question",
            "name": "Bagaimana cara mengukur dengan penunjuk / marker di penggaris online?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Cukup klik atau geser jari/kursor Anda pada garis penggaris di layar. Garis penunjuk (marker) merah akan otomatis mengikuti dan menampilkan hasil pengukuran panjang langsung secara instan dalam cm, mm, dan inci."
            }
          },
          {
            "@type": "Question",
            "name": "Bisakah saya menggunakan HP sebagai penggaris?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ya! Buka OnlinePenggaris.com di browser HP Anda (Android atau iPhone). Layar Anda akan langsung berubah menjadi penggaris digital seukuran nyata."
            }
          },
          {
            "@type": "Question",
            "name": "Cara memunculkan penggaris di Word?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Untuk memunculkan penggaris di Microsoft Word: 1. Buka dokumen Word. 2. Klik tab menu 'View' (Tampilan) pada pita atas. 3. Pada grup 'Show', centang kotak 'Ruler' (Penggaris). Penggaris horizontal dan vertikal akan langsung muncul."
            }
          },
          {
            "@type": "Question",
            "name": "Bahasa Inggrisnya penggaris?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bahasa Inggris dari penggaris adalah 'Ruler' atau 'Straightedge'. Penggaris busur adalah 'Protractor', penggaris segitiga adalah 'Set Square', dan jangka sorong adalah 'Caliper'."
            }
          }
        ]
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink)] selection:bg-red-500/20">
    <slot />
  </body>
</html>
