---
import '../styles/global.css';
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';
import { getHreflangLinks, getCleanPathname } from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const currentPath = Astro.url.pathname;
const t = ui[lang] || ui[defaultLang];

const title = Astro.props.title || t.metaTitle;
const description = Astro.props.description || t.metaDescription;
const keywords = Astro.props.keywords || t.keywords;

const siteUrl = 'https://onlinepenggaris.com';
const cleanPath = getCleanPathname(currentPath);
const cleanNorm = cleanPath === '/' ? '' : cleanPath.replace(/\/$/, '');

// Canonical URL for this specific language page
const canonicalUrl = lang === defaultLang 
  ? `${siteUrl}${cleanNorm || '/'}` 
  : `${siteUrl}/${lang}${cleanNorm}/`;

const hreflangLinks = getHreflangLinks(cleanPath, siteUrl);
const ogImageUrl = `${siteUrl}/og-image.png`;

const ogLocales: Record<SupportedLanguage, string> = {
  en: 'en_US',
  es: 'es_ES',
  ja: 'ja_JP',
  fr: 'fr_FR',
  de: 'de_DE',
  pt: 'pt_BR',
  ko: 'ko_KR',
  it: 'it_IT',
  id: 'id_ID',
};
const currentOgLocale = ogLocales[lang] || 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X2ST24TC94"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X2ST24TC94');
    </script>

    <!-- Theme initialization script -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('onlinepenggaris_theme_v1');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={t.siteName} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- International SEO: Hreflang Markup for all supported languages + x-default English fallback -->
    {hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t.siteName} - onlinepenggaris.com`} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={currentOgLocale} />
    {Object.entries(ogLocales)
      .filter(([code]) => code !== lang)
      .map(([, loc]) => (
        <meta property="og:locale:alternate" content={loc} />
      ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${t.siteName} - onlinepenggaris.com`} />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Ruler" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data: WebApplication Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": t.siteName,
      "alternateName": [
        "Online Ruler",
        "Regla Online",
        "オンライン定規",
        "Règle en ligne",
        "Online Lineal",
        "Régua Online",
        "온라인 자",
        "Righello Online",
        "Penggaris Online"
      ],
      "url": canonicalUrl,
      "description": description,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All (Web Browser, Android, iOS, Windows, macOS)",
      "inLanguage": Object.keys(ogLocales),
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />

    <!-- JSON-LD Structured Data: FAQPage Schema -->
    {t.seo.faqs && t.seo.faqs.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": t.seo.faqs.map(faq => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.a
          }
        }))
      })} />
    )}
  </head>
  <body class="bg-[var(--color-canvas)] text-[var(--color-ink)] min-h-screen flex flex-col selection:bg-red-500/20 selection:text-red-700">
    <slot />
  </body>
</html>
